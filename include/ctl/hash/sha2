template <class _Traits>
class sha2_32
    : public ctl::hash::fixed_hash<sha2_32<_Traits>, 64,
                                   _Traits::digest_size> {
  typedef ctl::hash::fixed_hash<sha2_32<_Traits>, 64, _Traits::digest_size>
      base_type;

public:
  using base_type::block_size;
  using base_type::digest_size;
  using typename base_type::digest_t;
  using typename base_type::digest_view;
  using typename base_type::writable_digest_view;

  sha2_32() : bit_count_(0), buffered_(0), active_(false) { reset(); }

  sha2_32(const sha2_32 &) = delete;
  sha2_32 &operator=(const sha2_32 &) = delete;

  sha2_32(sha2_32 &&other) noexcept : active_(false) { take(other); }

  sha2_32 &operator=(sha2_32 &&other) noexcept {
    if (this != &other) {
      erase();
      take(other);
    }
    return *this;
  }

  ~sha2_32() { erase(); }

  void reset() {
    erase();
    memcpy(state_, _Traits::initial, sizeof(state_));
    memset(buffer_, 0, sizeof(buffer_));
    bit_count_ = 0;
    buffered_ = 0;
    active_ = true;
  }

  void update(ctl::bytes input) {
    require_active("update");
    add_length(input.size());

    const uint8_t *data = input.data();
    size_t size = input.size();
    if (buffered_ != 0) {
      const size_t needed = block_size - buffered_;
      const size_t taken = size < needed ? size : needed;
      if (taken != 0) {
        memcpy(buffer_ + buffered_, data, taken);
        data += taken;
      }
      buffered_ += taken;
      size -= taken;
      if (buffered_ == block_size) {
        compress(buffer_);
        buffered_ = 0;
      }
    }

    while (size >= block_size) {
      compress(data);
      data += block_size;
      size -= block_size;
    }

    if (size != 0) {
      memcpy(buffer_, data, size);
      buffered_ = size;
    }
  }

  void finish(writable_digest_view output) {
    require_active("finish");
    const uint64_t message_bits = bit_count_;

    buffer_[buffered_++] = 0x80;
    if (buffered_ > block_size - sizeof(uint64_t)) {
      memset(buffer_ + buffered_, 0, block_size - buffered_);
      compress(buffer_);
      buffered_ = 0;
    }
    memset(buffer_ + buffered_, 0,
           block_size - sizeof(uint64_t) - buffered_);
    ctl::detail::store_be64(message_bits,
                            buffer_ + block_size - sizeof(uint64_t));
    compress(buffer_);

    for (size_t i = 0; i < digest_size; ++i)
      output[i] = static_cast<uint8_t>(
          state_[i / 4] >> (24u - 8u * static_cast<unsigned int>(i % 4)));
    erase();
  }

private:
  void require_active(const char *operation) const {
    if (!active_)
      throw std::logic_error(std::string(_Traits::name) + "::" + operation +
                             " : this hash context has been finished or "
                             "moved away. Reset it before use.");
  }

  void add_length(size_t bytes) {
    const uint64_t room =
        (std::numeric_limits<uint64_t>::max() - bit_count_) / 8;
    if (static_cast<uint64_t>(bytes) > room)
      throw std::length_error(std::string(_Traits::name) +
                              "::update : the message is too long for the "
                              "64 bit length field of SHA-224/SHA-256.");
    bit_count_ += static_cast<uint64_t>(bytes) * 8;
  }

  static constexpr uint32_t choose(uint32_t x, uint32_t y, uint32_t z) {
    return (x & y) ^ (~x & z);
  }

  static constexpr uint32_t majority(uint32_t x, uint32_t y, uint32_t z) {
    return (x & y) ^ (x & z) ^ (y & z);
  }

  static constexpr uint32_t big_sigma0(uint32_t x) {
    return ctl::detail::rotr32(x, 2) ^ ctl::detail::rotr32(x, 13) ^
           ctl::detail::rotr32(x, 22);
  }

  static constexpr uint32_t big_sigma1(uint32_t x) {
    return ctl::detail::rotr32(x, 6) ^ ctl::detail::rotr32(x, 11) ^
           ctl::detail::rotr32(x, 25);
  }

  static constexpr uint32_t small_sigma0(uint32_t x) {
    return ctl::detail::rotr32(x, 7) ^ ctl::detail::rotr32(x, 18) ^ (x >> 3);
  }

  static constexpr uint32_t small_sigma1(uint32_t x) {
    return ctl::detail::rotr32(x, 17) ^ ctl::detail::rotr32(x, 19) ^ (x >> 10);
  }

  void compress(const uint8_t *block) {
    static constexpr uint32_t k[64] = {
        0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u,
        0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
        0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u,
        0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
        0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu,
        0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
        0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u,
        0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
        0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u,
        0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
        0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u,
        0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
        0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u,
        0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
        0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u,
        0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u};

    uint32_t w[64];
    for (size_t i = 0; i < 16; ++i)
      w[i] = ctl::detail::load_be32(block + i * 4);
    for (size_t i = 16; i < 64; ++i)
      w[i] = small_sigma1(w[i - 2]) + w[i - 7] +
             small_sigma0(w[i - 15]) + w[i - 16];

    uint32_t a = state_[0], b = state_[1], c = state_[2], d = state_[3];
    uint32_t e = state_[4], f = state_[5], g = state_[6], h = state_[7];
    for (size_t i = 0; i < 64; ++i) {
      const uint32_t first = h + big_sigma1(e) + choose(e, f, g) + k[i] + w[i];
      const uint32_t second = big_sigma0(a) + majority(a, b, c);
      h = g;
      g = f;
      f = e;
      e = d + first;
      d = c;
      c = b;
      b = a;
      a = first + second;
    }
    state_[0] += a;
    state_[1] += b;
    state_[2] += c;
    state_[3] += d;
    state_[4] += e;
    state_[5] += f;
    state_[6] += g;
    state_[7] += h;
    ctl::detail::secure_zero(w, sizeof(w));
  }

  void erase() {
    ctl::detail::secure_zero(state_, sizeof(state_));
    ctl::detail::secure_zero(buffer_, sizeof(buffer_));
    bit_count_ = 0;
    buffered_ = 0;
    active_ = false;
  }

  void take(sha2_32 &other) noexcept {
    memcpy(state_, other.state_, sizeof(state_));
    memcpy(buffer_, other.buffer_, sizeof(buffer_));
    bit_count_ = other.bit_count_;
    buffered_ = other.buffered_;
    active_ = other.active_;
    other.erase();
  }

  uint32_t state_[8];
  uint8_t buffer_[block_size];
  uint64_t bit_count_;
  size_t buffered_;
  bool active_;
};

template <class _Traits>
class sha2_64
    : public ctl::hash::fixed_hash<sha2_64<_Traits>, 128,
                                   _Traits::digest_size> {
  typedef ctl::hash::fixed_hash<sha2_64<_Traits>, 128, _Traits::digest_size>
      base_type;

public:
  using base_type::block_size;
  using base_type::digest_size;
  using typename base_type::digest_t;
  using typename base_type::digest_view;
  using typename base_type::writable_digest_view;

  sha2_64() : bit_count_high_(0), bit_count_low_(0), buffered_(0),
              active_(false) {
    reset();
  }

  sha2_64(const sha2_64 &) = delete;
  sha2_64 &operator=(const sha2_64 &) = delete;

  sha2_64(sha2_64 &&other) noexcept : active_(false) { take(other); }

  sha2_64 &operator=(sha2_64 &&other) noexcept {
    if (this != &other) {
      erase();
      take(other);
    }
    return *this;
  }

  ~sha2_64() { erase(); }

  void reset() {
    erase();
    memcpy(state_, _Traits::initial, sizeof(state_));
    memset(buffer_, 0, sizeof(buffer_));
    bit_count_high_ = 0;
    bit_count_low_ = 0;
    buffered_ = 0;
    active_ = true;
  }

  void update(ctl::bytes input) {
    require_active("update");
    add_length(input.size());

    const uint8_t *data = input.data();
    size_t size = input.size();
    if (buffered_ != 0) {
      const size_t needed = block_size - buffered_;
      const size_t taken = size < needed ? size : needed;
      if (taken != 0) {
        memcpy(buffer_ + buffered_, data, taken);
        data += taken;
      }
      buffered_ += taken;
      size -= taken;
      if (buffered_ == block_size) {
        compress(buffer_);
        buffered_ = 0;
      }
    }

    while (size >= block_size) {
      compress(data);
      data += block_size;
      size -= block_size;
    }

    if (size != 0) {
      memcpy(buffer_, data, size);
      buffered_ = size;
    }
  }

  void finish(writable_digest_view output) {
    require_active("finish");
    const uint64_t message_high = bit_count_high_;
    const uint64_t message_low = bit_count_low_;

    buffer_[buffered_++] = 0x80;
    if (buffered_ > block_size - 2 * sizeof(uint64_t)) {
      memset(buffer_ + buffered_, 0, block_size - buffered_);
      compress(buffer_);
      buffered_ = 0;
    }
    memset(buffer_ + buffered_, 0,
           block_size - 2 * sizeof(uint64_t) - buffered_);
    ctl::detail::store_be64(message_high,
                            buffer_ + block_size - 2 * sizeof(uint64_t));
    ctl::detail::store_be64(message_low,
                            buffer_ + block_size - sizeof(uint64_t));
    compress(buffer_);

    for (size_t i = 0; i < digest_size; ++i)
      output[i] = static_cast<uint8_t>(
          state_[i / 8] >> (56u - 8u * static_cast<unsigned int>(i % 8)));
    erase();
  }

private:
  void require_active(const char *operation) const {
    if (!active_)
      throw std::logic_error(std::string(_Traits::name) + "::" + operation +
                             " : this hash context has been finished or "
                             "moved away. Reset it before use.");
  }

  void add_length(size_t bytes) {
    const uint64_t value = static_cast<uint64_t>(bytes);
    const uint64_t added_low = value << 3;
    const uint64_t added_high = value >> 61;
    const uint64_t new_low = bit_count_low_ + added_low;
    const uint64_t carry = new_low < bit_count_low_ ? 1 : 0;
    if (bit_count_high_ > std::numeric_limits<uint64_t>::max() -
                              added_high - carry)
      throw std::length_error(std::string(_Traits::name) +
                              "::update : the message is too long for the "
                              "128 bit length field of SHA-384/SHA-512.");
    bit_count_low_ = new_low;
    bit_count_high_ += added_high + carry;
  }

  static constexpr uint64_t rotr(uint64_t value, unsigned int amount) {
    return (value >> amount) | (value << (64 - amount));
  }

  static constexpr uint64_t choose(uint64_t x, uint64_t y, uint64_t z) {
    return (x & y) ^ (~x & z);
  }

  static constexpr uint64_t majority(uint64_t x, uint64_t y, uint64_t z) {
    return (x & y) ^ (x & z) ^ (y & z);
  }

  static constexpr uint64_t big_sigma0(uint64_t x) {
    return rotr(x, 28) ^ rotr(x, 34) ^ rotr(x, 39);
  }

  static constexpr uint64_t big_sigma1(uint64_t x) {
    return rotr(x, 14) ^ rotr(x, 18) ^ rotr(x, 41);
  }

  static constexpr uint64_t small_sigma0(uint64_t x) {
    return rotr(x, 1) ^ rotr(x, 8) ^ (x >> 7);
  }

  static constexpr uint64_t small_sigma1(uint64_t x) {
    return rotr(x, 19) ^ rotr(x, 61) ^ (x >> 6);
  }

  void compress(const uint8_t *block) {
    static constexpr uint64_t k[80] = {
        0x428a2f98d728ae22ull, 0x7137449123ef65cdull,
        0xb5c0fbcfec4d3b2full, 0xe9b5dba58189dbbcull,
        0x3956c25bf348b538ull, 0x59f111f1b605d019ull,
        0x923f82a4af194f9bull, 0xab1c5ed5da6d8118ull,
        0xd807aa98a3030242ull, 0x12835b0145706fbeull,
        0x243185be4ee4b28cull, 0x550c7dc3d5ffb4e2ull,
        0x72be5d74f27b896full, 0x80deb1fe3b1696b1ull,
        0x9bdc06a725c71235ull, 0xc19bf174cf692694ull,
        0xe49b69c19ef14ad2ull, 0xefbe4786384f25e3ull,
        0x0fc19dc68b8cd5b5ull, 0x240ca1cc77ac9c65ull,
        0x2de92c6f592b0275ull, 0x4a7484aa6ea6e483ull,
        0x5cb0a9dcbd41fbd4ull, 0x76f988da831153b5ull,
        0x983e5152ee66dfabull, 0xa831c66d2db43210ull,
        0xb00327c898fb213full, 0xbf597fc7beef0ee4ull,
        0xc6e00bf33da88fc2ull, 0xd5a79147930aa725ull,
        0x06ca6351e003826full, 0x142929670a0e6e70ull,
        0x27b70a8546d22ffcull, 0x2e1b21385c26c926ull,
        0x4d2c6dfc5ac42aedull, 0x53380d139d95b3dfull,
        0x650a73548baf63deull, 0x766a0abb3c77b2a8ull,
        0x81c2c92e47edaee6ull, 0x92722c851482353bull,
        0xa2bfe8a14cf10364ull, 0xa81a664bbc423001ull,
        0xc24b8b70d0f89791ull, 0xc76c51a30654be30ull,
        0xd192e819d6ef5218ull, 0xd69906245565a910ull,
        0xf40e35855771202aull, 0x106aa07032bbd1b8ull,
        0x19a4c116b8d2d0c8ull, 0x1e376c085141ab53ull,
        0x2748774cdf8eeb99ull, 0x34b0bcb5e19b48a8ull,
        0x391c0cb3c5c95a63ull, 0x4ed8aa4ae3418acbull,
        0x5b9cca4f7763e373ull, 0x682e6ff3d6b2b8a3ull,
        0x748f82ee5defb2fcull, 0x78a5636f43172f60ull,
        0x84c87814a1f0ab72ull, 0x8cc702081a6439ecull,
        0x90befffa23631e28ull, 0xa4506cebde82bde9ull,
        0xbef9a3f7b2c67915ull, 0xc67178f2e372532bull,
        0xca273eceea26619cull, 0xd186b8c721c0c207ull,
        0xeada7dd6cde0eb1eull, 0xf57d4f7fee6ed178ull,
        0x06f067aa72176fbaull, 0x0a637dc5a2c898a6ull,
        0x113f9804bef90daeull, 0x1b710b35131c471bull,
        0x28db77f523047d84ull, 0x32caab7b40c72493ull,
        0x3c9ebe0a15c9bebcull, 0x431d67c49c100d4cull,
        0x4cc5d4becb3e42b6ull, 0x597f299cfc657e2aull,
        0x5fcb6fab3ad6faecull, 0x6c44198c4a475817ull};

    uint64_t w[80];
    for (size_t i = 0; i < 16; ++i)
      w[i] = ctl::detail::load_be64(block + i * 8);
    for (size_t i = 16; i < 80; ++i)
      w[i] = small_sigma1(w[i - 2]) + w[i - 7] +
             small_sigma0(w[i - 15]) + w[i - 16];

    uint64_t a = state_[0], b = state_[1], c = state_[2], d = state_[3];
    uint64_t e = state_[4], f = state_[5], g = state_[6], h = state_[7];
    for (size_t i = 0; i < 80; ++i) {
      const uint64_t first = h + big_sigma1(e) + choose(e, f, g) + k[i] + w[i];
      const uint64_t second = big_sigma0(a) + majority(a, b, c);
      h = g;
      g = f;
      f = e;
      e = d + first;
      d = c;
      c = b;
      b = a;
      a = first + second;
    }
    state_[0] += a;
    state_[1] += b;
    state_[2] += c;
    state_[3] += d;
    state_[4] += e;
    state_[5] += f;
    state_[6] += g;
    state_[7] += h;
    ctl::detail::secure_zero(w, sizeof(w));
  }

  void erase() {
    ctl::detail::secure_zero(state_, sizeof(state_));
    ctl::detail::secure_zero(buffer_, sizeof(buffer_));
    bit_count_high_ = 0;
    bit_count_low_ = 0;
    buffered_ = 0;
    active_ = false;
  }

  void take(sha2_64 &other) noexcept {
    memcpy(state_, other.state_, sizeof(state_));
    memcpy(buffer_, other.buffer_, sizeof(buffer_));
    bit_count_high_ = other.bit_count_high_;
    bit_count_low_ = other.bit_count_low_;
    buffered_ = other.buffered_;
    active_ = other.active_;
    other.erase();
  }

  uint64_t state_[8];
  uint8_t buffer_[block_size];
  uint64_t bit_count_high_;
  uint64_t bit_count_low_;
  size_t buffered_;
  bool active_;
};

