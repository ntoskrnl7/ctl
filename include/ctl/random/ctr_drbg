/**
 * @file random/ctr_drbg
 * @author jung-kwang lee (ntoskrnl7@gmail.com)
 * @brief CTR_DRBG with Block_Cipher_df (NIST SP 800-90A section 10.2)
 *
 * This is the derivation-function form. Entropy, nonce and personalization
 * remain separate inputs and Block_Cipher_df conditions them into the key and
 * counter. The distinction from ctr_drbg_no_df is in the type because their
 * entropy contracts are not interchangeable.
 */
#pragma once

#include <cstddef>
#include <cstdint>
#include <cstring>
#include <stdexcept>
#include <type_traits>
#include <utility>

#include <ctl/bytes>
#include <ctl/detail/memory>
#include <ctl/random/detail/common>
#include <ctl/symmetric/cipher/aes>

namespace ctl {

template <class _Cipher> class ctr_drbg {
public:
  typedef _Cipher cipher_type;

  static constexpr size_t block_size = cipher_type::block_size;
  static constexpr size_t key_size = cipher_type::key_size;
  static constexpr size_t seed_size = key_size + block_size;
  static constexpr size_t security_strength = key_size * 8;
  static constexpr size_t entropy_size = key_size;
  static constexpr size_t nonce_size = key_size / 2;
  static constexpr size_t max_per_request =
      ctl::random_detail::max_per_request;
  static constexpr uint64_t reseed_interval =
      ctl::random_detail::reseed_interval;

  static_assert(block_size == 16,
                "CTR_DRBG requires a 128 bit block cipher.");
  static_assert(key_size == 16 || key_size == 24 || key_size == 32,
                "The SP 800-90A CTR_DRBG profile supports AES-128, AES-192 "
                "and AES-256 key sizes.");
  static_assert(
      std::is_same<cipher_type, ctl::symmetric::cipher::aes<128>>::value ||
          std::is_same<cipher_type,
                       ctl::symmetric::cipher::aes<192>>::value ||
          std::is_same<cipher_type,
                       ctl::symmetric::cipher::aes<256>>::value,
      "The current SP 800-90A CTR_DRBG profile accepts CTL AES only.");

  explicit ctr_drbg(ctl::bytes entropy, ctl::bytes nonce,
                    ctl::bytes personalization = ctl::bytes())
      : counter_(0), ready_(false) {
    instantiate(entropy, nonce, personalization);
  }

  ctr_drbg(const ctr_drbg &) = delete;
  ctr_drbg &operator=(const ctr_drbg &) = delete;

  ctr_drbg(ctr_drbg &&other) noexcept : counter_(0), ready_(false) {
    take(other);
  }

  ctr_drbg &operator=(ctr_drbg &&other) noexcept {
    if (this != &other) {
      erase();
      take(other);
    }
    return *this;
  }

  ~ctr_drbg() { erase(); }

  void instantiate(ctl::bytes entropy, ctl::bytes nonce,
                   ctl::bytes personalization = ctl::bytes()) {
    validate_seed_inputs(entropy, nonce, personalization,
                         "ctl::ctr_drbg::instantiate");

    ctl::detail::secret_buffer<seed_size> seed;
    block_cipher_df(input_parts(entropy, nonce, personalization), seed.data(),
                    "ctl::ctr_drbg::instantiate");

    memset(key_, 0, sizeof(key_));
    memset(v_, 0, sizeof(v_));
    update(seed.data());
    counter_ = 1;
    ready_ = true;
  }

  void reseed(ctl::bytes entropy,
              ctl::bytes additional = ctl::bytes()) {
    ctl::random_detail::require_ready(ready_, "ctl::ctr_drbg::reseed");
    ctl::random_detail::require_input(
        entropy, entropy_size, "ctl::ctr_drbg::reseed", "entropy");
    ctl::random_detail::require_optional_input(
        additional, "ctl::ctr_drbg::reseed", "additional input");

    ctl::detail::secret_buffer<seed_size> seed;
    block_cipher_df(input_parts(entropy, additional), seed.data(),
                    "ctl::ctr_drbg::reseed");
    update(seed.data());
    counter_ = 1;
  }

  void generate(ctl::writable_bytes output,
                ctl::bytes additional = ctl::bytes()) {
    ctl::random_detail::require_ready(ready_, "ctl::ctr_drbg::generate");
    ctl::random_detail::require_request(output.size(), counter_,
                                        "ctl::ctr_drbg::generate");
    ctl::random_detail::require_optional_input(
        additional, "ctl::ctr_drbg::generate", "additional input");
    ctl::detail::require_disjoint(
        "ctl::ctr_drbg::generate", "additional input", additional.data(),
        additional.size(), "output", output.data(), output.size());

    ctl::detail::secret_buffer<seed_size> provided;
    const bool mixed = !additional.empty();
    if (mixed) {
      block_cipher_df(input_parts(additional), provided.data(),
                      "ctl::ctr_drbg::generate");
      update(provided.data());
    }

    cipher_type cipher{typename cipher_type::key_view(key_)};
    size_t filled = 0;
    while (filled < output.size()) {
      ctl::random_detail::increment_be(v_, sizeof(v_));
      uint8_t block[block_size];
      cipher.encrypt_block(v_, block);
      const size_t take = output.size() - filled < block_size
                              ? output.size() - filled
                              : block_size;
      memcpy(output.data() + filled, block, take);
      filled += take;
      ctl::detail::secure_zero(block, sizeof(block));
    }

    update(mixed ? provided.data() : nullptr);
    ++counter_;
  }

  uint64_t requests_served() const {
    ctl::random_detail::require_ready(
        ready_, "ctl::ctr_drbg::requests_served");
    return counter_ - 1;
  }

private:
  struct input_parts {
    ctl::bytes first;
    ctl::bytes second;
    ctl::bytes third;

    explicit input_parts(ctl::bytes a, ctl::bytes b = ctl::bytes(),
                         ctl::bytes c = ctl::bytes())
        : first(a), second(b), third(c) {}

    uint64_t size() const noexcept {
      return static_cast<uint64_t>(first.size()) +
             static_cast<uint64_t>(second.size()) +
             static_cast<uint64_t>(third.size());
    }

    uint8_t at(uint64_t offset) const noexcept {
      if (offset < first.size())
        return first.data()[static_cast<size_t>(offset)];
      offset -= first.size();
      if (offset < second.size())
        return second.data()[static_cast<size_t>(offset)];
      offset -= second.size();
      return third.data()[static_cast<size_t>(offset)];
    }
  };

  static uint8_t encoded_byte(uint32_t value, size_t index) noexcept {
    return static_cast<uint8_t>(value >> (24u - 8u * index));
  }

  static void validate_seed_inputs(ctl::bytes entropy, ctl::bytes nonce,
                                   ctl::bytes personalization,
                                   const char *where) {
    ctl::random_detail::require_input(entropy, entropy_size, where, "entropy");
    ctl::random_detail::require_input(nonce, nonce_size, where, "nonce");
    ctl::random_detail::require_optional_input(personalization, where,
                                               "personalization string");
  }

  static void block_cipher_df(const input_parts &input, uint8_t *output,
                              const char *where) {
    const uint64_t input_size = input.size();
    if (input_size > ctl::random_detail::max_input_size)
      throw std::length_error(std::string(where) +
                              " : the combined derivation-function input is "
                              "too long.");

    const uint32_t length = static_cast<uint32_t>(input_size);
    const uint32_t requested = static_cast<uint32_t>(seed_size);
    const uint64_t unpadded_size = 8u + input_size + 1u;
    const uint64_t s_size =
        ((unpadded_size + block_size - 1u) / block_size) * block_size;

    uint8_t initial_key[key_size];
    for (size_t i = 0; i < key_size; ++i)
      initial_key[i] = static_cast<uint8_t>(i);
    cipher_type bcc_cipher{typename cipher_type::key_view(initial_key)};

    ctl::detail::secret_buffer<seed_size> temp;
    size_t filled = 0;
    uint32_t iteration = 0;
    while (filled < seed_size) {
      uint8_t chaining[block_size] = {0};
      uint8_t block[block_size] = {0};
      for (size_t i = 0; i < 4; ++i)
        block[i] = encoded_byte(iteration, i);
      bcc_cipher.encrypt_block(block, chaining);

      for (uint64_t offset = 0; offset < s_size; offset += block_size) {
        for (size_t i = 0; i < block_size; ++i) {
          const uint64_t position = offset + i;
          uint8_t value = 0;
          if (position < 4)
            value = encoded_byte(length, static_cast<size_t>(position));
          else if (position < 8)
            value = encoded_byte(requested,
                                 static_cast<size_t>(position - 4));
          else if (position < 8u + input_size)
            value = input.at(position - 8u);
          else if (position == 8u + input_size)
            value = 0x80u;
          block[i] = static_cast<uint8_t>(value ^ chaining[i]);
        }
        bcc_cipher.encrypt_block(block, chaining);
      }

      const size_t take = seed_size - filled < block_size
                              ? seed_size - filled
                              : block_size;
      memcpy(temp.data() + filled, chaining, take);
      filled += take;
      ++iteration;
      ctl::detail::secure_zero(chaining, sizeof(chaining));
      ctl::detail::secure_zero(block, sizeof(block));
    }
    ctl::detail::secure_zero(initial_key, sizeof(initial_key));

    cipher_type output_cipher{typename cipher_type::key_view(temp.data())};
    uint8_t x[block_size];
    memcpy(x, temp.data() + key_size, sizeof(x));
    filled = 0;
    while (filled < seed_size) {
      uint8_t block[block_size];
      output_cipher.encrypt_block(x, block);
      memcpy(x, block, sizeof(x));
      const size_t take = seed_size - filled < block_size
                              ? seed_size - filled
                              : block_size;
      memcpy(output + filled, block, take);
      filled += take;
      ctl::detail::secure_zero(block, sizeof(block));
    }
    ctl::detail::secure_zero(x, sizeof(x));
  }

  void update(const uint8_t *provided) {
    ctl::detail::secret_buffer<seed_size> temp;
    cipher_type cipher{typename cipher_type::key_view(key_)};
    size_t filled = 0;
    while (filled < seed_size) {
      ctl::random_detail::increment_be(v_, sizeof(v_));
      uint8_t block[block_size];
      cipher.encrypt_block(v_, block);
      const size_t take = seed_size - filled < block_size
                              ? seed_size - filled
                              : block_size;
      memcpy(temp.data() + filled, block, take);
      filled += take;
      ctl::detail::secure_zero(block, sizeof(block));
    }
    if (provided != nullptr)
      for (size_t i = 0; i < seed_size; ++i)
        temp[i] = static_cast<uint8_t>(temp[i] ^ provided[i]);
    memcpy(key_, temp.data(), key_size);
    memcpy(v_, temp.data() + key_size, block_size);
  }

  void take(ctr_drbg &other) noexcept {
    memcpy(key_, other.key_, sizeof(key_));
    memcpy(v_, other.v_, sizeof(v_));
    counter_ = other.counter_;
    ready_ = other.ready_;
    other.erase();
  }

  void erase() noexcept {
    ctl::detail::secure_zero(key_, sizeof(key_));
    ctl::detail::secure_zero(v_, sizeof(v_));
    counter_ = 0;
    ready_ = false;
  }

  uint8_t key_[key_size];
  uint8_t v_[block_size];
  uint64_t counter_;
  bool ready_;
};

} // namespace ctl
