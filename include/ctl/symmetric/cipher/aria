/**
 * Whether the vector path is compiled in
 *
 * It asks two things of a processor: the AES round instruction, which stands in
 * for two of the four S-boxes, and a full sixteen byte table lookup, which
 * covers the other two and the diffusion layer as well. x86 has them as AES-NI
 * and SSSE3, ARMv8 as the cryptographic extension and NEON. Both are still
 * decided at run time, since the AES part is optional on either. MSA has no AES
 * instruction, so its path bitslices eight blocks and evaluates all four
 * S-boxes with a tower-field boolean circuit.
 */
#if defined(__mips_msa) && !defined(CTL_NO_HW_ACCEL)
#define CTL_ARIA_VECTOR_MSA 1
#endif

