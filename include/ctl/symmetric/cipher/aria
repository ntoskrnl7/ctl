// Transcription error detection: an S-box has to be a permutation, so a single
// wrong byte makes compilation fail here.
static_assert(ctl::detail::is_permutation(sb2_table),
              "ARIA SB2 transcription error");

/**
 * @brief SB2 together with its inverse SB4
 */
inline constexpr ctl::detail::sbox_pair sb2 =
    ctl::detail::make_sbox_pair(sb2_table);

// The example in section 2.4.2 of RFC 5794: SB4(0xef) == 0xd3
static_assert(sb2.inverse[0xef] == 0xd3, "ARIA SB4 derivation error");

// The two extreme entries of the SB2 table of RFC 5794
static_assert(sb2.forward[0x00] == 0xe2, "ARIA SB2 transcription error");
static_assert(sb2.forward[0xff] == 0x81, "ARIA SB2 transcription error");

// Values from the first row of the SB4 table of RFC 5794. The document has a
// typographic slip there, printing column d as " 9" rather than "09"; since
// SB4 is derived from SB2, this confirms that the value is 0x09.
static_assert(sb2.inverse[0x00] == 0x30, "ARIA SB4 derivation error");
static_assert(sb2.inverse[0x0d] == 0x09, "ARIA SB4 derivation error");

/**
 * @brief An affine map over GF(2)^8, a linear map followed by adding a constant
 */
struct affine_map {
  /**
   * @brief Where the map sends the vector with only bit i set, with the
   * constant already taken out
   */
  uint8_t column[8];

  /**
   * @brief Where the map sends zero
   */
  uint8_t constant;
};

/**
 * @brief Applies an affine map
 */
constexpr uint8_t apply_affine(const affine_map &map, uint8_t value) {
  uint8_t result = map.constant;
  for (unsigned int i = 0; i < 8; ++i)
    if ((value >> i) & 1)
      result = static_cast<uint8_t>(result ^ map.column[i]);
  return result;
}

/**
 * @brief SB2 composed with the inverse of SB1
 */
constexpr uint8_t sb2_after_sb1_inverse(uint8_t value) {
  return sb2_table[ctl::detail::aes_sbox.inverse[value]];
}

/**
 * @brief Recovers the affine map that turns SB1 into SB2
 *
 * A linear map is determined by where it sends each basis vector, so eight
 * evaluations plus the image of zero are enough to recover the whole thing.
 */
constexpr affine_map derive_sb2_from_sb1() {
  affine_map map = {};
  map.constant = sb2_after_sb1_inverse(0);
  for (unsigned int i = 0; i < 8; ++i)
    map.column[i] = static_cast<uint8_t>(
        sb2_after_sb1_inverse(static_cast<uint8_t>(1u << i)) ^ map.constant);
  return map;
}

/**
 * @brief The affine map with SB2(x) == apply_affine(map, SB1(x))
 *
 * This is groundwork rather than something the current implementation uses. A
 * vectorized substitution layer would apply SB1 to all sixteen bytes at once
 * with the AES instruction, since ARIA's SB1 is the AES S-box, and would then
 * need SB2 as a transformation of that result rather than as its own table.
 *
 * RFC 5794 gives all four S-boxes as tables only and never says they share a
 * structure, so the relation is recovered from the tables here and checked
 * against every one of the 256 entries below. If ARIA had not been built this
 * way the check would fail, which is the point of writing it down as a check
 * rather than as a comment.
 */
inline constexpr affine_map sb2_from_sb1 = derive_sb2_from_sb1();

/**
 * @brief Confirms the map reproduces SB2 for every input
 */
constexpr bool reproduces_sb2(const affine_map &map) {
  for (unsigned int i = 0; i < 256; ++i)
    if (apply_affine(map, ctl::detail::aes_sbox.forward[i]) != sb2_table[i])
      return false;
  return true;
}

static_assert(reproduces_sb2(sb2_from_sb1),
              "ARIA SB2 is not an affine image of SB1, so a vectorized "
              "substitution layer cannot derive one from the other");

/**
 * @brief SB1 composed with the inverse of SB2, which is the inverse of the map
 * above
 */
constexpr uint8_t sb1_after_sb2_inverse(uint8_t value) {
  return ctl::detail::aes_sbox.forward[sb2.inverse[value]];
}

/**
 * @brief Recovers the affine map that undoes the one from SB1 to SB2
 */
constexpr affine_map derive_sb1_from_sb2() {
  affine_map map = {};
  map.constant = sb1_after_sb2_inverse(0);
  for (unsigned int i = 0; i < 8; ++i)
    map.column[i] = static_cast<uint8_t>(
        sb1_after_sb2_inverse(static_cast<uint8_t>(1u << i)) ^ map.constant);
  return map;
}

/**
 * @brief The map that satisfies SB4(x) == SB3(apply_affine(map, x))
 *
 * SB4 is the inverse of SB2, and SB2 is this affine map composed onto SB1, so
 * undoing the map and then applying the inverse of SB1 gives SB4. That is what
 * lets a vectorized substitution derive all four S-boxes from the two the AES
 * instructions provide.
 */
inline constexpr affine_map sb1_from_sb2 = derive_sb1_from_sb2();

/**
 * @brief Confirms the two maps undo each other on every input
 */
constexpr bool maps_are_inverse() {
  for (unsigned int i = 0; i < 256; ++i) {
    const uint8_t value = static_cast<uint8_t>(i);
    if (apply_affine(sb1_from_sb2, apply_affine(sb2_from_sb1, value)) != value)
      return false;
    if (sb2.inverse[i] !=
        ctl::detail::aes_sbox.inverse[apply_affine(sb1_from_sb2, value)])
      return false;
  }
  return true;
}

static_assert(maps_are_inverse(),
              "the affine maps between ARIA SB1 and SB2 are not inverses, so "
              "SB4 cannot be derived from SB3");

/**
 * @brief The sixteen entry tables that apply the linear part of an affine map
 *
 * A linear map splits across the two nibbles of a byte, so a byte shuffle over
 * a sixteen entry table handles each half and the results are added. This is
 * how the map is applied to all sixteen bytes at once.
 */
struct nibble_tables {
  uint8_t low[16];
  uint8_t high[16];
  uint8_t constant;
};

/**
 * @brief A sixteen byte constant, laid out for a byte shuffle
 */
struct byte_vector {
  uint8_t byte[16];
};

/**
 * @brief Splits an affine map into the tables above
 */
constexpr nibble_tables to_nibble_tables(const affine_map &map) {
  nibble_tables tables = {};
  for (unsigned int n = 0; n < 16; ++n) {
    tables.low[n] =
        static_cast<uint8_t>(apply_affine(map, static_cast<uint8_t>(n)) ^
                             map.constant);
    tables.high[n] =
        static_cast<uint8_t>(apply_affine(map, static_cast<uint8_t>(n << 4)) ^
                             map.constant);
  }
  tables.constant = map.constant;
  return tables;
}

#if defined(CTL_ARIA_VECTOR_MSA)

constexpr uint8_t rotate_byte_left(uint8_t value, unsigned int bits) {
  return static_cast<uint8_t>((value << bits) | (value >> (8 - bits)));
}

/**
 * @brief The affine part of the AES S-box
 */
constexpr uint8_t aes_affine(uint8_t value) {
  return static_cast<uint8_t>(value ^ rotate_byte_left(value, 1) ^
                              rotate_byte_left(value, 2) ^
                              rotate_byte_left(value, 3) ^
                              rotate_byte_left(value, 4) ^ 0x63);
}

/**
 * @brief Inverse of the AES affine map
 */
constexpr uint8_t aes_affine_inverse(uint8_t value) {
  for (unsigned int candidate = 0; candidate < 256; ++candidate)
    if (aes_affine(static_cast<uint8_t>(candidate)) == value)
      return static_cast<uint8_t>(candidate);
  return 0;
}

/**
 * @brief Recovers an affine map from a function known to be affine
 */
constexpr affine_map derive_affine_map(uint8_t (*function)(uint8_t)) {
  affine_map map = {};
  map.constant = function(0);
  for (unsigned int i = 0; i < 8; ++i)
    map.column[i] =
        static_cast<uint8_t>(function(static_cast<uint8_t>(1u << i)) ^
                             map.constant);
  return map;
}

constexpr bool affine_map_matches(const affine_map &map,
                                  uint8_t (*function)(uint8_t)) {
  for (unsigned int i = 0; i < 256; ++i)
    if (apply_affine(map, static_cast<uint8_t>(i)) !=
        function(static_cast<uint8_t>(i)))
      return false;
  return true;
}

constexpr uint8_t bit(uint8_t value, unsigned int at) {
  return static_cast<uint8_t>((value >> at) & 1);
}

/**
 * @brief The AES polynomial basis to the tower basis used by aes_bitslice
 */
constexpr uint8_t aes_to_tower(uint8_t value) {
  const uint8_t x0 = bit(value, 0), x1 = bit(value, 1);
  const uint8_t x2 = bit(value, 2), x3 = bit(value, 3);
  const uint8_t x4 = bit(value, 4), x5 = bit(value, 5);
  const uint8_t x6 = bit(value, 6), x7 = bit(value, 7);
  return static_cast<uint8_t>(
      ((x0 ^ x1 ^ x2 ^ x3 ^ x7) << 0) | ((x1 ^ x3) << 1) |
      ((x3 ^ x4 ^ x6) << 2) | ((x1 ^ x2 ^ x6 ^ x7) << 3) |
      ((x2 ^ x3 ^ x4 ^ x6 ^ x7) << 4) |
      ((x1 ^ x4 ^ x6 ^ x7) << 5) |
      ((x1 ^ x2 ^ x3 ^ x4 ^ x5 ^ x6) << 6) | ((x5 ^ x7) << 7));
}

/**
 * @brief The tower basis back to the AES polynomial basis
 */
constexpr uint8_t tower_to_aes(uint8_t value) {
  const uint8_t x0 = bit(value, 0), x1 = bit(value, 1);
  const uint8_t x2 = bit(value, 2), x3 = bit(value, 3);
  const uint8_t x4 = bit(value, 4), x5 = bit(value, 5);
  const uint8_t x6 = bit(value, 6), x7 = bit(value, 7);
  return static_cast<uint8_t>(
      ((x0 ^ x1 ^ x2 ^ x4) << 0) | ((x4 ^ x6 ^ x7) << 1) |
      ((x1 ^ x4 ^ x5) << 2) | ((x1 ^ x4 ^ x6 ^ x7) << 3) |
      ((x1 ^ x3 ^ x4) << 4) | ((x1 ^ x2 ^ x5 ^ x7) << 5) |
      ((x2 ^ x3 ^ x6 ^ x7) << 6) | ((x1 ^ x2 ^ x5) << 7));
}

/**
 * @brief The tower basis back to AES with its S-box affine map folded in
 */
constexpr uint8_t tower_to_aes_affine(uint8_t value) {
  const uint8_t x0 = bit(value, 0), x1 = bit(value, 1);
  const uint8_t x2 = bit(value, 2), x3 = bit(value, 3);
  const uint8_t x4 = bit(value, 4), x5 = bit(value, 5);
  const uint8_t x6 = bit(value, 6), x7 = bit(value, 7);
  return static_cast<uint8_t>(
      ((1 ^ x0 ^ x6) << 0) | ((1 ^ x0 ^ x1 ^ x3 ^ x7) << 1) |
      ((x0 ^ x1 ^ x2 ^ x3 ^ x4) << 2) | (x0 << 3) |
      ((x0 ^ x2 ^ x3 ^ x4 ^ x5) << 4) |
      ((1 ^ x2 ^ x3 ^ x7) << 5) | ((1 ^ x4 ^ x7) << 6) |
      ((x2 ^ x7) << 7));
}

constexpr uint8_t sb12_tower_pre(uint8_t value) {
  return aes_to_tower(value);
}
constexpr uint8_t sb3_tower_pre(uint8_t value) {
  return aes_to_tower(aes_affine_inverse(value));
}
constexpr uint8_t sb4_tower_pre(uint8_t value) {
  return aes_to_tower(
      aes_affine_inverse(apply_affine(sb1_from_sb2, value)));
}
constexpr uint8_t sb1_tower_post(uint8_t value) {
  return tower_to_aes_affine(value);
}
constexpr uint8_t sb2_tower_post(uint8_t value) {
  return apply_affine(sb2_from_sb1, tower_to_aes_affine(value));
}
constexpr uint8_t sb34_tower_post(uint8_t value) {
  return tower_to_aes(value);
}

inline constexpr affine_map sb12_tower_pre_map =
    derive_affine_map(sb12_tower_pre);
inline constexpr affine_map sb3_tower_pre_map =
    derive_affine_map(sb3_tower_pre);
inline constexpr affine_map sb4_tower_pre_map =
    derive_affine_map(sb4_tower_pre);
inline constexpr affine_map sb1_tower_post_map =
    derive_affine_map(sb1_tower_post);
inline constexpr affine_map sb2_tower_post_map =
    derive_affine_map(sb2_tower_post);
inline constexpr affine_map sb34_tower_post_map =
    derive_affine_map(sb34_tower_post);

static_assert(affine_map_matches(sb12_tower_pre_map, sb12_tower_pre),
              "the AES to tower map is not affine");
static_assert(affine_map_matches(sb3_tower_pre_map, sb3_tower_pre),
              "the inverse AES input to tower map is not affine");
static_assert(affine_map_matches(sb4_tower_pre_map, sb4_tower_pre),
              "the inverse SB2 input to tower map is not affine");
static_assert(affine_map_matches(sb1_tower_post_map, sb1_tower_post),
              "the tower to AES S-box output map is not affine");
static_assert(affine_map_matches(sb2_tower_post_map, sb2_tower_post),
              "the tower to SB2 output map is not affine");
static_assert(affine_map_matches(sb34_tower_post_map, sb34_tower_post),
              "the tower to inverse S-box output map is not affine");

#endif

inline constexpr nibble_tables sb2_tables = to_nibble_tables(sb2_from_sb1);
inline constexpr nibble_tables sb4_tables = to_nibble_tables(sb1_from_sb2);

/**
 * @brief Confirms the split tables reproduce the map they came from
 */
constexpr bool tables_reproduce(const nibble_tables &tables,
                                const affine_map &map) {
  for (unsigned int i = 0; i < 256; ++i) {
    const uint8_t combined = static_cast<uint8_t>(
        tables.low[i & 0x0f] ^ tables.high[i >> 4] ^ tables.constant);
    if (combined != apply_affine(map, static_cast<uint8_t>(i)))
      return false;
  }
  return true;
}

static_assert(tables_reproduce(sb2_tables, sb2_from_sb1),
              "the nibble split of the SB1 to SB2 map is wrong");
static_assert(tables_reproduce(sb4_tables, sb1_from_sb2),
              "the nibble split of the SB2 to SB1 map is wrong");

/**
 * @brief Byte shuffles that undo and redo the row shift of AES
 *
 * The AES instructions apply a row shift alongside the substitution. Undoing it
 * beforehand leaves the substitution on its own, which is what ARIA needs.
 * Row r of the AES state is byte 4c+r, and the shift moves it by r columns.
 */
constexpr uint8_t undo_row_shift(unsigned int j) {
  const unsigned int row = j % 4;
  const unsigned int column = j / 4;
  return static_cast<uint8_t>(4 * ((column + 4 - row) % 4) + row);
}

constexpr uint8_t redo_row_shift(unsigned int j) {
  const unsigned int row = j % 4;
  const unsigned int column = j / 4;
  return static_cast<uint8_t>(4 * ((column + row) % 4) + row);
}

/**
 * @brief The diffusion layer written as seven byte shuffles
 *
 * Every output of A is the sum of seven inputs and every input feeds seven
 * outputs, so the matrix is seven regular and splits into seven permutations.
 * Adding the seven shuffled copies of the input reproduces A exactly, in seven
 * shuffles and six additions rather than sixty byte operations.
 *
 * The split was computed once and written down here; the test that compares the
 * vector path against the scalar one covers whether it is right.
 */
inline constexpr uint8_t diffusion_shuffles[7][16] = {
    {8, 7, 4, 11, 14, 10, 9, 13, 15, 6, 3, 2, 12, 0, 5, 1},
    {14, 12, 10, 7, 15, 1, 0, 11, 4, 5, 13, 9, 6, 8, 3, 2},
    {3, 5, 11, 10, 0, 15, 7, 1, 13, 14, 8, 12, 2, 6, 9, 4},
    {13, 9, 1, 0, 8, 14, 2, 6, 7, 12, 15, 3, 11, 10, 4, 5},
    {6, 2, 15, 13, 11, 9, 10, 12, 1, 0, 5, 4, 7, 3, 14, 8},
    {4, 15, 12, 5, 2, 3, 13, 8, 0, 1, 6, 14, 9, 7, 11, 10},
    {9, 8, 6, 14, 5, 4, 12, 3, 10, 11, 2, 7, 1, 13, 0, 15}};

/**
 * @brief Confirms each shuffle really is a permutation and that together they
 * use every edge of A exactly once
 */
constexpr bool shuffles_are_a_decomposition() {
  unsigned int seen[16][16] = {};
  for (unsigned int k = 0; k < 7; ++k) {
    bool used[16] = {};
    for (unsigned int i = 0; i < 16; ++i) {
      const unsigned int source = diffusion_shuffles[k][i];
      if (used[source])
        return false;
      used[source] = true;
      ++seen[i][source];
    }
  }
  for (unsigned int i = 0; i < 16; ++i) {
    unsigned int count = 0;
    for (unsigned int j = 0; j < 16; ++j) {
      if (seen[i][j] > 1)
        return false;
      count += seen[i][j];
    }
    if (count != 7)
      return false;
  }
  return true;
}

static_assert(shuffles_are_a_decomposition(),
              "the diffusion shuffles are not seven distinct permutations");

constexpr byte_vector make_undo_row_shift() {
  byte_vector v = {};
  for (unsigned int j = 0; j < 16; ++j)
    v.byte[j] = undo_row_shift(j);
  return v;
}

constexpr byte_vector make_redo_row_shift() {
  byte_vector v = {};
  for (unsigned int j = 0; j < 16; ++j)
    v.byte[j] = redo_row_shift(j);
  return v;
}

/**
 * @brief Selects the byte positions where the index leaves the given remainder
 *
 * Both substitution layers apply their four S-boxes in a repeating pattern of
 * four, so the four results are combined by selecting from each in turn.
 */
constexpr byte_vector make_selector(unsigned int remainder) {
  byte_vector v = {};
  for (unsigned int i = 0; i < 16; ++i)
    v.byte[i] = (i % 4 == remainder) ? 0xff : 0x00;
  return v;
}

inline constexpr byte_vector undo_shift_vector = make_undo_row_shift();
inline constexpr byte_vector redo_shift_vector = make_redo_row_shift();
inline constexpr byte_vector selector[4] = {
    make_selector(0), make_selector(1), make_selector(2), make_selector(3)};

/**
 * @brief The key schedule constants C1, C2 and C3 (section 2.2 of RFC 5794)
 *
 * Taken from the leading 128*3 bits of the fractional part of 1/PI.
 */
inline constexpr uint8_t constants[3][16] = {
    // C1 = 0x517cc1b727220a94fe13abe8fa9a6ee0
    {0x51, 0x7c, 0xc1, 0xb7, 0x27, 0x22, 0x0a, 0x94, 0xfe, 0x13, 0xab, 0xe8,
     0xfa, 0x9a, 0x6e, 0xe0},
    // C2 = 0x6db14acc9e21c820ff28b1d5ef5de2b0
    {0x6d, 0xb1, 0x4a, 0xcc, 0x9e, 0x21, 0xc8, 0x20, 0xff, 0x28, 0xb1, 0xd5,
     0xef, 0x5d, 0xe2, 0xb0},
    // C3 = 0xdb92371d2126e9700324977504e8c90e
    {0xdb, 0x92, 0x37, 0x1d, 0x21, 0x26, 0xe9, 0x70, 0x03, 0x24, 0x97, 0x75,
     0x04, 0xe8, 0xc9, 0x0e}};

} // namespace aria_detail

/**
 * @brief ARIA block cipher (RFC 5794)
 *
 * The block size is fixed at 128 bits and only the key length is selected. Any
 * byte string is a valid key, so setting a key cannot fail.
 *
 * @tparam _KeyBits key size in bits (128, 192 or 256)
 */
template <size_t _KeyBits = 128> class aria {
  static_assert(_KeyBits == 128 || _KeyBits == 192 || _KeyBits == 256,
                "ARIA supports only 128, 192 and 256 bit keys. (RFC 5794)");

public:
  /**
   * @brief Block size in bits
   */
  static constexpr size_t block_bits = 128;

  /**
   * @brief Block size in bytes
   */
  static constexpr size_t block_size = block_bits / 8;

  /**
   * @brief Key size in bits
   */
  static constexpr size_t key_bits = _KeyBits;

  /**
   * @brief Key size in bytes
   */
  static constexpr size_t key_size = key_bits / 8;

  /**
   * @brief Number of rounds (section 2.2 of RFC 5794: 128 -> 12, 192 -> 14,
   * 256 -> 16)
   */
  static constexpr size_t rounds = key_bits / 32 + 8;

  static_assert(rounds == (_KeyBits == 128 ? 12 : (_KeyBits == 192 ? 14 : 16)),
                "ARIA round count computation error");

  /**
   * @brief Number of round keys
   *
   * One more than the number of rounds, because the last round has an
   * additional key addition layer.
   */
  static constexpr size_t round_key_count = rounds + 1;

  /**
   * @brief A good number of blocks to process in one batch
   *
   * Modes of operation use this to size their staging buffers.
   */
  static constexpr size_t preferred_batch = 8;

  /**
   * @brief Key type, for declaring storage for a key
   */
  typedef uint8_t key_t[key_size];

  /**
   * @brief Block type, for declaring storage for a block
   */
  typedef uint8_t block_t[block_size];

  /**
   * @brief A key handed over for reading
   */
  typedef ctl::fixed_bytes<key_size> key_view;

  /**
   * @brief A block handed over for reading
   */
  typedef ctl::fixed_bytes<block_size> block_view;

  /**
   * @brief A block handed over to be written
   */
  typedef ctl::writable_fixed_bytes<block_size> writable_block_view;

  /**
   * @brief One batch in bytes
   */
  static constexpr size_t batch_bytes = preferred_batch * block_size;

  /**
   * @brief One batch handed over for reading
   */
  typedef ctl::fixed_bytes<batch_bytes> batch_view;

  /**
   * @brief One batch handed over to be written
   */
  typedef ctl::writable_fixed_bytes<batch_bytes> writable_batch_view;

  /**
   * @brief Initializes with a key
   *
   * The length the key has to be is part of key_view, so an array or a
   * std::array of the wrong length does not compile and a container whose
   * length is only known at run time is checked here.
   *
   * @param key the key
   * @exception std::invalid_argument if the key is not key_size bytes
   */
  explicit aria(key_view key) { set_key(key); }

  /**
   * @brief Erases the round keys on destruction
   */
  ~aria() {
    ctl::detail::secure_zero(ek_, sizeof(ek_));
    ctl::detail::secure_zero(dk_, sizeof(dk_));
  }

  /**
   * @brief Sets the key again (section 2.2 of RFC 5794)
   *
   * @param key the key
   */
  void set_key(key_view key) {
#if defined(CTL_HAS_X86_HW_ACCEL)
    // The vector path needs the AES instructions for two of the four S-boxes
    // and the byte shuffle for the other two and for the diffusion layer.
    simd_ = ctl::detail::cpu::has_aes() && ctl::detail::cpu::has_byte_shuffle();
#elif defined(CTL_ARIA_VECTOR_MSA)
    // MSA is either selected for the whole translation unit or absent from
    // it. Unlike AES on x86 and ARM there is no optional instruction left to
    // discover at run time.
    simd_ = true;
#elif defined(CTL_ARIA_HAS_VECTOR)
    // On ARM64 the shuffle is part of NEON, which is not optional, so only the
    // AES instructions are left to ask about.
    simd_ = ctl::detail::cpu::has_arm_aes();
#endif

    // KL is the leading 128 bits and KR is the remainder, right padded with
    // zeroes to 128 bits.
    uint8_t kl[16];
    uint8_t kr[16];
    memcpy(kl, key.data(), 16);
    memset(kr, 0, sizeof(kr));
    if constexpr (key_size > 16)
      memcpy(kr, key.data() + 16, key_size - 16);

    // W0 through W3 are derived by a three round 256 bit Feistel cipher.
    uint8_t w[4][16];
    memcpy(w[0], kl, 16);
    odd_round(w[0], constant(0), w[1]);
    ctl::detail::xor_bytes(w[1], kr, w[1], 16);
    even_round(w[1], constant(1), w[2]);
    ctl::detail::xor_bytes(w[2], w[0], w[2], 16);
    odd_round(w[2], constant(2), w[3]);
    ctl::detail::xor_bytes(w[3], w[1], w[3], 16);

    // ek1 through ek17 come in groups of four that share a rotation amount.
    // The amounts the specification writes as left rotations are converted to
    // right rotations here, for instance <<<61 becomes >>>67.
    static constexpr unsigned int rotations[5] = {19, 31, 67, 97, 109};
    size_t index = 0;
    for (unsigned int group = 0; group < 5 && index < round_key_count; ++group)
      for (unsigned int i = 0; i < 4 && index < round_key_count; ++i, ++index) {
        uint8_t rotated[16];
        rotr128(w[(i + 1) & 3], rotations[group], rotated);
        ctl::detail::xor_bytes(w[i], rotated, ek_[index], 16);
        ctl::detail::secure_zero(rotated, sizeof(rotated));
      }

    // dk1 = ek{n+1}, dk{i} = A(ek{n+2-i}), dk{n+1} = ek1
    memcpy(dk_[0], ek_[rounds], 16);
    for (size_t i = 2; i <= rounds; ++i)
      diffuse(ek_[rounds + 1 - i], dk_[i - 1]);
    memcpy(dk_[rounds], ek_[0], 16);

    ctl::detail::secure_zero(w, sizeof(w));
    ctl::detail::secure_zero(kl, sizeof(kl));
    ctl::detail::secure_zero(kr, sizeof(kr));
  }

  /**
   * @brief Encrypts one block
   *
   * @param input the block to encrypt
   * @param output where the result goes, may be the same buffer as input
   */
  void encrypt_block(block_view input, writable_block_view output) const {
    crypt(ek_, input.data(), output.data());
  }

  /**
   * @brief Decrypts one block
   *
   * ARIA is involutional, so decryption follows the same path as encryption
   * and only the round keys are exchanged for the decryption ones (section
   * 2.3.2 of RFC 5794).
   *
   * @param input the block to decrypt
   * @param output where the result goes, may be the same buffer as input
   */
  void decrypt_block(block_view input, writable_block_view output) const {
    crypt(dk_, input.data(), output.data());
  }

  /**
   * @brief Encrypts one block using the table driven path
   *
   * This path stays public even where a vector path exists, because testing
   * that the two agree requires a reference to compare against.
   *
   * @param input the block to encrypt
   * @param output where the result goes, may be the same buffer as input
   */
  void encrypt_block_reference(block_view input,
                              writable_block_view output) const {
    crypt_software(ek_, input.data(), output.data());
  }

  /**
   * @brief Decrypts one block using the table driven path
   *
   * @param input the block to decrypt
   * @param output where the result goes, may be the same buffer as input
   */
  void decrypt_block_reference(block_view input,
                              writable_block_view output) const {
    crypt_software(dk_, input.data(), output.data());
  }

  /**
   * @brief Whether the vector path of the processor is being used
   *
   * Only so that a test can tell the difference. A vector path that is compiled
   * out or never dispatched to passes every known answer, because the table
   * driven path answers for it and answers correctly, and nothing else would
   * notice. That has happened here before, from a macro that ended up defined
   * in terms of itself.
   */
  bool accelerated() const {
#if defined(CTL_ARIA_HAS_VECTOR)
    return simd_;
#else
    return false;
#endif
  }

  /**
   * @brief Whether passing blocks in batches is worthwhile
   *
   * MSA has no AES S-box instruction. Its vector path therefore bitslices
   * eight independent blocks across eight registers and needs a full batch.
   * x86 and ARM still hold one block in one register and gain nothing from
   * batching.
   */
  bool prefers_batching() const {
#if defined(CTL_ARIA_VECTOR_MSA)
    return true;
#else
    return false;
#endif
  }

  /**
   * @brief Encrypts several mutually independent blocks
   *
   * The MSA path transforms eight blocks at once. Other vector paths and the
   * software path simply iterate, keeping one interface for every block cipher.
   *
   * How many blocks there are is not taken as an argument. It follows from the
   * length of the input, and one number describing three buffers is what let a
   * mask with no length of its own, or an output shorter than the input, go
   * unnoticed.
   *
   * @param input the blocks to encrypt, a whole number of them
   * @param output where the results go, at least as long as input and may be
   * the same buffer
   * @exception std::invalid_argument if input is not a whole number of blocks,
   * or if output is shorter than input
   */
  void encrypt_blocks(ctl::bytes input, ctl::writable_bytes output) const {
    const size_t count = ctl::detail::require_whole_blocks(
        "ctl::symmetric::cipher::aria::encrypt_blocks", input, output,
        block_size);
#if defined(CTL_ARIA_VECTOR_MSA)
    size_t i = 0;
    for (; i + preferred_batch <= count; i += preferred_batch)
      crypt_batch_msa(ek_, input.data() + i * block_size,
                      output.data() + i * block_size);
    for (; i < count; ++i)
      crypt_software(ek_, input.data() + i * block_size,
                     output.data() + i * block_size);
#else
    for (size_t i = 0; i < count; ++i)
      crypt(ek_, input.data() + i * block_size, output.data() + i * block_size);
#endif
  }

  /**
   * @brief Decrypts several mutually independent blocks
   *
   * @param input the blocks to decrypt, a whole number of them
   * @param output where the results go, at least as long as input and may be
   * the same buffer
   * @exception std::invalid_argument if input is not a whole number of blocks,
   * or if output is shorter than input
   */
  void decrypt_blocks(ctl::bytes input, ctl::writable_bytes output) const {
    const size_t count = ctl::detail::require_whole_blocks(
        "ctl::symmetric::cipher::aria::decrypt_blocks", input, output,
        block_size);
#if defined(CTL_ARIA_VECTOR_MSA)
    size_t i = 0;
    for (; i + preferred_batch <= count; i += preferred_batch)
      crypt_batch_msa(dk_, input.data() + i * block_size,
                      output.data() + i * block_size);
    for (; i < count; ++i)
      crypt_software(dk_, input.data() + i * block_size,
                     output.data() + i * block_size);
#else
    for (size_t i = 0; i < count; ++i)
      crypt(dk_, input.data() + i * block_size, output.data() + i * block_size);
#endif
  }

  /**
   * @brief Encrypts several blocks with a per block mask applied on both sides
   *
   * Computes output[i] = E(input[i] ^ mask[i]) ^ mask[i], which is what
   * tweakable modes such as XTS need.
   *
   * Exactly one batch, whose length is part of the argument types, matching the
   * shape AES uses so that a mode reaches either cipher through the same code.
   *
   * @param input the batch to encrypt
   * @param mask one mask per block
   * @param output where the results go, may be the same buffer as input
   */
  void encrypt_batch_masked(batch_view input, batch_view mask,
                            writable_batch_view output) const {
#if defined(CTL_ARIA_VECTOR_MSA)
    uint8_t buffer[batch_bytes];
    ctl::detail::xor_bytes(input.data(), mask.data(), buffer, batch_bytes);
    crypt_batch_msa(ek_, buffer, buffer);
    ctl::detail::xor_bytes(buffer, mask.data(), output.data(), batch_bytes);
    ctl::detail::secure_zero(buffer, sizeof(buffer));
#else
    for (size_t i = 0; i < preferred_batch; ++i)
      block_masked(ek_, input.data() + i * block_size,
                   mask.data() + i * block_size,
                   output.data() + i * block_size);
#endif
  }

  /**
   * @brief Decrypts several blocks with a per block mask applied on both sides
   *
   * Computes output[i] = D(input[i] ^ mask[i]) ^ mask[i].
   *
   * @param input the batch to decrypt
   * @param mask one mask per block
   * @param output where the results go, may be the same buffer as input
   */
  void decrypt_batch_masked(batch_view input, batch_view mask,
                            writable_batch_view output) const {
#if defined(CTL_ARIA_VECTOR_MSA)
    uint8_t buffer[batch_bytes];
    ctl::detail::xor_bytes(input.data(), mask.data(), buffer, batch_bytes);
    crypt_batch_msa(dk_, buffer, buffer);
    ctl::detail::xor_bytes(buffer, mask.data(), output.data(), batch_bytes);
    ctl::detail::secure_zero(buffer, sizeof(buffer));
#else
    for (size_t i = 0; i < preferred_batch; ++i)
      block_masked(dk_, input.data() + i * block_size,
                   mask.data() + i * block_size,
                   output.data() + i * block_size);
#endif
  }

  /**
   * @brief Encrypts several blocks and exclusive ors the results with a buffer
   *
   * Computes output[i] = E(input[i]) ^ operand[i], which is what counter based
   * modes need.
   *
   * @param input the batch of counter blocks to encrypt
   * @param operand what to combine the results with
   * @param output where the results go, may be the same buffer as operand
   */
  void encrypt_batch_then_xor(batch_view input, batch_view operand,
                              writable_batch_view output) const {
#if defined(CTL_ARIA_VECTOR_MSA)
    uint8_t buffer[batch_bytes];
    crypt_batch_msa(ek_, input.data(), buffer);
    ctl::detail::xor_bytes(buffer, operand.data(), output.data(), batch_bytes);
    ctl::detail::secure_zero(buffer, sizeof(buffer));
#else
    for (size_t i = 0; i < preferred_batch; ++i) {
      uint8_t buffer[block_size];
      crypt(ek_, input.data() + i * block_size, buffer);
      ctl::detail::xor_block<block_size>(buffer, operand.data() + i * block_size,
                                        output.data() + i * block_size);
      ctl::detail::secure_zero(buffer, sizeof(buffer));
    }
#endif
  }

private:
  /**
   * @brief Transforms one block with a mask applied on both sides
   */
  void block_masked(const uint8_t (&round_key)[round_key_count][16],
                    const uint8_t *input, const uint8_t *mask,
                    uint8_t *output) const {
    uint8_t buffer[block_size];
    ctl::detail::xor_block<block_size>(input, mask, buffer);
    crypt(round_key, buffer, buffer);
    ctl::detail::xor_block<block_size>(buffer, mask, output);
  }

  /**
   * @brief Selects CK1, CK2 and CK3 according to the key size (section 2.2 of
   * RFC 5794)
   *
   * The order is C1 C2 C3 for 128 bit keys, C2 C3 C1 for 192 bit keys and
   * C3 C1 C2 for 256 bit keys.
   *
   * @param index 0 for CK1, 1 for CK2, 2 for CK3
   * @return the selected constant
   */
  static const uint8_t *constant(size_t index) {
    constexpr size_t offset =
        _KeyBits == 128 ? 0 : (_KeyBits == 192 ? 1 : 2);
    return aria_detail::constants[(offset + index) % 3];
  }

  /**
   * @brief Rotates a 128 bit value right
   *
   * Follows the bit order of the specification, in which the most significant
   * bit is bit 0.
   *
   * @param input input of 16 bytes
   * @param bits number of bits to rotate by
   * @param output output of 16 bytes, which must not overlap input
   */
  static void rotr128(const uint8_t *input, unsigned int bits,
                      uint8_t *output) {
    bits %= 128;
    const unsigned int byte_shift = bits / 8;
    const unsigned int bit_shift = bits % 8;
    for (unsigned int i = 0; i < 16; ++i) {
      const unsigned int high = (i + 16 - byte_shift) % 16;
      if (bit_shift == 0) {
        output[i] = input[high];
      } else {
        const unsigned int low = (high + 15) % 16;
        output[i] = static_cast<uint8_t>((input[high] >> bit_shift) |
                                        (input[low] << (8 - bit_shift)));
      }
    }
  }

  /**
   * @brief Type 1 substitution layer SL1 (section 2.4.2 of RFC 5794)
   */
  static CTL_FORCEINLINE void substitute1(const uint8_t *input, uint8_t *output) {
    for (size_t i = 0; i < 16; i += 4) {
      output[i + 0] = ctl::detail::aes_sbox.forward[input[i + 0]];
      output[i + 1] = aria_detail::sb2.forward[input[i + 1]];
      output[i + 2] = ctl::detail::aes_sbox.inverse[input[i + 2]];
      output[i + 3] = aria_detail::sb2.inverse[input[i + 3]];
    }
  }

  /**
   * @brief Type 2 substitution layer SL2 (section 2.4.2 of RFC 5794)
   *
   * The inverse of SL1.
   */
  static CTL_FORCEINLINE void substitute2(const uint8_t *input, uint8_t *output) {
    for (size_t i = 0; i < 16; i += 4) {
      output[i + 0] = ctl::detail::aes_sbox.inverse[input[i + 0]];
      output[i + 1] = aria_detail::sb2.inverse[input[i + 1]];
      output[i + 2] = ctl::detail::aes_sbox.forward[input[i + 2]];
      output[i + 3] = aria_detail::sb2.forward[input[i + 3]];
    }
  }

  /**
   * @brief Diffusion layer A (section 2.4.3 of RFC 5794)
   *
   * A is an involution, so A(A(x)) == x holds.
   *
   * @param x input of 16 bytes
   * @param y output of 16 bytes, may be the same as x
   */
  static CTL_FORCEINLINE void diffuse(const uint8_t *x, uint8_t *y) {
    // Each equation in the specification exclusive ors seven inputs, so
    // carrying them over directly costs 96 exclusive ors. Grouping the sixteen
    // outputs into fours, however, shows that each group shares four inputs.
    // Computing those shared terms once brings the count down to 12 + 48 = 60.
    // This is algebraically identical to the equations as written, so the test
    // values in appendix A of RFC 5794 verify the rearrangement as it stands.
    const uint8_t t0 = x[3] ^ x[4] ^ x[9] ^ x[14];  // y0, y5, y11, y14
    const uint8_t t1 = x[2] ^ x[5] ^ x[8] ^ x[15];  // y1, y4, y10, y15
    const uint8_t t2 = x[1] ^ x[6] ^ x[11] ^ x[12]; // y2, y7, y9,  y12
    const uint8_t t3 = x[0] ^ x[7] ^ x[10] ^ x[13]; // y3, y6, y8,  y13

    uint8_t out[16];
    out[0] = t0 ^ x[6] ^ x[8] ^ x[13];
    out[5] = t0 ^ x[1] ^ x[10] ^ x[15];
    out[11] = t0 ^ x[2] ^ x[7] ^ x[12];
    out[14] = t0 ^ x[0] ^ x[5] ^ x[11];

    out[1] = t1 ^ x[7] ^ x[9] ^ x[12];
    out[4] = t1 ^ x[0] ^ x[11] ^ x[14];
    out[10] = t1 ^ x[3] ^ x[6] ^ x[13];
    out[15] = t1 ^ x[1] ^ x[4] ^ x[10];

    out[2] = t2 ^ x[4] ^ x[10] ^ x[15];
    out[7] = t2 ^ x[3] ^ x[8] ^ x[13];
    out[9] = t2 ^ x[0] ^ x[5] ^ x[14];
    out[12] = t2 ^ x[2] ^ x[7] ^ x[9];

    out[3] = t3 ^ x[5] ^ x[11] ^ x[14];
    out[6] = t3 ^ x[2] ^ x[9] ^ x[12];
    out[8] = t3 ^ x[1] ^ x[4] ^ x[15];
    out[13] = t3 ^ x[3] ^ x[6] ^ x[8];

    memcpy(y, out, sizeof(out));
  }

  /**
   * @brief Odd round function FO(D,RK) = A(SL1(D ^ RK)) (section 2.4.1 of
   * RFC 5794)
   */
  static CTL_FORCEINLINE void odd_round(const uint8_t *data, const uint8_t *round_key,
                        uint8_t *output) {
    // The substitution reads and writes the same index, so it runs in place and
    // the round needs one scratch block rather than two. This was measured and
    // makes no difference to the speed, the compiler was already keeping the
    // second one in registers; it is kept because it is less to read.
    uint8_t t[16];
    ctl::detail::xor_block<16>(data, round_key, t);
    substitute1(t, t);
    diffuse(t, output);
  }

  /**
   * @brief Even round function FE(D,RK) = A(SL2(D ^ RK)) (section 2.4.1 of
   * RFC 5794)
   */
  static CTL_FORCEINLINE void even_round(const uint8_t *data, const uint8_t *round_key,
                         uint8_t *output) {
    uint8_t t[16];
    ctl::detail::xor_block<16>(data, round_key, t);
    substitute2(t, t);
    diffuse(t, output);
  }

  /**
   * @brief Transforms one block with the given round keys (section 2.3.1 of
   * RFC 5794)
   *
   * The last round has no diffusion layer, only SL2 and the key additions.
   */
  void crypt(const uint8_t (&round_key)[round_key_count][16],
             const uint8_t *input, uint8_t *output) const {
#if defined(CTL_ARIA_HAS_VECTOR) && !defined(CTL_ARIA_VECTOR_MSA)
    if (simd_) {
      crypt_vector(round_key, input, output);
      return;
    }
#endif
    crypt_software(round_key, input, output);
  }

  /**
   * @brief Transforms one block with the table driven path
   *
   * Kept available even where the vector path exists, so that the two can be
   * checked against each other.
   */
  static void crypt_software(const uint8_t (&round_key)[round_key_count][16],
                             const uint8_t *input, uint8_t *output) {
    uint8_t state[16];
    memcpy(state, input, sizeof(state));

    for (size_t round = 1; round < rounds; ++round) {
      if (round & 1)
        odd_round(state, round_key[round - 1], state);
      else
        even_round(state, round_key[round - 1], state);
    }

    // C = SL2(P ^ ek{n}) ^ ek{n+1}
    ctl::detail::xor_bytes(state, round_key[rounds - 1], state, 16);
    substitute2(state, output);
    ctl::detail::xor_bytes(output, round_key[rounds], output, 16);

    ctl::detail::secure_zero(state, sizeof(state));
  }

#if defined(CTL_ARIA_HAS_VECTOR)
  /**
   * @brief The sixteen byte operations the vector round is built from
   *
   * Two of them are the whole point. The AES round instruction applied with a
   * zero key is the AES S-box over all sixteen bytes, which is ARIA's SB1, and
   * its inverse is SB3. A sixteen byte table lookup then covers a nibble at a
   * time of the affine map that turns those into SB2 and SB4, and covers the
   * diffusion layer as well. x86 spells the lookup pshufb and ARM spells it
   * tbl, and neither is asked here for an index past the end, since every index
   * used is a byte position.
   */
  struct simd {
#if defined(CTL_HAS_X86_HW_ACCEL)
    typedef __m128i type;

    CTL_TARGET_AESNI static CTL_FORCEINLINE type splat(uint8_t v) {
      return _mm_set1_epi8(static_cast<char>(v));
    }
    CTL_TARGET_AESNI static CTL_FORCEINLINE type load(const uint8_t *at) {
      return _mm_loadu_si128(reinterpret_cast<const __m128i *>(at));
    }
    CTL_TARGET_AESNI static CTL_FORCEINLINE void store(type v, uint8_t *at) {
      _mm_storeu_si128(reinterpret_cast<__m128i *>(at), v);
    }
    CTL_TARGET_AESNI static CTL_FORCEINLINE type bit_and(type a, type b) {
      return _mm_and_si128(a, b);
    }
    CTL_TARGET_AESNI static CTL_FORCEINLINE type bit_or(type a, type b) {
      return _mm_or_si128(a, b);
    }
    CTL_TARGET_AESNI static CTL_FORCEINLINE type bit_xor(type a, type b) {
      return _mm_xor_si128(a, b);
    }
    CTL_TARGET_AESNI static CTL_FORCEINLINE type shuffle(type table,
                                                         type index) {
      return _mm_shuffle_epi8(table, index);
    }
    CTL_TARGET_AESNI static CTL_FORCEINLINE type shift_nibble_down(type v) {
      return _mm_srli_epi16(v, 4);
    }

    // The last round instruction shifts the rows and then substitutes, and the
    // shift is undone by the caller, so with a zero key only the substitution
    // is left.
    CTL_TARGET_AESNI static CTL_FORCEINLINE type substitute_bytes(type v) {
      return _mm_aesenclast_si128(v, _mm_setzero_si128());
    }
    CTL_TARGET_AESNI static CTL_FORCEINLINE type
    substitute_bytes_inverse(type v) {
      return _mm_aesdeclast_si128(v, _mm_setzero_si128());
    }
#elif defined(CTL_HAS_ARM_HW_ACCEL)
    typedef uint8x16_t type;

    CTL_TARGET_ARM_CRYPTO static CTL_FORCEINLINE type splat(uint8_t v) {
      return vdupq_n_u8(v);
    }
    CTL_TARGET_ARM_CRYPTO static CTL_FORCEINLINE type load(const uint8_t *at) {
      return vld1q_u8(at);
    }
    CTL_TARGET_ARM_CRYPTO static CTL_FORCEINLINE void store(type v,
                                                            uint8_t *at) {
      vst1q_u8(at, v);
    }
    CTL_TARGET_ARM_CRYPTO static CTL_FORCEINLINE type bit_and(type a, type b) {
      return vandq_u8(a, b);
    }
    CTL_TARGET_ARM_CRYPTO static CTL_FORCEINLINE type bit_or(type a, type b) {
      return vorrq_u8(a, b);
    }
    CTL_TARGET_ARM_CRYPTO static CTL_FORCEINLINE type bit_xor(type a, type b) {
      return veorq_u8(a, b);
    }
    CTL_TARGET_ARM_CRYPTO static CTL_FORCEINLINE type shuffle(type table,
                                                              type index) {
      return vqtbl1q_u8(table, index);
    }
    CTL_TARGET_ARM_CRYPTO static CTL_FORCEINLINE type
    shift_nibble_down(type v) {
      return vreinterpretq_u8_u16(vshrq_n_u16(vreinterpretq_u16_u8(v), 4));
    }

    // AESE adds the key, shifts the rows and substitutes, in that order. The
    // key is zero and the shift is undone by the caller, just as on x86, so
    // again only the substitution is left.
    CTL_TARGET_ARM_CRYPTO static CTL_FORCEINLINE type substitute_bytes(type v) {
      return vaeseq_u8(v, vdupq_n_u8(0));
    }
    CTL_TARGET_ARM_CRYPTO static CTL_FORCEINLINE type
    substitute_bytes_inverse(type v) {
      return vaesdq_u8(v, vdupq_n_u8(0));
    }
#else
    typedef v16u8 type;

    static CTL_FORCEINLINE type splat(uint8_t v) {
      return (type)__builtin_msa_fill_b(static_cast<int8_t>(v));
    }
    static CTL_FORCEINLINE type load(const uint8_t *at) {
      return (type)__builtin_msa_ld_b(const_cast<uint8_t *>(at), 0);
    }
    static CTL_FORCEINLINE void store(type v, uint8_t *at) {
      __builtin_msa_st_b((v16i8)v, at, 0);
    }
    static CTL_FORCEINLINE type bit_and(type a, type b) { return a & b; }
    static CTL_FORCEINLINE type bit_or(type a, type b) { return a | b; }
    static CTL_FORCEINLINE type bit_xor(type a, type b) { return a ^ b; }
    static CTL_FORCEINLINE type shuffle(type table, type index) {
      return (type)__builtin_msa_vshf_b((v16i8)index, (v16i8)table,
                                        (v16i8)table);
    }
    template <unsigned int _Bit>
    static CTL_FORCEINLINE type repeat_key_bit(type value) {
      static_assert(_Bit < 8, "a byte has eight bits");
      return (type)__builtin_msa_srai_b(
          __builtin_msa_slli_b((v16i8)value, 7 - _Bit), 7);
    }

#endif
  };

  /**
   * @brief A whole block held in one vector register
   */
  typedef typename simd::type vector;

  /**
   * @brief Loads a sixteen byte constant
   */
  CTL_ARIA_TARGET static CTL_FORCEINLINE vector
  constant(const aria_detail::byte_vector &v) {
    return simd::load(v.byte);
  }

#if !defined(CTL_ARIA_VECTOR_MSA)
  /**
   * @brief Applies SB1 to all sixteen bytes
   *
   * ARIA's SB1 is the AES S-box, so the last round instruction of AES performs
   * it. That instruction also shifts the rows, which is undone beforehand so
   * that only the substitution remains.
   */
  CTL_ARIA_TARGET static vector substitute_1(vector x) {
    return simd::substitute_bytes(
        simd::shuffle(x, constant(aria_detail::undo_shift_vector)));
  }

  /**
   * @brief Applies SB3 to all sixteen bytes
   *
   * SB3 is the inverse of SB1 and so is the AES inverse S-box, which the last
   * round instruction of AES decryption performs.
   */
  CTL_ARIA_TARGET static vector substitute_3(vector x) {
    return simd::substitute_bytes_inverse(
        simd::shuffle(x, constant(aria_detail::redo_shift_vector)));
  }

  /**
   * @brief Applies an affine map to all sixteen bytes
   *
   * The linear part splits across the two nibbles of a byte, so one shuffle
   * over a sixteen entry table handles each half.
   */
  CTL_ARIA_TARGET static vector
  affine(vector x, const aria_detail::nibble_tables &tables) {
    const vector mask = simd::splat(0x0f);
    const vector low = simd::load(tables.low);
    const vector high = simd::load(tables.high);
    return simd::bit_xor(
        simd::bit_xor(
            simd::shuffle(low, simd::bit_and(x, mask)),
            simd::shuffle(high,
                          simd::bit_and(simd::shift_nibble_down(x), mask))),
        simd::splat(tables.constant));
  }

  /**
   * @brief Selects from four results by byte position
   */
  CTL_ARIA_TARGET static vector pick(vector a, vector b, vector c, vector d) {
    return simd::bit_or(
        simd::bit_or(simd::bit_and(a, constant(aria_detail::selector[0])),
                     simd::bit_and(b, constant(aria_detail::selector[1]))),
        simd::bit_or(simd::bit_and(c, constant(aria_detail::selector[2])),
                     simd::bit_and(d, constant(aria_detail::selector[3]))));
  }

  /**
   * @brief The substitution layers, both built from the same four results
   *
   * SB2 is the affine map applied to SB1, and SB4 is SB3 applied after the
   * inverse of that map, so the two AES instructions cover all four S-boxes.
   */
  template <bool _Type1> CTL_ARIA_TARGET static vector substitute(vector x) {
    const vector s1 = substitute_1(x);
    const vector s2 = affine(s1, aria_detail::sb2_tables);
    const vector s3 = substitute_3(x);
    const vector s4 = substitute_3(affine(x, aria_detail::sb4_tables));
    if constexpr (_Type1)
      return pick(s1, s2, s3, s4);
    else
      return pick(s3, s4, s1, s2);
  }
#endif

  /**
   * @brief The diffusion layer as seven shuffles added together
   */
  CTL_ARIA_TARGET static vector diffuse_vector(vector x) {
    vector result =
        simd::shuffle(x, simd::load(aria_detail::diffusion_shuffles[0]));
    for (size_t k = 1; k < 7; ++k)
      result = simd::bit_xor(
          result, simd::shuffle(x, simd::load(aria_detail::diffusion_shuffles[k])));
    return result;
  }

#if defined(CTL_ARIA_VECTOR_MSA)
  /**
   * @brief Eight blocks represented by one vector register per bit
   *
   * A byte lane keeps its ARIA byte position. Bit n of that lane represents
   * block n, so bitwise field arithmetic transforms 128 S-box inputs at once.
   */
  typedef vector sliced_state[8];

  static void slice_load(const uint8_t *input, sliced_state &state) {
    uint8_t plane[8][16] = {};
    for (unsigned int byte = 0; byte < block_size; ++byte) {
      uint64_t gathered = 0;
      for (unsigned int block = 0; block < preferred_batch; ++block)
        gathered |= static_cast<uint64_t>(
                        input[block * block_size + byte])
                    << (8 * block);
      const uint64_t transposed =
          ctl::detail::bitslice::transpose_bits(gathered);
      for (unsigned int bit = 0; bit < 8; ++bit)
        plane[bit][byte] =
            static_cast<uint8_t>(transposed >> (8 * bit));
    }
    for (unsigned int bit = 0; bit < 8; ++bit)
      state[bit] = simd::load(plane[bit]);
    ctl::detail::secure_zero(plane, sizeof(plane));
  }

  static void slice_store(const sliced_state &state, uint8_t *output) {
    uint8_t plane[8][16];
    for (unsigned int bit = 0; bit < 8; ++bit)
      simd::store(state[bit], plane[bit]);

    for (unsigned int byte = 0; byte < block_size; ++byte) {
      uint64_t transposed = 0;
      for (unsigned int bit = 0; bit < 8; ++bit)
        transposed |= static_cast<uint64_t>(plane[bit][byte]) << (8 * bit);
      const uint64_t gathered =
          ctl::detail::bitslice::transpose_bits(transposed);
      for (unsigned int block = 0; block < preferred_batch; ++block)
        output[block * block_size + byte] =
            static_cast<uint8_t>(gathered >> (8 * block));
    }
    ctl::detail::secure_zero(plane, sizeof(plane));
  }

  static CTL_FORCEINLINE void
  add_sliced_round_key(sliced_state &state, const uint8_t *round_key) {
    const vector key = simd::load(round_key);
    state[0] =
        simd::bit_xor(state[0], simd::template repeat_key_bit<0>(key));
    state[1] =
        simd::bit_xor(state[1], simd::template repeat_key_bit<1>(key));
    state[2] =
        simd::bit_xor(state[2], simd::template repeat_key_bit<2>(key));
    state[3] =
        simd::bit_xor(state[3], simd::template repeat_key_bit<3>(key));
    state[4] =
        simd::bit_xor(state[4], simd::template repeat_key_bit<4>(key));
    state[5] =
        simd::bit_xor(state[5], simd::template repeat_key_bit<5>(key));
    state[6] =
        simd::bit_xor(state[6], simd::template repeat_key_bit<6>(key));
    state[7] =
        simd::bit_xor(state[7], simd::template repeat_key_bit<7>(key));
  }

  static CTL_FORCEINLINE void
  affine_sliced(sliced_state &state, const aria_detail::affine_map &map) {
    sliced_state input;
    for (unsigned int bit = 0; bit < 8; ++bit)
      input[bit] = state[bit];

    for (unsigned int output_bit = 0; output_bit < 8; ++output_bit) {
      vector result =
          simd::splat((map.constant >> output_bit) & 1 ? 0xff : 0);
      for (unsigned int input_bit = 0; input_bit < 8; ++input_bit)
        if ((map.column[input_bit] >> output_bit) & 1)
          result = simd::bit_xor(result, input[input_bit]);
      state[output_bit] = result;
    }
  }

  static CTL_FORCEINLINE void
  blend_affine(const sliced_state &input, const aria_detail::affine_map &map,
               vector mask, sliced_state &result) {
    sliced_state transformed;
    for (unsigned int bit = 0; bit < 8; ++bit)
      transformed[bit] = input[bit];
    affine_sliced(transformed, map);
    for (unsigned int bit = 0; bit < 8; ++bit)
      result[bit] = simd::bit_or(
          result[bit], simd::bit_and(transformed[bit], mask));
  }

  template <bool _Type1>
  static CTL_FORCEINLINE void substitute_sliced(sliced_state &state) {
    const vector position_0 = constant(aria_detail::selector[0]);
    const vector position_1 = constant(aria_detail::selector[1]);
    const vector position_2 = constant(aria_detail::selector[2]);
    const vector position_3 = constant(aria_detail::selector[3]);

    sliced_state input;
    sliced_state result;
    for (unsigned int bit = 0; bit < 8; ++bit) {
      input[bit] = state[bit];
      result[bit] = simd::splat(0);
    }

    blend_affine(
        input, aria_detail::sb12_tower_pre_map,
        _Type1 ? simd::bit_or(position_0, position_1)
               : simd::bit_or(position_2, position_3),
        result);
    blend_affine(input, aria_detail::sb3_tower_pre_map,
                 _Type1 ? position_2 : position_0, result);
    blend_affine(input, aria_detail::sb4_tower_pre_map,
                 _Type1 ? position_3 : position_1, result);

    ctl::detail::bitslice::tower_inverter<simd>::apply(result);

    for (unsigned int bit = 0; bit < 8; ++bit) {
      input[bit] = result[bit];
      state[bit] = simd::splat(0);
    }
    blend_affine(input, aria_detail::sb1_tower_post_map,
                 _Type1 ? position_0 : position_2, state);
    blend_affine(input, aria_detail::sb2_tower_post_map,
                 _Type1 ? position_1 : position_3, state);
    blend_affine(
        input, aria_detail::sb34_tower_post_map,
        _Type1 ? simd::bit_or(position_2, position_3)
               : simd::bit_or(position_0, position_1),
        state);
  }

  static CTL_FORCEINLINE void diffuse_sliced(sliced_state &state) {
    for (unsigned int bit = 0; bit < 8; ++bit)
      state[bit] = diffuse_vector(state[bit]);
  }

  void crypt_batch_msa(const uint8_t (&round_key)[round_key_count][16],
                       const uint8_t *input, uint8_t *output) const {
    sliced_state state;
    slice_load(input, state);

    for (size_t round = 1; round < rounds; ++round) {
      add_sliced_round_key(state, round_key[round - 1]);
      if (round & 1)
        substitute_sliced<true>(state);
      else
        substitute_sliced<false>(state);
      diffuse_sliced(state);
    }

    add_sliced_round_key(state, round_key[rounds - 1]);
    substitute_sliced<false>(state);
    add_sliced_round_key(state, round_key[rounds]);
    slice_store(state, output);
    ctl::detail::secure_zero(state, sizeof(state));
  }
#endif

#if !defined(CTL_ARIA_VECTOR_MSA)
  /**
   * @brief Transforms one block without the state ever leaving a register
   *
   * This is where the time goes in the table driven path: a byte at a time
   * substitution forces the sixteen byte state out to memory and back on every
   * round. Here it stays in one vector register from the first round to the
   * last.
   */
  CTL_ARIA_TARGET void
  crypt_vector(const uint8_t (&round_key)[round_key_count][16],
               const uint8_t *input, uint8_t *output) const {
    vector state = simd::load(input);

    for (size_t round = 1; round < rounds; ++round) {
      state = simd::bit_xor(state, simd::load(round_key[round - 1]));
      state = (round & 1) ? substitute<true>(state) : substitute<false>(state);
      state = diffuse_vector(state);
    }

    state = simd::bit_xor(state, simd::load(round_key[rounds - 1]));
    state = substitute<false>(state);
    state = simd::bit_xor(state, simd::load(round_key[rounds]));

    simd::store(state, output);
  }
#endif
#endif

  /**
   * @brief Round keys for encryption
   */
  uint8_t ek_[round_key_count][16];

  /**
   * @brief Round keys for decryption
   */
  uint8_t dk_[round_key_count][16];

#if defined(CTL_ARIA_HAS_VECTOR)
  /**
   * @brief Whether the vector path is used, determined once when the key is set
   */
  bool simd_;
#endif
};

