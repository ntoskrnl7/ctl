/**
 * @file lea
 * @author jung-kwang lee (ntoskrnl7@gmail.com)
 * @brief LEA block cipher (KS X 3246, ISO/IEC 29192-2)
 *
 * A lightweight cipher published by the National Security Research Institute of
 * Korea in 2013. The block is 128 bits and the key is 128, 192 or 256 bits, so
 * it composes with every mode here exactly as AES and ARIA do.
 *
 * Where AES and ARIA substitute bytes through a table, LEA is built only from
 * addition modulo 2^32, bitwise rotation and exclusive or. Two things follow
 * from that, and both matter.
 *
 * The first is that there is no table to generate, and no table to get wrong.
 * What the other two ciphers here spend a header on producing at compile time
 * simply does not exist. Only the eight round constants are written out, and
 * unlike an S-box they satisfy no property that could check them, so what
 * confirms them is the published test vectors and nothing else.
 *
 * The second is that nothing is ever indexed by key dependent data. The software
 * path of AES is table driven, which is what the note at the end of the README
 * is about: a table lookup whose index depends on the key can leak through cache
 * timing. LEA has no such lookup on any path, so it does not have that property
 * to begin with, and it does not need a hardware path to avoid it.
 *
 * Words are little endian here, the opposite of AES, ARIA and GCM. Reading a
 * block big endian produces a wrong answer that still round trips, so the
 * published vectors are what catches it.
 *
 * There is a vector path, and the narrow one needs nothing but SSE2. A round is
 * four 32 bit words put through addition, exclusive or and rotation, and none of
 * those look at anything outside their own lane, so four blocks go through four
 * lanes with the same instruction sequence a single block uses. ARIA had to
 * borrow the AES round instructions to get at its S-box, and AES needs AES-NI to
 * be quick at all; this needs neither, only the ability to add and shift four
 * words at once, which every 64 bit x86 processor has. Where AVX2 is there as
 * well the same thing runs eight blocks wide.
 *
 * The two together come to about five times one block at a time. What is left
 * on the table is that there is no rotate instruction below AVX-512, so each of
 * the three per round is a pair of shifts and an or; a machine with AVX-512
 * would get those back.
 *
 * @version 0.1
 *
 * @copyright Copyright (c) 2022 C++ Cryptographics template library Authors
 *
 */
#pragma once

#include <cstddef>
#include <cstdint>

#include <ctl/bytes>
#include <ctl/detail/config>
#include <ctl/detail/cpu>
#include <ctl/detail/endian>
#include <ctl/detail/memory>

#if defined(CTL_HAS_X86_HW_ACCEL)
#if defined(_MSC_VER)
#include <intrin.h>
#else
#include <immintrin.h>
#endif
#endif

namespace ctl {
namespace symmetric {
namespace cipher {

namespace lea_detail {

/**
 * @brief The round constants of the key schedule
 *
 * The only values in this library that are copied from a document and cannot be
 * checked by any property of their own. An S-box has to be a permutation, and a
 * round transformation table has to agree with the matrix it came from, so a
 * mistyped byte in either fails the build. These are eight arbitrary words, and
 * a mistyped digit here produces a cipher that is wrong and still round trips
 * with itself. The known answer tests are what stands between that and the
 * build passing.
 *
 * A key schedule of n words uses the first n of these, so LEA-128 uses four,
 * LEA-192 six and LEA-256 all eight.
 */
inline constexpr uint32_t delta[8] = {0xc3efe9dbu, 0x44626b02u, 0x79e27c8au,
                                      0x78df30ecu, 0x715ea49eu, 0xc785da0au,
                                      0xe04ef22au, 0xe5c40957u};

/**
 * @brief How far each word of the key schedule state is rotated
 */
inline constexpr unsigned int key_rotations[6] = {1, 3, 6, 11, 13, 17};

} // namespace lea_detail

/**
 * @brief LEA block cipher (KS X 3246, ISO/IEC 29192-2)
 *
 * The block size is fixed at 128 bits and only the key length is selected. Any
 * byte string is a valid key, so setting a key cannot fail.
 *
 * @tparam _KeyBits key size in bits (128, 192 or 256)
 */
template <size_t _KeyBits = 128> class lea {
  static_assert(_KeyBits == 128 || _KeyBits == 192 || _KeyBits == 256,
                "LEA supports only 128, 192 and 256 bit keys. (KS X 3246)");

public:
  /**
   * @brief Block size in bits
   */
  static constexpr size_t block_bits = 128;

  /**
   * @brief Block size in bytes
   */
  static constexpr size_t block_size = block_bits / 8;

  /**
   * @brief Key size in bits
   */
  static constexpr size_t key_bits = _KeyBits;

  /**
   * @brief Key size in bytes
   */
  static constexpr size_t key_size = key_bits / 8;

  /**
   * @brief Number of key words, which is four, six or eight
   */
  static constexpr size_t key_words = key_size / 4;

  /**
   * @brief Number of rounds
   */
  static constexpr size_t rounds = 2 * key_words + 16;

  static_assert(rounds == (_KeyBits == 128 ? 24 : (_KeyBits == 192 ? 28 : 32)),
                "LEA round count computation error");

  /**
   * @brief Number of words in one round key
   */
  static constexpr size_t round_key_words = 6;

  /**
   * @brief A good number of blocks to process in one batch
   *
   * Kept in line with the other ciphers so that a mode sizes its staging
   * buffers the same way whichever cipher it was given. The vector path takes
   * four blocks at a time, so a batch is two passes of it.
   */
  static constexpr size_t preferred_batch = 8;

  /**
   * @brief How many blocks the narrow vector path takes at once
   *
   * Four 32 bit lanes in a 128 bit register, one block per lane.
   */
  static constexpr size_t vector_blocks = 4;

  /**
   * @brief How many blocks the wide vector path takes at once
   *
   * Eight 32 bit lanes in a 256 bit register. A batch is exactly this, so a
   * mode that hands over a batch reaches the wide path in one pass.
   */
  static constexpr size_t wide_blocks = 8;

  /**
   * @brief Key type, for declaring storage for a key
   */
  typedef uint8_t key_t[key_size];

  /**
   * @brief Block type, for declaring storage for a block
   */
  typedef uint8_t block_t[block_size];

  /**
   * @brief A key handed over for reading
   */
  typedef ctl::fixed_bytes<key_size> key_view;

  /**
   * @brief A block handed over for reading
   */
  typedef ctl::fixed_bytes<block_size> block_view;

  /**
   * @brief A block handed over to be written
   */
  typedef ctl::writable_fixed_bytes<block_size> writable_block_view;

  /**
   * @brief One batch in bytes
   */
  static constexpr size_t batch_bytes = preferred_batch * block_size;

  /**
   * @brief One batch handed over for reading
   */
  typedef ctl::fixed_bytes<batch_bytes> batch_view;

  /**
   * @brief One batch handed over to be written
   */
  typedef ctl::writable_fixed_bytes<batch_bytes> writable_batch_view;

  /**
   * @brief Initializes with a key
   *
   * @param key the key
   * @exception std::invalid_argument if the key is not key_size bytes
   */
  explicit lea(key_view key) { set_key(key); }

  /**
   * @brief Erases the round keys on destruction
   */
  ~lea() {
    ctl::detail::secure_zero(rk_, sizeof(rk_));
#if defined(CTL_HAS_X86_HW_ACCEL)
    ctl::detail::secure_zero(rkv_, sizeof(rkv_));
#endif
  }

  /**
   * @brief Sets the key again
   *
   * The state starts as the key itself and every round advances it, so the
   * round keys have to be produced in order and the whole schedule is built
   * here rather than a round at a time.
   *
   * LEA-128 is the one that does not follow the general shape: its state stays
   * four words, only four of them are updated per round, and the round key
   * repeats one of them three times. The wider two update six of their words
   * per round, walking around a state of six or eight, and their round key is
   * simply those six.
   *
   * @param key the key
   */
  void set_key(key_view key) {
#if defined(CTL_HAS_X86_HW_ACCEL)
    vector_ = ctl::detail::cpu::has_sse2();
    wide_ = ctl::detail::cpu::has_avx2();
#endif

    uint32_t t[key_words];
    for (size_t i = 0; i < key_words; ++i)
      t[i] = ctl::detail::load_le32(key.data() + 4 * i);

    for (size_t i = 0; i < rounds; ++i) {
      // The constant is rotated by the round number, which passes 32 for the
      // wider keys, so the amount is reduced rather than shifting a word by
      // more than its width.
      const uint32_t d = lea_detail::delta[i % key_words];

      if constexpr (key_words == 4) {
        for (size_t j = 0; j < 4; ++j)
          t[j] = ctl::detail::rotl32(
              t[j] + ctl::detail::rotl32(
                         d, static_cast<unsigned int>((i + j) & 31u)),
              lea_detail::key_rotations[j]);

        rk_[i][0] = t[0];
        rk_[i][1] = t[1];
        rk_[i][2] = t[2];
        rk_[i][3] = t[1];
        rk_[i][4] = t[3];
        rk_[i][5] = t[1];
      } else {
        // For six words this picks j, since six times anything is a multiple of
        // six; for eight it walks around the state six places per round. One
        // expression covers both.
        for (size_t j = 0; j < 6; ++j) {
          const size_t at = (6 * i + j) % key_words;
          t[at] = ctl::detail::rotl32(
              t[at] + ctl::detail::rotl32(
                          d, static_cast<unsigned int>((i + j) & 31u)),
              lea_detail::key_rotations[j]);
          rk_[i][j] = t[at];
        }
      }
    }

#if defined(CTL_HAS_X86_HW_ACCEL)
    // Every lane of the vector path wants the same round key word, so the
    // broadcast is done once here instead of six times per round inside the
    // loop. It costs four times the room, which for LEA-128 is a little over
    // two kilobytes, and takes a load where the inner loop would otherwise have
    // a move and a shuffle.
    if (vector_) {
      for (size_t i = 0; i < rounds; ++i)
        for (size_t j = 0; j < round_key_words; ++j)
          for (size_t lane = 0; lane < wide_blocks; ++lane)
            rkv_[i][j][lane] = rk_[i][j];
    }
#endif

    ctl::detail::secure_zero(t, sizeof(t));
  }

  /**
   * @brief Encrypts one block
   *
   * @param input the block to encrypt
   * @param output where the result goes, may be the same buffer as input
   */
  void encrypt_block(block_view input, writable_block_view output) const {
    uint32_t x0 = ctl::detail::load_le32(input.data() + 0);
    uint32_t x1 = ctl::detail::load_le32(input.data() + 4);
    uint32_t x2 = ctl::detail::load_le32(input.data() + 8);
    uint32_t x3 = ctl::detail::load_le32(input.data() + 12);

    for (size_t i = 0; i < rounds; ++i) {
      const uint32_t *rk = rk_[i];
      // The last word of the result is the first word of the input, so it is
      // kept before the first word is overwritten. Everything else reads a word
      // that has not been written yet, so the three assignments can stand in
      // this order without further copies.
      const uint32_t carried = x0;
      x0 = ctl::detail::rotl32((x0 ^ rk[0]) + (x1 ^ rk[1]), 9);
      x1 = ctl::detail::rotr32((x1 ^ rk[2]) + (x2 ^ rk[3]), 5);
      x2 = ctl::detail::rotr32((x2 ^ rk[4]) + (x3 ^ rk[5]), 3);
      x3 = carried;
    }

    ctl::detail::store_le32(x0, output.data() + 0);
    ctl::detail::store_le32(x1, output.data() + 4);
    ctl::detail::store_le32(x2, output.data() + 8);
    ctl::detail::store_le32(x3, output.data() + 12);
  }

  /**
   * @brief Decrypts one block
   *
   * Each round is undone in turn. The addition of the round becomes a
   * subtraction and the rotations turn the other way, and because the first
   * word of the round input was carried into the last word of its output, that
   * is what the round starts from.
   *
   * @param input the block to decrypt
   * @param output where the result goes, may be the same buffer as input
   */
  void decrypt_block(block_view input, writable_block_view output) const {
    uint32_t x0 = ctl::detail::load_le32(input.data() + 0);
    uint32_t x1 = ctl::detail::load_le32(input.data() + 4);
    uint32_t x2 = ctl::detail::load_le32(input.data() + 8);
    uint32_t x3 = ctl::detail::load_le32(input.data() + 12);

    for (size_t i = rounds; i-- > 0;) {
      const uint32_t *rk = rk_[i];
      const uint32_t p0 = x3;
      const uint32_t p1 =
          (ctl::detail::rotr32(x0, 9) - (p0 ^ rk[0])) ^ rk[1];
      const uint32_t p2 =
          (ctl::detail::rotl32(x1, 5) - (p1 ^ rk[2])) ^ rk[3];
      const uint32_t p3 =
          (ctl::detail::rotl32(x2, 3) - (p2 ^ rk[4])) ^ rk[5];
      x0 = p0;
      x1 = p1;
      x2 = p2;
      x3 = p3;
    }

    ctl::detail::store_le32(x0, output.data() + 0);
    ctl::detail::store_le32(x1, output.data() + 4);
    ctl::detail::store_le32(x2, output.data() + 8);
    ctl::detail::store_le32(x3, output.data() + 12);
  }

  /**
   * @brief Whether passing blocks in batches is worthwhile
   *
   * It is exactly when the vector path is available, since that is what turns
   * several independent blocks into one pass.
   */
  bool prefers_batching() const {
#if defined(CTL_HAS_X86_HW_ACCEL)
    return vector_;
#else
    return false;
#endif
  }

  /**
   * @brief Encrypts several mutually independent blocks
   *
   * @param input the blocks to encrypt, a whole number of them
   * @param output where the results go, at least as long as input and may be
   * the same buffer
   * @exception std::invalid_argument if input is not a whole number of blocks,
   * or if output is shorter than input
   */
  void encrypt_blocks(ctl::bytes input, ctl::writable_bytes output) const {
    const size_t count = ctl::detail::require_whole_blocks(
        "ctl::symmetric::cipher::lea::encrypt_blocks", input, output,
        block_size);
    const uint8_t *in = input.data();
    uint8_t *out = output.data();
    size_t i = 0;
#if defined(CTL_HAS_X86_HW_ACCEL)
    if (wide_)
      for (; i + wide_blocks <= count; i += wide_blocks)
        eight<true>(in + i * block_size, out + i * block_size);
    if (vector_)
      for (; i + vector_blocks <= count; i += vector_blocks)
        four<true>(in + i * block_size, out + i * block_size);
#endif
    for (; i < count; ++i)
      encrypt_block(block_view(in + i * block_size),
                    writable_block_view(out + i * block_size));
  }

  /**
   * @brief Decrypts several mutually independent blocks
   *
   * @param input the blocks to decrypt, a whole number of them
   * @param output where the results go, at least as long as input and may be
   * the same buffer
   * @exception std::invalid_argument if input is not a whole number of blocks,
   * or if output is shorter than input
   */
  void decrypt_blocks(ctl::bytes input, ctl::writable_bytes output) const {
    const size_t count = ctl::detail::require_whole_blocks(
        "ctl::symmetric::cipher::lea::decrypt_blocks", input, output,
        block_size);
    const uint8_t *in = input.data();
    uint8_t *out = output.data();
    size_t i = 0;
#if defined(CTL_HAS_X86_HW_ACCEL)
    if (wide_)
      for (; i + wide_blocks <= count; i += wide_blocks)
        eight<false>(in + i * block_size, out + i * block_size);
    if (vector_)
      for (; i + vector_blocks <= count; i += vector_blocks)
        four<false>(in + i * block_size, out + i * block_size);
#endif
    for (; i < count; ++i)
      decrypt_block(block_view(in + i * block_size),
                    writable_block_view(out + i * block_size));
  }

  /**
   * @brief Encrypts several blocks a block at a time, never using the vector
   * path
   *
   * Kept public so that the test comparing the two paths has a reference to
   * compare against.
   *
   * @param input the blocks to encrypt, a whole number of them
   * @param output where the results go, at least as long as input
   */
  void encrypt_blocks_software(ctl::bytes input,
                               ctl::writable_bytes output) const {
    const size_t count = ctl::detail::require_whole_blocks(
        "ctl::symmetric::cipher::lea::encrypt_blocks_software", input, output,
        block_size);
    for (size_t i = 0; i < count; ++i)
      encrypt_block(block_view(input.data() + i * block_size),
                    writable_block_view(output.data() + i * block_size));
  }

  /**
   * @brief Decrypts several blocks a block at a time, never using the vector
   * path
   *
   * @param input the blocks to decrypt, a whole number of them
   * @param output where the results go, at least as long as input
   */
  void decrypt_blocks_software(ctl::bytes input,
                               ctl::writable_bytes output) const {
    const size_t count = ctl::detail::require_whole_blocks(
        "ctl::symmetric::cipher::lea::decrypt_blocks_software", input, output,
        block_size);
    for (size_t i = 0; i < count; ++i)
      decrypt_block(block_view(input.data() + i * block_size),
                    writable_block_view(output.data() + i * block_size));
  }

  /**
   * @brief Encrypts one batch with a per block mask applied on both sides
   *
   * Computes output[i] = E(input[i] ^ mask[i]) ^ mask[i], which is what
   * tweakable modes such as XTS need. There is no vector path, so this simply
   * iterates; the entry point exists so that a mode works with any block cipher
   * through the same code.
   *
   * @param input the batch to encrypt
   * @param mask one mask per block
   * @param output where the results go, may be the same buffer as input
   */
  void encrypt_batch_masked(batch_view input, batch_view mask,
                            writable_batch_view output) const {
#if defined(CTL_HAS_X86_HW_ACCEL)
    if (wide_) {
      eight_combined<true, true>(input.data(), mask.data(), output.data());
      return;
    }
    if (vector_) {
      for (size_t i = 0; i < preferred_batch; i += vector_blocks)
        four_combined<true, true>(input.data() + i * block_size,
                                  mask.data() + i * block_size,
                                  output.data() + i * block_size);
      return;
    }
#endif
    for (size_t i = 0; i < preferred_batch; ++i)
      block_masked<true>(input.data() + i * block_size,
                         mask.data() + i * block_size,
                         output.data() + i * block_size);
  }

  /**
   * @brief Decrypts one batch with a per block mask applied on both sides
   *
   * @param input the batch to decrypt
   * @param mask one mask per block
   * @param output where the results go, may be the same buffer as input
   */
  void decrypt_batch_masked(batch_view input, batch_view mask,
                            writable_batch_view output) const {
#if defined(CTL_HAS_X86_HW_ACCEL)
    if (wide_) {
      eight_combined<false, true>(input.data(), mask.data(), output.data());
      return;
    }
    if (vector_) {
      for (size_t i = 0; i < preferred_batch; i += vector_blocks)
        four_combined<false, true>(input.data() + i * block_size,
                                   mask.data() + i * block_size,
                                   output.data() + i * block_size);
      return;
    }
#endif
    for (size_t i = 0; i < preferred_batch; ++i)
      block_masked<false>(input.data() + i * block_size,
                          mask.data() + i * block_size,
                          output.data() + i * block_size);
  }

  /**
   * @brief Encrypts one batch and exclusive ors the results with a buffer
   *
   * Computes output[i] = E(input[i]) ^ operand[i], which is what counter based
   * modes need.
   *
   * @param input the batch of counter blocks to encrypt
   * @param operand what to combine the results with
   * @param output where the results go, may be the same buffer as operand
   */
  void encrypt_batch_then_xor(batch_view input, batch_view operand,
                              writable_batch_view output) const {
#if defined(CTL_HAS_X86_HW_ACCEL)
    if (wide_) {
      eight_combined<true, false>(input.data(), operand.data(), output.data());
      return;
    }
    if (vector_) {
      for (size_t i = 0; i < preferred_batch; i += vector_blocks)
        four_combined<true, false>(input.data() + i * block_size,
                                   operand.data() + i * block_size,
                                   output.data() + i * block_size);
      return;
    }
#endif
    for (size_t i = 0; i < preferred_batch; ++i) {
      uint8_t buffer[block_size];
      encrypt_block(block_view(input.data() + i * block_size), buffer);
      ctl::detail::xor_block<block_size>(buffer, operand.data() + i * block_size,
                                        output.data() + i * block_size);
    }
  }

private:
#if defined(CTL_HAS_X86_HW_ACCEL)
  /**
   * @brief Rotates each of the four lanes left
   *
   * There is no rotate instruction below AVX-512, so it is the usual pair of
   * shifts and an or. Three instructions where the scalar path has one is the
   * price of the vector path, and four lanes is what pays it.
   */
  template <unsigned int _N>
  static CTL_TARGET_SSE2 CTL_FORCEINLINE __m128i rotl_lanes(__m128i v) {
    return _mm_or_si128(_mm_slli_epi32(v, _N), _mm_srli_epi32(v, 32 - _N));
  }

  /**
   * @brief Rotates each of the four lanes right
   */
  template <unsigned int _N>
  static CTL_TARGET_SSE2 CTL_FORCEINLINE __m128i rotr_lanes(__m128i v) {
    return _mm_or_si128(_mm_srli_epi32(v, _N), _mm_slli_epi32(v, 32 - _N));
  }

  /**
   * @brief Exchanges rows and columns of four blocks
   *
   * Blocks arrive one after another, so a register loaded straight from memory
   * holds the four words of one block. The round wants the opposite: one word
   * of each of four blocks, so that a lane is a block and the four of them go
   * through the round together. This is that exchange, and it is its own
   * inverse, so the same eight instructions put the result back.
   */
  static CTL_TARGET_SSE2 CTL_FORCEINLINE void
  transpose(__m128i &a, __m128i &b, __m128i &c, __m128i &d) {
    const __m128i ab_low = _mm_unpacklo_epi32(a, b);
    const __m128i ab_high = _mm_unpackhi_epi32(a, b);
    const __m128i cd_low = _mm_unpacklo_epi32(c, d);
    const __m128i cd_high = _mm_unpackhi_epi32(c, d);
    a = _mm_unpacklo_epi64(ab_low, cd_low);
    b = _mm_unpackhi_epi64(ab_low, cd_low);
    c = _mm_unpacklo_epi64(ab_high, cd_high);
    d = _mm_unpackhi_epi64(ab_high, cd_high);
  }

  /**
   * @brief Runs every round over four blocks held one to a lane
   *
   * The same sequence the scalar path runs, with each operation applied to four
   * lanes at once. Nothing here looks outside its own lane, which is the whole
   * reason this works.
   *
   * @tparam _Encrypt true to encrypt, false to decrypt
   */
  template <bool _Encrypt>
  CTL_TARGET_SSE2 CTL_FORCEINLINE void
  rounds_lanes(__m128i &x0, __m128i &x1, __m128i &x2, __m128i &x3) const {
    if constexpr (_Encrypt) {
      for (size_t i = 0; i < rounds; ++i) {
        const uint32_t(&rk)[round_key_words][wide_blocks] = rkv_[i];
        const __m128i carried = x0;
        x0 = rotl_lanes<9>(_mm_add_epi32(_mm_xor_si128(x0, load_key(rk[0])),
                                         _mm_xor_si128(x1, load_key(rk[1]))));
        x1 = rotr_lanes<5>(_mm_add_epi32(_mm_xor_si128(x1, load_key(rk[2])),
                                         _mm_xor_si128(x2, load_key(rk[3]))));
        x2 = rotr_lanes<3>(_mm_add_epi32(_mm_xor_si128(x2, load_key(rk[4])),
                                         _mm_xor_si128(x3, load_key(rk[5]))));
        x3 = carried;
      }
    } else {
      for (size_t i = rounds; i-- > 0;) {
        const uint32_t(&rk)[round_key_words][wide_blocks] = rkv_[i];
        const __m128i p0 = x3;
        const __m128i p1 = _mm_xor_si128(
            _mm_sub_epi32(rotr_lanes<9>(x0),
                          _mm_xor_si128(p0, load_key(rk[0]))),
            load_key(rk[1]));
        const __m128i p2 = _mm_xor_si128(
            _mm_sub_epi32(rotl_lanes<5>(x1),
                          _mm_xor_si128(p1, load_key(rk[2]))),
            load_key(rk[3]));
        const __m128i p3 = _mm_xor_si128(
            _mm_sub_epi32(rotl_lanes<3>(x2),
                          _mm_xor_si128(p2, load_key(rk[4]))),
            load_key(rk[5]));
        x0 = p0;
        x1 = p1;
        x2 = p2;
        x3 = p3;
      }
    }
  }

  /**
   * @brief Reads one round key word already spread across the lanes
   */
  static CTL_TARGET_SSE2 CTL_FORCEINLINE __m128i load_key(const uint32_t *at) {
    return _mm_loadu_si128(reinterpret_cast<const __m128i *>(at));
  }

  /**
   * @brief Transforms four blocks
   *
   * @tparam _Encrypt true to encrypt, false to decrypt
   */
  template <bool _Encrypt>
  CTL_TARGET_SSE2 void four(const uint8_t *input, uint8_t *output) const {
    __m128i a = load_block(input + 0 * block_size);
    __m128i b = load_block(input + 1 * block_size);
    __m128i c = load_block(input + 2 * block_size);
    __m128i d = load_block(input + 3 * block_size);

    transpose(a, b, c, d);
    rounds_lanes<_Encrypt>(a, b, c, d);
    transpose(a, b, c, d);

    store_block(a, output + 0 * block_size);
    store_block(b, output + 1 * block_size);
    store_block(c, output + 2 * block_size);
    store_block(d, output + 3 * block_size);
  }

  /**
   * @brief Transforms four blocks, combining them with a second buffer
   *
   * Exclusive or is applied lane by lane just as the round is, so it happens on
   * the blocks as they were loaded, before and after the exchange rather than
   * inside it. Nothing reaches memory between the two.
   *
   * @tparam _Encrypt true to encrypt, false to decrypt
   * @tparam _MaskInput true to combine on the way in as well, which is what a
   * tweakable mode needs; false to combine only on the way out, which is what a
   * counter based mode needs
   */
  template <bool _Encrypt, bool _MaskInput>
  CTL_TARGET_SSE2 void four_combined(const uint8_t *input, const uint8_t *mask,
                                     uint8_t *output) const {
    __m128i a = load_block(input + 0 * block_size);
    __m128i b = load_block(input + 1 * block_size);
    __m128i c = load_block(input + 2 * block_size);
    __m128i d = load_block(input + 3 * block_size);

    const __m128i m0 = load_block(mask + 0 * block_size);
    const __m128i m1 = load_block(mask + 1 * block_size);
    const __m128i m2 = load_block(mask + 2 * block_size);
    const __m128i m3 = load_block(mask + 3 * block_size);

    if constexpr (_MaskInput) {
      a = _mm_xor_si128(a, m0);
      b = _mm_xor_si128(b, m1);
      c = _mm_xor_si128(c, m2);
      d = _mm_xor_si128(d, m3);
    }

    transpose(a, b, c, d);
    rounds_lanes<_Encrypt>(a, b, c, d);
    transpose(a, b, c, d);

    store_block(_mm_xor_si128(a, m0), output + 0 * block_size);
    store_block(_mm_xor_si128(b, m1), output + 1 * block_size);
    store_block(_mm_xor_si128(c, m2), output + 2 * block_size);
    store_block(_mm_xor_si128(d, m3), output + 3 * block_size);
  }

  /**
   * @brief Reads one block
   *
   * The words of LEA are little endian, which is the order the bytes are
   * already in on the processors this path runs on, so the load needs no
   * rearranging. This is where AES and ARIA would have to shuffle.
   */
  static CTL_TARGET_SSE2 CTL_FORCEINLINE __m128i load_block(const uint8_t *at) {
    return _mm_loadu_si128(reinterpret_cast<const __m128i *>(at));
  }

  /**
   * @brief Writes one block
   */
  static CTL_TARGET_SSE2 CTL_FORCEINLINE void store_block(__m128i v,
                                                          uint8_t *at) {
    _mm_storeu_si128(reinterpret_cast<__m128i *>(at), v);
  }

  // The wide path repeats the narrow one with twice the lanes. The one thing
  // that is not a simple substitution is where the blocks are picked up from,
  // and that is what the pairing below is about.

  /**
   * @brief Rotates each of the eight lanes left
   */
  template <unsigned int _N>
  static CTL_TARGET_AVX2 CTL_FORCEINLINE __m256i rotl_wide(__m256i v) {
    return _mm256_or_si256(_mm256_slli_epi32(v, _N),
                           _mm256_srli_epi32(v, 32 - _N));
  }

  /**
   * @brief Rotates each of the eight lanes right
   */
  template <unsigned int _N>
  static CTL_TARGET_AVX2 CTL_FORCEINLINE __m256i rotr_wide(__m256i v) {
    return _mm256_or_si256(_mm256_srli_epi32(v, _N),
                           _mm256_slli_epi32(v, 32 - _N));
  }

  /**
   * @brief Reads a block and the one four along into the two halves
   *
   * The exchange below works within each half of the register and never across
   * the middle, which is what the unpack instructions do and the only thing they
   * do. So the halves are loaded with blocks that belong together under it:
   * block j low and block j+4 high. Four of these cover eight blocks, the
   * exchange transposes both halves at once, and every lane ends up holding one
   * block. Loading the eight blocks in their natural order instead would need a
   * crossing permute afterwards to undo the split.
   */
  static CTL_TARGET_AVX2 CTL_FORCEINLINE __m256i load_pair(const uint8_t *at) {
    return _mm256_inserti128_si256(
        _mm256_castsi128_si256(
            _mm_loadu_si128(reinterpret_cast<const __m128i *>(at))),
        _mm_loadu_si128(
            reinterpret_cast<const __m128i *>(at + 4 * block_size)),
        1);
  }

  /**
   * @brief Writes the two halves back to a block and the one four along
   */
  static CTL_TARGET_AVX2 CTL_FORCEINLINE void store_pair(__m256i v,
                                                         uint8_t *at) {
    _mm_storeu_si128(reinterpret_cast<__m128i *>(at),
                     _mm256_castsi256_si128(v));
    _mm_storeu_si128(reinterpret_cast<__m128i *>(at + 4 * block_size),
                     _mm256_extracti128_si256(v, 1));
  }

  /**
   * @brief Reads one round key word already spread across eight lanes
   */
  static CTL_TARGET_AVX2 CTL_FORCEINLINE __m256i
  load_key_wide(const uint32_t *at) {
    return _mm256_loadu_si256(reinterpret_cast<const __m256i *>(at));
  }

  /**
   * @brief Exchanges rows and columns within each half of the registers
   */
  static CTL_TARGET_AVX2 CTL_FORCEINLINE void
  transpose_wide(__m256i &a, __m256i &b, __m256i &c, __m256i &d) {
    const __m256i ab_low = _mm256_unpacklo_epi32(a, b);
    const __m256i ab_high = _mm256_unpackhi_epi32(a, b);
    const __m256i cd_low = _mm256_unpacklo_epi32(c, d);
    const __m256i cd_high = _mm256_unpackhi_epi32(c, d);
    a = _mm256_unpacklo_epi64(ab_low, cd_low);
    b = _mm256_unpackhi_epi64(ab_low, cd_low);
    c = _mm256_unpacklo_epi64(ab_high, cd_high);
    d = _mm256_unpackhi_epi64(ab_high, cd_high);
  }

  /**
   * @brief Runs every round over eight blocks held one to a lane
   *
   * @tparam _Encrypt true to encrypt, false to decrypt
   */
  template <bool _Encrypt>
  CTL_TARGET_AVX2 CTL_FORCEINLINE void
  rounds_wide(__m256i &x0, __m256i &x1, __m256i &x2, __m256i &x3) const {
    if constexpr (_Encrypt) {
      for (size_t i = 0; i < rounds; ++i) {
        const uint32_t(&rk)[round_key_words][wide_blocks] = rkv_[i];
        const __m256i carried = x0;
        x0 = rotl_wide<9>(
            _mm256_add_epi32(_mm256_xor_si256(x0, load_key_wide(rk[0])),
                             _mm256_xor_si256(x1, load_key_wide(rk[1]))));
        x1 = rotr_wide<5>(
            _mm256_add_epi32(_mm256_xor_si256(x1, load_key_wide(rk[2])),
                             _mm256_xor_si256(x2, load_key_wide(rk[3]))));
        x2 = rotr_wide<3>(
            _mm256_add_epi32(_mm256_xor_si256(x2, load_key_wide(rk[4])),
                             _mm256_xor_si256(x3, load_key_wide(rk[5]))));
        x3 = carried;
      }
    } else {
      for (size_t i = rounds; i-- > 0;) {
        const uint32_t(&rk)[round_key_words][wide_blocks] = rkv_[i];
        const __m256i p0 = x3;
        const __m256i p1 = _mm256_xor_si256(
            _mm256_sub_epi32(rotr_wide<9>(x0),
                             _mm256_xor_si256(p0, load_key_wide(rk[0]))),
            load_key_wide(rk[1]));
        const __m256i p2 = _mm256_xor_si256(
            _mm256_sub_epi32(rotl_wide<5>(x1),
                             _mm256_xor_si256(p1, load_key_wide(rk[2]))),
            load_key_wide(rk[3]));
        const __m256i p3 = _mm256_xor_si256(
            _mm256_sub_epi32(rotl_wide<3>(x2),
                             _mm256_xor_si256(p2, load_key_wide(rk[4]))),
            load_key_wide(rk[5]));
        x0 = p0;
        x1 = p1;
        x2 = p2;
        x3 = p3;
      }
    }
  }

  /**
   * @brief Transforms eight blocks
   *
   * @tparam _Encrypt true to encrypt, false to decrypt
   */
  template <bool _Encrypt>
  CTL_TARGET_AVX2 void eight(const uint8_t *input, uint8_t *output) const {
    __m256i a = load_pair(input + 0 * block_size);
    __m256i b = load_pair(input + 1 * block_size);
    __m256i c = load_pair(input + 2 * block_size);
    __m256i d = load_pair(input + 3 * block_size);

    transpose_wide(a, b, c, d);
    rounds_wide<_Encrypt>(a, b, c, d);
    transpose_wide(a, b, c, d);

    store_pair(a, output + 0 * block_size);
    store_pair(b, output + 1 * block_size);
    store_pair(c, output + 2 * block_size);
    store_pair(d, output + 3 * block_size);
  }

  /**
   * @brief Transforms eight blocks, combining them with a second buffer
   *
   * @tparam _Encrypt true to encrypt, false to decrypt
   * @tparam _MaskInput true to combine on the way in as well
   */
  template <bool _Encrypt, bool _MaskInput>
  CTL_TARGET_AVX2 void eight_combined(const uint8_t *input, const uint8_t *mask,
                                      uint8_t *output) const {
    __m256i a = load_pair(input + 0 * block_size);
    __m256i b = load_pair(input + 1 * block_size);
    __m256i c = load_pair(input + 2 * block_size);
    __m256i d = load_pair(input + 3 * block_size);

    const __m256i m0 = load_pair(mask + 0 * block_size);
    const __m256i m1 = load_pair(mask + 1 * block_size);
    const __m256i m2 = load_pair(mask + 2 * block_size);
    const __m256i m3 = load_pair(mask + 3 * block_size);

    if constexpr (_MaskInput) {
      a = _mm256_xor_si256(a, m0);
      b = _mm256_xor_si256(b, m1);
      c = _mm256_xor_si256(c, m2);
      d = _mm256_xor_si256(d, m3);
    }

    transpose_wide(a, b, c, d);
    rounds_wide<_Encrypt>(a, b, c, d);
    transpose_wide(a, b, c, d);

    store_pair(_mm256_xor_si256(a, m0), output + 0 * block_size);
    store_pair(_mm256_xor_si256(b, m1), output + 1 * block_size);
    store_pair(_mm256_xor_si256(c, m2), output + 2 * block_size);
    store_pair(_mm256_xor_si256(d, m3), output + 3 * block_size);
  }
#endif

  /**
   * @brief Transforms one block with a mask applied on both sides
   *
   * @tparam _Encrypt true to encrypt, false to decrypt
   */
  template <bool _Encrypt>
  void block_masked(const uint8_t *input, const uint8_t *mask,
                    uint8_t *output) const {
    uint8_t buffer[block_size];
    ctl::detail::xor_block<block_size>(input, mask, buffer);
    if constexpr (_Encrypt)
      encrypt_block(buffer, buffer);
    else
      decrypt_block(buffer, buffer);
    ctl::detail::xor_block<block_size>(buffer, mask, output);
  }

  /**
   * @brief The round keys, six words for each round
   */
  uint32_t rk_[rounds][round_key_words];

#if defined(CTL_HAS_X86_HW_ACCEL)
  /**
   * @brief Whether the vector path is used, decided once when the key is set
   */
  bool vector_;

  /**
   * @brief Whether the wide vector path is used, decided at the same time
   */
  bool wide_;

  /**
   * @brief The same round keys with each word repeated across the lanes
   *
   * Held as words rather than as vectors so that the object needs no more
   * alignment than any other, and read back with an unaligned load, which costs
   * nothing on the processors this runs on.
   *
   * Enough copies for the wide path. The narrow one reads the first half of
   * each, which holds the same value four times over, so one table serves both.
   */
  uint32_t rkv_[rounds][round_key_words][wide_blocks];
#endif
};

