/**
 * @file xts
 * @author jung-kwang lee (ntoskrnl7@gmail.com)
 * @brief XTS mode of operation (IEEE Std 1619 / NIST SP 800-38E)
 *
 * A mode intended for storage encryption. A different tweak is applied to each
 * data unit, such as a sector, so the same plaintext becomes different
 * ciphertext at a different position, and ciphertext stealing preserves the
 * length even when it is not a multiple of the block size.
 *
 * Two block cipher keys are supplied separately. K1 encrypts the data and K2
 * encrypts the tweak. They must be generated or established independently.
 *
 * Two places are easy to get wrong and are called out explicitly.
 *
 * 1. The bit order of the tweak multiplication. XTS treats the sixteen bytes as
 *    little endian, shifts left by one bit, and exclusive ors 0x87 into byte 0
 *    when a bit is carried out. GCM uses the same irreducible polynomial but
 *    the opposite convention, a right shift with 0xE1, so code from one must
 *    not be mixed with the other.
 *
 * 2. The encoding of the data unit number. The specification defines it as an
 *    integer and requires it to be converted to a little endian byte string.
 *    The test values in the IEEE appendix print the already converted byte
 *    string, so reading them back as an integer does not line up.
 *
 * This mode measures about two percent below the pointer and length interface it
 * replaced, over both 512 and 4096 byte data units, where every other mode is
 * level with it or ahead. Four things were done to find out why, and what they
 * found is that the two percent is not in the code that runs.
 *
 * Which change it appeared at: the first one, where the entry points started
 * taking views. Not the batch rework after it. ECB moved by the same amount at
 * the same commit and CBC did not, though CBC takes the same two views, so it
 * tracks throughput rather than argument shape.
 *
 * What the generated code does: the batch loop is the same. Both versions call
 * out to the cipher, with three pointers where there used to be three pointers
 * and a count. There is one real difference: the compiler used to inline
 * encrypt_block into the helper below and now does not, so the single block path
 * costs a call. That path runs zero times at either size measured, since 512 and
 * 4096 bytes are both whole numbers of batches with nothing left over.
 *
 * Whether forcing that back changes anything: it moves 512 byte units from two
 * percent behind to half a percent behind and takes CTR from one and a half
 * percent ahead to level. Trading one mode against another without touching the
 * code that runs is what layout does, not what a cost does.
 *
 * How far layout alone reaches: putting dead code in front of an otherwise
 * identical benchmark moves this mode by one percent and ECB by half a percent.
 *
 * So it is where the code lands. Left as measured rather than given a cause.
 *
 * Whoever looks at this next: measure with a standalone benchmark, not one
 * linked into the test binary. That was tried and moved unrelated modes by three
 * percent, which is more than the thing being looked for.
 *
 * @version 0.1
 *
 * @copyright Copyright (c) 2022 C++ Cryptographics template library Authors
 *
 */
#pragma once

#include <cstddef>
#include <cstdint>
#include <cstring>
#include <stdexcept>

#include <ext/result>

#include <ctl/bytes>
#include <ctl/detail/endian>
#include <ctl/detail/memory>

namespace ctl {
namespace symmetric {
namespace mode {

/**
 * @brief XTS mode of operation
 *
 * @tparam _Cipher a block cipher, which must have a 128 bit block
 */
template <class _Cipher> class xts {
public:
  /**
   * @brief The block cipher type
   */
  typedef _Cipher cipher_type;

  /**
   * @brief Block size in bytes
   */
  static constexpr size_t block_size = cipher_type::block_size;

  static_assert(block_size == 16,
                "XTS is defined only for 128 bit block ciphers. "
                "(IEEE Std 1619)");

  /**
   * @brief Size of each XTS component key in bytes
   */
  static constexpr size_t component_key_size = cipher_type::key_size;

  /**
   * @brief Tweak size in bytes
   */
  static constexpr size_t tweak_size = block_size;

  /**
   * @brief Maximum number of blocks in one data unit
   *
   * NIST SP 800-38E limits a data unit to 2^20 blocks.
   */
  static constexpr size_t max_blocks = 1u << 20;

  /**
   * @brief Number of blocks processed in one batch
   */
  static constexpr size_t batch_blocks = cipher_type::preferred_batch;

  /**
   * @brief One batch in bytes
   */
  static constexpr size_t batch_bytes = cipher_type::batch_bytes;

  /**
   * @brief Tweak type, for declaring storage for one
   */
  typedef uint8_t tweak_t[tweak_size];

  /**
   * @brief Storage for one XTS component key
   */
  typedef uint8_t component_key_t[component_key_size];

  /**
   * @brief One XTS component key handed over for reading
   */
  typedef ctl::fixed_bytes<component_key_size> component_key_view;

  /**
   * @brief A tweak handed over for reading
   */
  typedef ctl::fixed_bytes<tweak_size> tweak_view;

  /**
   * @brief Data unit number type
   */
  typedef uint64_t sequence_number_t;

  enum error_status {
    /**
     * @brief The data unit is smaller than one block
     *
     * Ciphertext stealing needs a block to steal from, so XTS requires at
     * least one block.
     */
    data_unit_too_short,

    /**
     * @brief The data unit exceeds max_blocks
     */
    data_unit_too_long,
  };

  /**
   * @brief Initializes with independently generated component keys
   *
   * The length of each key is part of component_key_view, so neither can be
   * silently truncated or read past its end. FIPS 140-3 Implementation
   * Guidance C.I requires K1 and K2 to be generated or established
   * independently and requires an explicit check that their values differ.
   * The check here enforces the latter; how the keys were produced remains the
   * caller's responsibility.
   *
   * @param data_key K1, which encrypts the data
   * @param tweak_key K2, which encrypts the tweak
   * @exception std::invalid_argument if either key is not component_key_size
   * bytes, or if the two keys have the same value
   */
  explicit xts(component_key_view data_key, component_key_view tweak_key)
      : data_cipher_(typename cipher_type::key_view(data_key.data())),
        tweak_cipher_(typename cipher_type::key_view(tweak_key.data())) {
    // Checked after the two ciphers are built rather than before, so that
    // throwing here still runs their destructors and the round keys already
    // derived from the rejected component keys are erased.
    if (ctl::detail::equal_constant_time(data_key.data(), tweak_key.data(),
                                        component_key_size))
      throw std::invalid_argument(
          "ctl::symmetric::mode::xts : K1 and K2 have the same value. The "
          "component keys have to be generated or established independently "
          "and XTS explicitly forbids equal values.");
  }

  /**
   * @brief Encrypts a data unit
   *
   * @param tweak the 128 bit tweak, i in the specification
   * @param input the data to encrypt, at least block_size bytes
   * @param output where the ciphertext goes, at least as long as input and may
   * be exactly the same buffer; any other overlap is refused
   * @exception std::invalid_argument if output is shorter than input, or if
   * input and output partially overlap
   */
  [[nodiscard]] ext::void_result<error_status>
  encrypt(tweak_view tweak, ctl::bytes input,
          ctl::writable_bytes output) const {
    error_status status;
    const size_t size = input.size();
    if (size_error(size, status))
      return ext::err(status);
    ctl::detail::require_capacity("ctl::symmetric::mode::xts::encrypt",
                                  "output", output.size(), size);
    ctl::detail::require_exact_or_disjoint(
        "ctl::symmetric::mode::xts::encrypt", input.data(), size,
        output.data(), output.data(), size);

    uint8_t encrypted_tweak[block_size];
    tweak_cipher_.encrypt_block(tweak, encrypted_tweak);
    tweak_state t = load_tweak(encrypted_tweak);
    ctl::detail::secure_zero(encrypted_tweak, sizeof(encrypted_tweak));

    const size_t remainder = size % block_size;
    // When ciphertext stealing is needed, the last whole block is handled
    // separately.
    const size_t whole = remainder == 0 ? size / block_size
                                        : size / block_size - 1;

    transform_blocks<true>(input.data(), whole, t, output.data());

    if (remainder != 0) {
      const size_t last = whole * block_size;

      // The last whole block is encrypted with the current tweak. The front of
      // that result becomes the ciphertext of the partial block, and the back
      // is used to fill out the partial plaintext.
      uint8_t stolen[block_size];
      transform<true>(input.data() + last, t, stolen);
      advance(t);

      // All of the input is read before any output is written, which is what
      // makes operating in place safe.
      uint8_t combined[block_size];
      memcpy(combined, input.data() + last + block_size, remainder);
      memcpy(combined + remainder, stolen + remainder, block_size - remainder);

      transform<true>(combined, t, output.data() + last);
      memcpy(output.data() + last + block_size, stolen, remainder);

      ctl::detail::secure_zero(stolen, sizeof(stolen));
      ctl::detail::secure_zero(combined, sizeof(combined));
    }

    ctl::detail::secure_zero(&t, sizeof(t));
    return ext::ok<void>();
  }

  /**
   * @brief Decrypts a data unit
   *
   * @param tweak the 128 bit tweak, i in the specification
   * @param input the data to decrypt, at least block_size bytes
   * @param output where the plaintext goes, at least as long as input and may
   * be exactly the same buffer; any other overlap is refused
   * @exception std::invalid_argument if output is shorter than input, or if
   * input and output partially overlap
   */
  [[nodiscard]] ext::void_result<error_status>
  decrypt(tweak_view tweak, ctl::bytes input,
          ctl::writable_bytes output) const {
    error_status status;
    const size_t size = input.size();
    if (size_error(size, status))
      return ext::err(status);
    ctl::detail::require_capacity("ctl::symmetric::mode::xts::decrypt",
                                  "output", output.size(), size);
    ctl::detail::require_exact_or_disjoint(
        "ctl::symmetric::mode::xts::decrypt", input.data(), size,
        output.data(), output.data(), size);

    uint8_t encrypted_tweak[block_size];
    tweak_cipher_.encrypt_block(tweak, encrypted_tweak);
    tweak_state t = load_tweak(encrypted_tweak);
    ctl::detail::secure_zero(encrypted_tweak, sizeof(encrypted_tweak));

    const size_t remainder = size % block_size;
    const size_t whole = remainder == 0 ? size / block_size
                                        : size / block_size - 1;

    transform_blocks<false>(input.data(), whole, t, output.data());

    if (remainder != 0) {
      const size_t last = whole * block_size;

      // During encryption the last whole block was produced with the next
      // tweak along, so decryption has to use that same tweak.
      tweak_state next = t;
      advance(next);

      uint8_t stolen[block_size];
      transform<false>(input.data() + last, next, stolen);

      uint8_t combined[block_size];
      memcpy(combined, input.data() + last + block_size, remainder);
      memcpy(combined + remainder, stolen + remainder, block_size - remainder);

      transform<false>(combined, t, output.data() + last);
      memcpy(output.data() + last + block_size, stolen, remainder);

      ctl::detail::secure_zero(&next, sizeof(next));
      ctl::detail::secure_zero(stolen, sizeof(stolen));
      ctl::detail::secure_zero(combined, sizeof(combined));
    }

    ctl::detail::secure_zero(&t, sizeof(t));
    return ext::ok<void>();
  }

  /**
   * @brief Encrypts using a data unit number
   *
   * @param sequence_number data unit number, such as a sector number
   * @param input the data to encrypt, at least block_size bytes
   * @param output where the ciphertext goes, at least as long as input and may
   * be the same buffer
   */
  [[nodiscard]] ext::void_result<error_status>
  encrypt(sequence_number_t sequence_number, ctl::bytes input,
          ctl::writable_bytes output) const {
    tweak_t tweak;
    make_tweak(sequence_number, tweak);
    return encrypt(tweak, input, output);
  }

  /**
   * @brief Decrypts using a data unit number
   *
   * @param sequence_number data unit number, such as a sector number
   * @param input the data to decrypt, at least block_size bytes
   * @param output where the plaintext goes, at least as long as input and may
   * be the same buffer
   */
  [[nodiscard]] ext::void_result<error_status>
  decrypt(sequence_number_t sequence_number, ctl::bytes input,
          ctl::writable_bytes output) const {
    tweak_t tweak;
    make_tweak(sequence_number, tweak);
    return decrypt(tweak, input, output);
  }

  /**
   * @brief Converts a data unit number into a tweak
   *
   * The specification defines the number as being converted to a little endian
   * byte string.
   *
   * @param sequence_number data unit number
   * @param tweak the resulting tweak
   */
  static void make_tweak(sequence_number_t sequence_number, tweak_t &tweak) {
    memset(&tweak[0], 0, tweak_size);
    ctl::detail::store_le64(sequence_number, &tweak[0]);
  }

private:
  /**
   * @brief A tweak held as two 64 bit halves rather than as bytes
   *
   * The tweaks of consecutive blocks form a serial chain, since each one is the
   * previous one multiplied by alpha. Keeping the value in a byte array means
   * every step of that chain stores and then reloads it, and the latency of
   * that round trip lands directly on the critical path. Holding the two halves
   * as values lets the whole chain stay in registers.
   */
  struct tweak_state {
    /**
     * @brief The low half, that is the first eight bytes
     */
    uint64_t low;

    /**
     * @brief The high half, that is the last eight bytes
     */
    uint64_t high;
  };

  /**
   * @brief Reads a tweak from a byte string
   */
  static tweak_state load_tweak(const uint8_t *value) {
    tweak_state t;
    t.low = ctl::detail::load_le64(value);
    t.high = ctl::detail::load_le64(value + 8);
    return t;
  }

  /**
   * @brief Writes a tweak out as a byte string
   */
  static void store_tweak(const tweak_state &t, uint8_t *value) {
    ctl::detail::store_le64(t.low, value);
    ctl::detail::store_le64(t.high, value + 8);
  }

  /**
   * @brief Multiplies the tweak by the primitive element alpha
   *
   * The irreducible polynomial of GF(2^128) is x^128 + x^7 + x^2 + x + 1, and
   * XTS interprets the byte string as little endian, which makes this a shift
   * left by one bit with 0x87 folded into the lowest byte when a bit is carried
   * out.
   *
   * A mask is used rather than a branch when folding 0x87 back in, so the
   * running time does not depend on the value of the tweak, which is derived
   * from the key.
   *
   * @param t the tweak, advanced in place
   */
  static void advance(tweak_state &t) {
    const uint64_t low = t.low;
    const uint64_t carry = t.high >> 63;
    t.high = (t.high << 1) | (low >> 63);
    t.low = (low << 1) ^ (0x87ull & (0ull - carry));
  }

  /**
   * @brief Checks the data unit size
   *
   * This does not return a void_result on purpose. ext::void_result default
   * constructs its internal err member even on the success path, and building
   * that costs a heap allocation, so producing one just for a check would mean
   * two allocations per call. Only the error condition is passed out, and the
   * result object is built once.
   *
   * @param size data unit size
   * @param status set to the error code when there is an error
   * @return true if there is an error
   */
  static bool size_error(size_t size, error_status &status) {
    if (size < block_size) {
      status = data_unit_too_short;
      return true;
    }
    if ((size + block_size - 1) / block_size > max_blocks) {
      status = data_unit_too_long;
      return true;
    }
    return false;
  }

  /**
   * @brief Processes a stretch of whole blocks
   *
   * Every block has a different tweak, so handing several over at once takes
   * some preparation. Once the tweaks have been built and applied to the input,
   * the block cipher calls are mutually independent and can be interleaved on a
   * hardware path. The tweaks themselves form a serial chain through the alpha
   * multiplication, but that is only a handful of operations and does not
   * become the bottleneck.
   *
   * Takes pointers rather than views, unlike everything a caller can reach.
   * Whether the range is there was settled by the entry point that got here,
   * and count comes from the same length that was checked, so a view would only
   * carry a length that is already known to be right. That is not free: a
   * pointer and a length together do not fit in a register on this platform, and
   * this runs once per data unit, which for 512 byte sectors is often.
   *
   * @tparam _Encrypt true to encrypt, false to decrypt
   * @param input the data unit, of which the leading count blocks are processed
   * @param count number of blocks to process, which is fewer than the data unit
   * holds when ciphertext stealing handles the end
   * @param t the current tweak, advanced by count steps on return
   * @param output output, may be the same buffer as input
   */
  template <bool _Encrypt>
  void transform_blocks(const uint8_t *input, size_t count, tweak_state &t,
                        uint8_t *output) const {
    uint8_t tweaks[batch_bytes];

    size_t j = 0;
    while (data_cipher_.prefers_batching() && j + batch_blocks <= count) {
      // The chain of alpha multiplications runs entirely in registers here;
      // only the resulting tweak of each block is written out, since that is
      // what the cipher needs as the mask.
      for (size_t b = 0; b < batch_blocks; ++b) {
        store_tweak(t, tweaks + b * block_size);
        advance(t);
      }

      // Handing the masks to the cipher rather than applying them here keeps
      // the masked values in registers. Doing it separately would mean writing
      // the masked input to a buffer, letting the cipher read and write that
      // buffer, and reading it back to unmask.
      // The loop condition puts this batch inside the range the entry point
      // checked, so the length these name is known to be there and the views
      // are built from the pointers directly.
      typedef typename cipher_type::batch_view batch_in;
      typedef typename cipher_type::writable_batch_view batch_out;
      const size_t at = j * block_size;
      if constexpr (_Encrypt)
        data_cipher_.encrypt_batch_masked(batch_in(input + at), tweaks,
                                         batch_out(output + at));
      else
        data_cipher_.decrypt_batch_masked(batch_in(input + at), tweaks,
                                         batch_out(output + at));
      j += batch_blocks;
    }

    // Blocks left over that do not fill a batch
    for (; j < count; ++j) {
      transform<_Encrypt>(input + j * block_size, t, output + j * block_size);
      advance(t);
    }

    ctl::detail::secure_zero(tweaks, sizeof(tweaks));
  }

  /**
   * @brief Transforms one block with a tweak applied
   *
   * Encryption is C = E_K1(P ^ T) ^ T and decryption is P = D_K1(C ^ T) ^ T.
   *
   * @tparam _Encrypt true to encrypt, false to decrypt
   */
  template <bool _Encrypt>
  void transform(const uint8_t *input, const tweak_state &t,
                 uint8_t *output) const {
    uint8_t mask[block_size];
    store_tweak(t, mask);
    uint8_t buffer[block_size];
    ctl::detail::xor_block<block_size>(input, mask, buffer);
    if constexpr (_Encrypt)
      data_cipher_.encrypt_block(buffer, buffer);
    else
      data_cipher_.decrypt_block(buffer, buffer);
    ctl::detail::xor_block<block_size>(buffer, mask, output);
    // buffer is deliberately not erased. What it holds is derived from the
    // plaintext or ciphertext the caller already has, so erasing it gains
    // nothing, and a volatile write per block would only cost throughput. Key
    // material is managed by the block cipher and by the tweak handling.
  }

  /**
   * @brief The block cipher that encrypts the data, keyed with K1
   */
  cipher_type data_cipher_;

  /**
   * @brief The block cipher that encrypts the tweak, keyed with K2
   */
  cipher_type tweak_cipher_;
};

