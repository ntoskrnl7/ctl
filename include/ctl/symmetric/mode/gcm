/**
 * @file gcm
 * @author jung-kwang lee (ntoskrnl7@gmail.com)
 * @brief GCM mode of operation (NIST SP 800-38D)
 *
 * Authenticated encryption with associated data. Unlike the other modes here,
 * GCM takes two inputs and produces two outputs: data that is encrypted and
 * authenticated, and additional authenticated data (AAD) that is authenticated
 * but left in the clear, both covered by one authentication tag.
 *
 * AAD is for information a recipient or an intermediate system has to read
 * without being able to forge, such as a record header, a sequence number, or
 * the row identifier a ciphertext belongs to. Tampering with it makes tag
 * verification fail, which binds the ciphertext to its context.
 *
 * An initialization vector belongs to one encryption under one key. Reusing
 * the same IV with that key for distinct inputs breaks both confidentiality and
 * the assurance the tag is meant to provide. This object deliberately keeps no
 * registry of IVs: uniqueness has to hold across processes, restarts and
 * devices, so the caller has to arrange it at that scope (SP 800-38D section 8).
 *
 * The order in which GHASH consumes its inputs is fixed by the specification:
 * all of the AAD first, zero padded to a block boundary, then all of the
 * ciphertext, then the two lengths. AAD therefore cannot be supplied after
 * encryption has begun. The interface reflects that rather than trying to hide
 * it.
 *
 * @version 0.1
 *
 * @copyright Copyright (c) 2022 C++ Cryptographics template library Authors
 *
 */
#pragma once

#include <cstddef>
#include <cstdint>
#include <cstring>
#include <initializer_list>
#include <stdexcept>
#include <utility>

#include <ext/result>

#include <ctl/bytes>
#include <ctl/detail/endian>
#include <ctl/detail/ghash>
#include <ctl/detail/memory>

namespace ctl {
namespace symmetric {
namespace mode {

/**
 * @brief GCM mode of operation
 *
 * @tparam _Cipher a block cipher, which must have a 128 bit block
 * @tparam _TagBits authentication tag size in bits
 */
template <class _Cipher, size_t _TagBits = 128> class gcm {
public:
  /**
   * @brief The block cipher type
   */
  typedef _Cipher cipher_type;

  /**
   * @brief Block size in bytes
   */
  static constexpr size_t block_size = cipher_type::block_size;

  static_assert(block_size == 16,
                "GCM is defined only for 128 bit block ciphers. "
                "(NIST SP 800-38D)");

  static_assert(_TagBits == 128 || _TagBits == 120 || _TagBits == 112 ||
                    _TagBits == 104 || _TagBits == 96,
                "GCM allows tag sizes of 128, 120, 112, 104 and 96 bits. "
                "Shorter tags are restricted to specific applications; see "
                "appendix C of NIST SP 800-38D.");

  /**
   * @brief Authentication tag size in bytes
   */
  static constexpr size_t tag_size = _TagBits / 8;

  /**
   * @brief Key size in bytes
   */
  static constexpr size_t key_size = cipher_type::key_size;

  /**
   * @brief The recommended initialization vector size in bytes
   *
   * Any length is allowed, but 96 bits is the one the specification recommends
   * and the only one that skips deriving the initial counter through GHASH.
   */
  static constexpr size_t recommended_iv_size = 12;

  /**
   * @brief The largest amount of data one invocation may cover, in bytes
   *
   * SP 800-38D limits the plaintext of a single invocation to 2^39 - 256 bits.
   */
  static constexpr uint64_t max_data_size = ((1ull << 39) - 256) / 8;

  /**
   * @brief Number of key stream blocks produced in one batch
   */
  static constexpr size_t batch_blocks = cipher_type::preferred_batch;

  /**
   * @brief One batch in bytes
   */
  static constexpr size_t batch_bytes = cipher_type::batch_bytes;

  /**
   * @brief Authentication tag type, for declaring storage for one
   */
  typedef uint8_t tag_t[tag_size];

  /**
   * @brief A key handed over for reading
   */
  typedef ctl::fixed_bytes<key_size> key_view;

  /**
   * @brief A tag handed over for reading, to be verified against
   */
  typedef ctl::fixed_bytes<tag_size> tag_view;

  /**
   * @brief A tag handed over to be written
   */
  typedef ctl::writable_fixed_bytes<tag_size> writable_tag_view;

  /**
   * @brief One contiguous run of bytes
   *
   * AAD and data are each supplied as a list of these. GHASH consumes the
   * concatenation of the list, so where the boundaries fall does not matter but
   * the order of the list does: {a, b} and {b, a} produce different tags.
   */
  typedef ctl::bytes piece;

  /**
   * @brief A list of runs of bytes
   */
  typedef std::initializer_list<piece> pieces;

  enum error_status {
    /**
     * @brief The tag did not match, so the data is not authentic
     *
     * The output buffer has been erased. Nothing that was written to it may be
     * used.
     */
    authentication_failed,

    /**
     * @brief The initialization vector was empty
     */
    invalid_iv_length,

    /**
     * @brief The data exceeds what one invocation may cover
     */
    invalid_input_length,
  };

  /**
   * @brief Initializes with a key
   *
   * @param key the key, key_size bytes
   * @exception std::invalid_argument if the key is not key_size bytes
   */
  explicit gcm(key_view key) : cipher_(key) {
    // The hash subkey, and everything GHASH derives from it, depends only on
    // the key. Preparing it once here and copying that state into each
    // invocation keeps the cost off the per message path, which matters most
    // for short messages.
    uint8_t zero[block_size];
    uint8_t subkey[block_size];
    memset(zero, 0, sizeof(zero));
    cipher_.encrypt_block(zero, subkey);
    hash_.set_key(subkey);
    ctl::detail::secure_zero(subkey, sizeof(subkey));
  }

  /**
   * @brief Encrypts and authenticates
   *
   * @param iv initialization vector, any non zero length; 12 bytes recommended;
   * must not have been used for another encryption under this key
   * @param aad additional authenticated data, may be empty
   * @param plain data to encrypt, may be empty
   * @param output where the ciphertext goes, at least as long as the total of
   * plain; it may be exactly in place, but any other overlap is refused
   * @param tag where the tag goes, tag_size bytes; the last tag_size bytes of a
   * buffer that also holds the ciphertext appends it there, which is the layout
   * a wire format usually wants; it must not overlap the data output
   * @exception std::invalid_argument if output cannot hold the ciphertext, or
   * if an input piece partially overlaps the output, or if the tag overlaps
   * the data output
   */
  [[nodiscard]] ext::void_result<error_status>
  encrypt(ctl::bytes iv, pieces aad, pieces plain, ctl::writable_bytes output,
          writable_tag_view tag) const {
    if (iv.empty())
      return ext::err(invalid_iv_length);
    const uint64_t data_size = total(plain);
    if (data_size > max_data_size)
      return ext::err(invalid_input_length);
    ctl::detail::require_capacity("ctl::symmetric::mode::gcm::encrypt",
                                  "output", output.size(),
                                  static_cast<size_t>(data_size));
    require_piece_layout("ctl::symmetric::mode::gcm::encrypt", plain, output,
                         static_cast<size_t>(data_size));
    ctl::detail::require_disjoint(
        "ctl::symmetric::mode::gcm::encrypt", "output", output.data(),
        static_cast<size_t>(data_size), "tag", tag.data(), tag_size);

    session state(cipher_, hash_, iv);
    for (const piece &p : aad)
      state.absorb_aad(p.data(), p.size());

    size_t offset = 0;
    for (const piece &p : plain) {
      state.encrypt(p.data(), p.size(), output.data() + offset);
      offset += p.size();
    }

    state.finish(tag.data());
    return ext::ok<void>();
  }

  /**
   * @brief Verifies and decrypts
   *
   * The plaintext is produced into the output buffer as the ciphertext is read,
   * and if the tag does not match, the output buffer is erased before the error
   * is returned. A caller that ignores the return value is therefore left with
   * zeroes rather than unauthenticated plaintext.
   *
   * @param iv initialization vector, the same one used to encrypt
   * @param aad additional authenticated data, in the same order as when
   * encrypting
   * @param cipher ciphertext to decrypt
   * @param output where the plaintext goes, at least as long as the total of
   * cipher; it may be exactly in place, but any other overlap is refused
   * @param tag the tag to verify against, tag_size bytes
   * @exception std::invalid_argument if output cannot hold the plaintext, or
   * if an input piece partially overlaps the output, or if the tag overlaps
   * the data output
   */
  [[nodiscard]] ext::void_result<error_status>
  decrypt(ctl::bytes iv, pieces aad, pieces cipher, ctl::writable_bytes output,
          tag_view tag) const {
    if (iv.empty())
      return ext::err(invalid_iv_length);
    const uint64_t total_size = total(cipher);
    if (total_size > max_data_size)
      return ext::err(invalid_input_length);
    const size_t data_size = static_cast<size_t>(total_size);
    ctl::detail::require_capacity("ctl::symmetric::mode::gcm::decrypt",
                                  "output", output.size(), data_size);
    require_piece_layout("ctl::symmetric::mode::gcm::decrypt", cipher, output,
                         data_size);
    ctl::detail::require_disjoint(
        "ctl::symmetric::mode::gcm::decrypt", "output", output.data(),
        data_size, "tag", tag.data(), tag_size);

    session state(cipher_, hash_, iv);
    for (const piece &p : aad)
      state.absorb_aad(p.data(), p.size());

    size_t offset = 0;
    for (const piece &p : cipher) {
      state.decrypt(p.data(), p.size(), output.data() + offset);
      offset += p.size();
    }

    const ext::void_result<error_status> result = verify(state, tag);
    if (!result) {
      // Unlike the incremental interface, this one knows the whole output range
      // and can make sure nothing unauthenticated is left where a caller who
      // ignores the error could reach it.
      ctl::detail::secure_zero(output.data(), data_size);
    }
    return result;
  }

private:
  /**
   * @brief The running state of one GCM invocation
   *
   * Everything that has to survive between pieces lives here: the GHASH
   * accumulator, the counter, and whatever is left of the current key stream
   * block. Keeping it in one place is what lets a list of pieces of any length
   * be handled, and is what an incremental interface would be built on.
   */
  class session {
  public:
    session(const cipher_type &cipher, const ctl::detail::ghash &prepared,
            ctl::bytes iv)
        : cipher_(cipher), hash_(prepared), aad_bits_(0), data_bits_(0),
          keystream_used_(block_size), aad_closed_(false), active_(true) {
      derive_initial_counter(iv);
      memcpy(counter_, initial_, block_size);
      // The tag is masked with the block cipher applied to the initial counter,
      // before that counter is ever incremented.
      cipher_.encrypt_block(initial_, tag_mask_);
    }

    session(const session &) = delete;
    session &operator=(const session &) = delete;

    /**
     * @brief Transfers one invocation without leaving a usable clone behind
     *
     * Moving is how the AAD phase becomes a data phase. The source is erased
     * and marked inactive, so retaining the old phase object cannot fork one
     * IV and key stream into two encryptions.
     */
    session(session &&other) noexcept
        : cipher_(other.cipher_), hash_(other.hash_),
          aad_bits_(other.aad_bits_), data_bits_(other.data_bits_),
          keystream_used_(other.keystream_used_),
          aad_closed_(other.aad_closed_), active_(other.active_) {
      memcpy(initial_, other.initial_, sizeof(initial_));
      memcpy(counter_, other.counter_, sizeof(counter_));
      memcpy(keystream_, other.keystream_, sizeof(keystream_));
      memcpy(tag_mask_, other.tag_mask_, sizeof(tag_mask_));
      other.erase();
    }

    session &operator=(session &&) = delete;

    ~session() { erase(); }

    /**
     * @brief Refuses use after a phase transition, move or finish
     */
    void require_active(const char *where) const {
      if (!active_)
        throw std::logic_error(std::string(where) +
                               " : this GCM invocation has already moved to "
                               "another phase or been finished.");
    }

    /**
     * @brief Erases all keyed state held by this invocation
     */
    void erase() {
      ctl::detail::secure_zero(initial_, sizeof(initial_));
      ctl::detail::secure_zero(counter_, sizeof(counter_));
      ctl::detail::secure_zero(keystream_, sizeof(keystream_));
      ctl::detail::secure_zero(tag_mask_, sizeof(tag_mask_));
      hash_.erase();
      aad_bits_ = 0;
      data_bits_ = 0;
      keystream_used_ = block_size;
      aad_closed_ = true;
      active_ = false;
    }

    /**
     * @brief Absorbs additional authenticated data
     */
    void absorb_aad(const uint8_t *data, size_t size) {
      require_active("ctl::symmetric::mode::gcm::aad");
      hash_.update(data, size);
      aad_bits_ += static_cast<uint64_t>(size) * 8;
    }

    /**
     * @brief Encrypts and absorbs the resulting ciphertext
     */
    void encrypt(const uint8_t *input, size_t size, uint8_t *output) {
      require_active("ctl::symmetric::mode::gcm::encrypt_data::write");
      close_aad();
      require_within_limit(size);
      apply_keystream(input, size, output);
      hash_.update(output, size);
      data_bits_ += static_cast<uint64_t>(size) * 8;
    }

    /**
     * @brief Absorbs the ciphertext and decrypts it
     *
     * The ciphertext is absorbed first, because the output may be the same
     * buffer as the input.
     */
    void decrypt(const uint8_t *input, size_t size, uint8_t *output) {
      require_active("ctl::symmetric::mode::gcm::decrypt_data::write");
      close_aad();
      require_within_limit(size);
      hash_.update(input, size);
      data_bits_ += static_cast<uint64_t>(size) * 8;
      apply_keystream(input, size, output);
    }

    /**
     * @brief Completes the hash and produces the tag
     */
    void finish(uint8_t *tag) {
      require_active("ctl::symmetric::mode::gcm::finish");
      close_aad();
      hash_.pad();

      uint8_t lengths[block_size];
      ctl::detail::store_be64(aad_bits_, lengths);
      ctl::detail::store_be64(data_bits_, lengths + 8);
      hash_.update(lengths, block_size);

      uint8_t sum[block_size];
      hash_.finish(sum);
      ctl::detail::xor_block<block_size>(sum, tag_mask_, sum);
      memcpy(tag, sum, tag_size);
      ctl::detail::secure_zero(sum, sizeof(sum));
      erase();
    }

  private:
    /**
     * @brief Refuses to carry an invocation past what one key stream covers
     *
     * The counter of GCM is only the last four bytes of the block, so after
     * 2^32 blocks it wraps and the key stream repeats from the beginning. The
     * limit in SP 800-38D stops short of that. Reusing key stream within one
     * invocation exposes the exclusive or of two plaintexts, so this cannot be
     * left to the caller to remember.
     *
     * The single call interface knows the whole length in advance and reports
     * this through its result. Nothing accumulates across calls there, so this
     * is what covers the incremental interface, where the length only becomes
     * known as the data arrives and a method that returns the builder for
     * chaining has no result to report through.
     *
     * @param size length about to be added
     * @exception std::length_error if the invocation would pass the limit
     */
    void require_within_limit(size_t size) const {
      // data_bits_ never passes the limit, since this runs before every
      // addition, so the subtraction cannot wrap.
      const uint64_t remaining = max_data_size - data_bits_ / 8;
      if (static_cast<uint64_t>(size) > remaining)
        throw std::length_error(
            "ctl::symmetric::mode::gcm : one invocation may cover at most " +
            std::to_string(max_data_size) +
            " bytes, and this would pass that. Start a new invocation with a "
            "fresh initialization vector.");
    }

    /**
     * @brief Closes the AAD, padding it to a block boundary
     *
     * Called on the first data of the invocation and again at the end, so that
     * an invocation with no data at all still pads correctly.
     */
    void close_aad() {
      if (aad_closed_)
        return;
      hash_.pad();
      aad_closed_ = true;
    }

    /**
     * @brief Derives the initial counter block J0
     *
     * A 96 bit initialization vector is used directly with a counter of one
     * appended. Any other length is hashed, which is why the accumulator has to
     * be cleared afterwards before the AAD goes in.
     */
    void derive_initial_counter(ctl::bytes iv) {
      if (iv.size() == recommended_iv_size) {
        memcpy(initial_, iv.data(), recommended_iv_size);
        initial_[12] = 0;
        initial_[13] = 0;
        initial_[14] = 0;
        initial_[15] = 1;
        return;
      }

      uint8_t lengths[block_size];
      memset(lengths, 0, sizeof(lengths));
      ctl::detail::store_be64(static_cast<uint64_t>(iv.size()) * 8,
                              lengths + 8);

      hash_.update(iv.data(), iv.size());
      hash_.pad();
      hash_.update(lengths, block_size);
      hash_.finish(initial_);
      hash_.reset();
    }

    /**
     * @brief Advances the counter
     *
     * Only the last four bytes take part, as a big endian counter that wraps.
     */
    void advance_counter() {
      const uint32_t value = ctl::detail::load_be32(counter_ + 12);
      ctl::detail::store_be32(value + 1, counter_ + 12);
    }

    /**
     * @brief Advances the counter and produces the next key stream block
     */
    void next_keystream() {
      advance_counter();
      cipher_.encrypt_block(counter_, keystream_);
    }

    /**
     * @brief Combines data with the key stream
     *
     * The key stream is continuous across calls, so a piece whose length is not
     * a multiple of the block size leaves the remainder of the current block
     * for the next piece to consume.
     */
    void apply_keystream(const uint8_t *input, size_t size, uint8_t *output) {
      size_t i = 0;

      while (keystream_used_ < block_size && i < size) {
        output[i] = static_cast<uint8_t>(input[i] ^ keystream_[keystream_used_]);
        ++keystream_used_;
        ++i;
      }

      // Key stream blocks are mutually independent, so where the cipher has
      // something to gain from being handed several at once, it is. Doing this
      // a block at a time leaves a cipher with a wide path waiting out its own
      // latency on every block, which is what it was waiting out here before.
      //
      // Only the counters chain, and that is a handful of operations. Reaching
      // this at all means the loop above drained whatever was left of the
      // previous block, so there is none to carry in.
      if (cipher_.prefers_batching() && size - i >= batch_bytes) {
        // The loop condition puts the batch inside the range, so the length
        // these name is known to be there and the views are built from the
        // pointers directly.
        typedef typename cipher_type::batch_view batch_in;
        typedef typename cipher_type::writable_batch_view batch_out;

        uint8_t counters[batch_bytes];
        do {
          for (size_t b = 0; b < batch_blocks; ++b) {
            advance_counter();
            memcpy(counters + b * block_size, counter_, block_size);
          }
          cipher_.encrypt_batch_then_xor(counters, batch_in(input + i),
                                         batch_out(output + i));
          i += batch_bytes;
        } while (size - i >= batch_bytes);
        keystream_used_ = block_size;
        ctl::detail::secure_zero(counters, sizeof(counters));
      }

      while (size - i >= block_size) {
        next_keystream();
        ctl::detail::xor_block<block_size>(input + i, keystream_, output + i);
        keystream_used_ = block_size;
        i += block_size;
      }

      if (i < size) {
        next_keystream();
        keystream_used_ = 0;
        while (i < size) {
          output[i] =
              static_cast<uint8_t>(input[i] ^ keystream_[keystream_used_]);
          ++keystream_used_;
          ++i;
        }
      }
    }

    const cipher_type &cipher_;
    ctl::detail::ghash hash_;

    uint8_t initial_[block_size];
    uint8_t counter_[block_size];
    uint8_t keystream_[block_size];
    uint8_t tag_mask_[block_size];

    uint64_t aad_bits_;
    uint64_t data_bits_;
    size_t keystream_used_;
    bool aad_closed_;
    bool active_;
  };

public:
  /**
   * @brief Encryption in progress, data phase
   *
   * Reached from the AAD phase, and there is deliberately no way back: the
   * specification requires every byte of AAD to be hashed before any
   * ciphertext, so supplying AAD once encryption has begun is not a mistake to
   * be reported at run time but something the type system refuses.
   *
   * Each write checks the two ranges it receives. It cannot see a future
   * input, so the caller must also make sure an output from one write does not
   * overwrite input that will be supplied to another.
   *
   * Created through gcm::encryptor. Must not outlive the gcm it came from.
   */
  class encrypt_data {
  public:
    explicit encrypt_data(session &&state) : state_(std::move(state)) {}

    /**
     * @brief Encrypts one run of data and authenticates the result
     *
     * The key stream carries on between calls, so a run of any length is fine.
     *
     * @param input data to encrypt
     * @param output where the ciphertext goes, at least as long as input; it
     * may begin at the same address for in-place operation, but otherwise must
     * be disjoint
     * @exception std::invalid_argument if output is shorter than input, or if
     * input and output partially overlap
     */
    encrypt_data &write(ctl::bytes input, ctl::writable_bytes output) {
      ctl::detail::require_capacity(
          "ctl::symmetric::mode::gcm::encrypt_data::write", "output",
          output.size(), input.size());
      ctl::detail::require_exact_or_disjoint(
          "ctl::symmetric::mode::gcm::encrypt_data::write", input.data(),
          input.size(), output.data(), output.data(), input.size());
      state_.encrypt(input.data(), input.size(), output.data());
      return *this;
    }

    /**
     * @brief Produces the authentication tag
     *
     * @param tag where the tag goes, tag_size bytes; it must not overlap an
     * earlier output, which this scatter writer no longer retains
     */
    void finish(writable_tag_view tag) { state_.finish(tag.data()); }

  private:
    session state_;
  };

  /**
   * @brief Encryption in progress, data phase, writing into one buffer
   *
   * The same as encrypt_data except that it was told where the ciphertext goes
   * and keeps track of how far it has got. What that removes is a running
   * offset the caller would otherwise have to hold and advance by hand next to
   * every write, which is the same shape of mistake as a length passed beside a
   * pointer: two things that have to agree and nothing making them.
   *
   * Where each run goes somewhere different, which is the other reason to feed
   * a cipher in pieces, encrypt_data is the one to use. Neither type has the
   * other's write, so the two cannot be mixed up.
   *
   * Created through gcm::encryptor, then data with a buffer. Must not outlive
   * the gcm it came from.
   */
  class encrypt_data_into {
  public:
    encrypt_data_into(session &&state, ctl::writable_bytes into)
        : state_(std::move(state)), into_(into), written_(0) {}

    /**
     * @brief Encrypts one run of data into the next part of the buffer
     *
     * @param input data to encrypt
     * @exception std::invalid_argument if what is left of the buffer is
     * shorter than the run, or if input overlaps the held output anywhere
     * other than the position where this run is written
     */
    encrypt_data_into &write(ctl::bytes input) {
      ctl::detail::require_capacity(
          "ctl::symmetric::mode::gcm::encrypt_data_into::write", "output",
          into_.size() - written_, input.size());
      uint8_t *const destination = into_.data() + written_;
      ctl::detail::require_exact_or_disjoint(
          "ctl::symmetric::mode::gcm::encrypt_data_into::write", input.data(),
          input.size(), destination, into_.data(), into_.size());
      state_.encrypt(input.data(), input.size(), destination);
      written_ += input.size();
      return *this;
    }

    /**
     * @brief How much of the buffer has been written
     */
    size_t written() const { return written_; }

    /**
     * @brief Produces the authentication tag
     *
     * @param tag where the tag goes, tag_size bytes; it may be appended after
     * what has been written but must not overlap it
     * @exception std::invalid_argument if the tag overlaps data already written
     */
    void finish(writable_tag_view tag) {
      state_.require_active(
          "ctl::symmetric::mode::gcm::encrypt_data_into::finish");
      ctl::detail::require_disjoint(
          "ctl::symmetric::mode::gcm::encrypt_data_into::finish", "output",
          into_.data(), written_, "tag", tag.data(), tag_size);
      state_.finish(tag.data());
    }

  private:
    session state_;
    ctl::writable_bytes into_;
    size_t written_;
  };

  /**
   * @brief Encryption in progress, additional authenticated data phase
   *
   * Created through gcm::encryptor. Must not outlive the gcm it came from.
   */
  class encrypt_aad {
  public:
    encrypt_aad(const cipher_type &cipher, const ctl::detail::ghash &prepared,
                ctl::bytes iv)
        : state_(cipher, prepared, iv) {}

    /**
     * @brief Authenticates one run of additional data
     *
     * Runs are concatenated, so where they are split makes no difference but
     * the order they are supplied in does.
     */
    encrypt_aad &aad(ctl::bytes data) {
      state_.absorb_aad(data.data(), data.size());
      return *this;
    }

    /**
     * @brief Moves on to the data phase, with each run written where the
     * caller says
     */
    encrypt_data data() {
      state_.require_active("ctl::symmetric::mode::gcm::encrypt_aad::data");
      return encrypt_data(std::move(state_));
    }

    /**
     * @brief Moves on to the data phase, writing into one buffer
     *
     * The writer then holds the buffer and keeps its own place in it, so a run
     * is written by naming only what to encrypt.
     *
     * @param output where all of the ciphertext goes, in order
     */
    encrypt_data_into data(ctl::writable_bytes output) {
      state_.require_active("ctl::symmetric::mode::gcm::encrypt_aad::data");
      return encrypt_data_into(std::move(state_), output);
    }

    /**
     * @brief Produces the tag with no data at all, which is GMAC
     *
     * @param tag where the tag goes, tag_size bytes
     */
    void finish(writable_tag_view tag) { state_.finish(tag.data()); }

  private:
    session state_;
  };

  /**
   * @brief Decryption in progress, data phase
   *
   * One thing here differs from the single call interface and matters. That
   * interface erases its output buffer when the tag does not match, so a caller
   * who ignores the error is left with zeroes. This cannot do the same: the
   * plaintext has been handed out across however many buffers the caller chose,
   * and none of them can be reached from here.
   *
   * So on failure the caller has to discard everything it received. Until the
   * tag has been checked, none of it is authentic, and acting on any of it is
   * exactly the mistake authenticated encryption exists to prevent. Where that
   * obligation is hard to honour, use the single call interface instead.
   *
   * Each write checks the two ranges it receives. It cannot see a future
   * input, so the caller must also make sure an output from one write does not
   * overwrite input that will be supplied to another.
   *
   * Created through gcm::decryptor. Must not outlive the gcm it came from.
   */
  class decrypt_data {
  public:
    explicit decrypt_data(session &&state) : state_(std::move(state)) {}

    /**
     * @brief Decrypts one run of ciphertext
     *
     * What comes out is not authentic yet. It becomes authentic only once
     * finish reports success.
     *
     * @param input ciphertext to decrypt
     * @param output where the plaintext goes, at least as long as input; it may
     * begin at the same address for in-place operation, but otherwise must be
     * disjoint
     * @exception std::invalid_argument if output is shorter than input, or if
     * input and output partially overlap
     */
    decrypt_data &write(ctl::bytes input, ctl::writable_bytes output) {
      ctl::detail::require_capacity(
          "ctl::symmetric::mode::gcm::decrypt_data::write", "output",
          output.size(), input.size());
      ctl::detail::require_exact_or_disjoint(
          "ctl::symmetric::mode::gcm::decrypt_data::write", input.data(),
          input.size(), output.data(), output.data(), input.size());
      state_.decrypt(input.data(), input.size(), output.data());
      return *this;
    }

    /**
     * @brief Verifies the authentication tag
     *
     * @param tag the tag to verify against, tag_size bytes
     * @return success only if the data is authentic; on failure the caller must
     * discard every byte of plaintext it received
     */
    [[nodiscard]] ext::void_result<error_status> finish(tag_view tag) {
      return verify(state_, tag);
    }

  private:
    session state_;
  };

  /**
   * @brief Decryption in progress, data phase, writing into one buffer
   *
   * What decrypt_data says about failure applies here unchanged: until the tag
   * has been checked none of the plaintext is authentic, and on failure it all
   * has to be discarded. Knowing where it went does not change that, because
   * the buffer belongs to the caller and may already have been read from.
   *
   * Created through gcm::decryptor, then data with a buffer. Must not outlive
   * the gcm it came from.
   */
  class decrypt_data_into {
  public:
    decrypt_data_into(session &&state, ctl::writable_bytes into)
        : state_(std::move(state)), into_(into), written_(0) {}

    /**
     * @brief Decrypts one run of ciphertext into the next part of the buffer
     *
     * @param input ciphertext to decrypt
     * @exception std::invalid_argument if what is left of the buffer is
     * shorter than the run, or if input overlaps the held output anywhere
     * other than the position where this run is written
     */
    decrypt_data_into &write(ctl::bytes input) {
      ctl::detail::require_capacity(
          "ctl::symmetric::mode::gcm::decrypt_data_into::write", "output",
          into_.size() - written_, input.size());
      uint8_t *const destination = into_.data() + written_;
      ctl::detail::require_exact_or_disjoint(
          "ctl::symmetric::mode::gcm::decrypt_data_into::write", input.data(),
          input.size(), destination, into_.data(), into_.size());
      state_.decrypt(input.data(), input.size(), destination);
      written_ += input.size();
      return *this;
    }

    /**
     * @brief How much of the buffer has been written
     */
    size_t written() const { return written_; }

    /**
     * @brief Verifies the authentication tag
     *
     * The tag may follow the data in the same allocation but must not overlap
     * bytes already written.
     *
     * @return success only if the data is authentic; on failure the caller must
     * discard every byte of plaintext it received
     * @exception std::invalid_argument if the tag overlaps data already written
     */
    [[nodiscard]] ext::void_result<error_status> finish(tag_view tag) {
      state_.require_active(
          "ctl::symmetric::mode::gcm::decrypt_data_into::finish");
      ctl::detail::require_disjoint(
          "ctl::symmetric::mode::gcm::decrypt_data_into::finish", "output",
          into_.data(), written_, "tag", tag.data(), tag_size);
      return verify(state_, tag);
    }

  private:
    session state_;
    ctl::writable_bytes into_;
    size_t written_;
  };

  /**
   * @brief Decryption in progress, additional authenticated data phase
   *
   * Created through gcm::decryptor. Must not outlive the gcm it came from.
   */
  class decrypt_aad {
  public:
    decrypt_aad(const cipher_type &cipher, const ctl::detail::ghash &prepared,
                ctl::bytes iv)
        : state_(cipher, prepared, iv) {}

    /**
     * @brief Authenticates one run of additional data
     */
    decrypt_aad &aad(ctl::bytes data) {
      state_.absorb_aad(data.data(), data.size());
      return *this;
    }

    /**
     * @brief Moves on to the data phase, with each run written where the
     * caller says
     */
    decrypt_data data() {
      state_.require_active("ctl::symmetric::mode::gcm::decrypt_aad::data");
      return decrypt_data(std::move(state_));
    }

    /**
     * @brief Moves on to the data phase, writing into one buffer
     *
     * @param output where all of the plaintext goes, in order
     */
    decrypt_data_into data(ctl::writable_bytes output) {
      state_.require_active("ctl::symmetric::mode::gcm::decrypt_aad::data");
      return decrypt_data_into(std::move(state_), output);
    }

    /**
     * @brief Verifies the tag with no data at all, which is GMAC
     */
    [[nodiscard]] ext::void_result<error_status> finish(tag_view tag) {
      return verify(state_, tag);
    }

  private:
    session state_;
  };

  /**
   * @brief Begins an encryption that is fed over several calls
   *
   * Use this when the data does not all exist at once. When it does, the single
   * call interface is simpler and can erase all plaintext if verification
   * fails.
   *
   * @param iv initialization vector, any non zero length; 12 bytes recommended;
   * must not have been used for another encryption under this key
   * @exception std::invalid_argument if iv is empty
   */
  encrypt_aad encryptor(ctl::bytes iv) const & {
    if (iv.empty())
      throw std::invalid_argument("ctl::symmetric::mode::gcm : "
                                  "the initialization vector is empty.");
    return encrypt_aad(cipher_, hash_, iv);
  }

  /**
   * @brief Not available on a temporary
   *
   * What comes back holds the cipher and the prepared hash of the gcm it came
   * from, and it is meant to be fed over a stretch of the program rather than
   * used up in one expression. Made from a temporary it would be left pointing
   * at a destroyed object, so the case is refused instead of documented. Give
   * the gcm a name.
   */
  encrypt_aad encryptor(ctl::bytes iv) const && = delete;

  /**
   * @brief Begins a decryption that is fed over several calls
   *
   * Read what decrypt_data says about failure before using this.
   *
   * @param iv initialization vector, the same one used to encrypt
   * @exception std::invalid_argument if iv is empty
   */
  decrypt_aad decryptor(ctl::bytes iv) const & {
    if (iv.empty())
      throw std::invalid_argument("ctl::symmetric::mode::gcm : "
                                  "the initialization vector is empty.");
    return decrypt_aad(cipher_, hash_, iv);
  }

  /**
   * @brief Not available on a temporary, for the reason encryptor gives
   */
  decrypt_aad decryptor(ctl::bytes iv) const && = delete;

private:
  /**
   * @brief Checks every input piece before a single call writes anything
   */
  static void require_piece_layout(const char *where, pieces input,
                                   ctl::writable_bytes output,
                                   size_t output_size) {
    size_t offset = 0;
    for (const piece &p : input) {
      if (!p.empty())
        ctl::detail::require_exact_or_disjoint(
            where, p.data(), p.size(), output.data() + offset, output.data(),
            output_size);
      offset += p.size();
    }
  }

  /**
   * @brief Completes a session and compares the tag in constant time
   */
  static ext::void_result<error_status> verify(session &state, tag_view tag) {
    uint8_t computed[tag_size];
    state.finish(computed);
    const bool authentic =
        ctl::detail::equal_constant_time(computed, tag.data(), tag_size);
    ctl::detail::secure_zero(computed, sizeof(computed));
    if (!authentic)
      return ext::err(authentication_failed);
    return ext::ok<void>();
  }

  /**
   * @brief Adds up the lengths of a list of pieces
   */
  static uint64_t total(pieces list) {
    uint64_t sum = 0;
    for (const piece &p : list)
      sum += static_cast<uint64_t>(p.size());
    return sum;
  }

  cipher_type cipher_;

  /**
   * @brief GHASH with the subkey already set, copied into each invocation
   */
  ctl::detail::ghash hash_;
};

