/**
 * @file ecb
 * @author jung-kwang lee (ntoskrnl7@gmail.com)
 * @brief ECB (Electronic Codebook) mode of operation (NIST SP 800-38A)
 *
 * Each block is processed independently, so the same plaintext block always
 * maps to the same ciphertext block. Any repetition in the plaintext is
 * therefore visible in the ciphertext, which is why this mode must not be used
 * to encrypt data in general. It is provided for conformance testing and as a
 * building block for other modes.
 *
 * @version 0.1
 *
 * @copyright Copyright (c) 2022 C++ Cryptographics template library Authors
 *
 */
#pragma once

#include <cstddef>
#include <cstdint>

#include <ext/result>

#include <ctl/bytes>

namespace ctl {
namespace symmetric {
namespace mode {

/**
 * @brief ECB mode of operation
 *
 * @tparam _Cipher a block cipher, such as ctl::symmetric::cipher::aes
 */
template <class _Cipher> class ecb {
public:
  /**
   * @brief The block cipher type
   */
  typedef _Cipher cipher_type;

  /**
   * @brief Block size in bytes
   */
  static constexpr size_t block_size = cipher_type::block_size;

  /**
   * @brief Key size in bytes
   */
  static constexpr size_t key_size = cipher_type::key_size;

  /**
   * @brief A key handed over for reading
   */
  typedef ctl::fixed_bytes<key_size> key_view;

  enum error_status {
    /**
     * @brief The input length is not a multiple of the block size
     */
    invalid_input_length,
  };

  /**
   * @brief Initializes with a key
   *
   * @param key the key, key_size bytes
   * @exception std::invalid_argument if the key is not key_size bytes
   */
  explicit ecb(key_view key) : cipher_(key) {}

  /**
   * @brief Encrypts
   *
   * @param input the data to encrypt, whose length must be a multiple of
   * block_size
   * @param output where the ciphertext goes, at least as long as input and may
   * be the same buffer
   * @exception std::invalid_argument if output is shorter than input
   */
  ext::void_result<error_status> encrypt(ctl::bytes input,
                                        ctl::writable_bytes output) const {
    if (input.size() % block_size != 0)
      return ext::err(invalid_input_length);
    ctl::detail::require_capacity("ctl::symmetric::mode::ecb::encrypt",
                                  output.size(), input.size());
    // The blocks are mutually independent, so all of them are handed over at
    // once. Where a hardware path exists, this is where several blocks end up
    // being interleaved.
    cipher_.encrypt_blocks(input.data(), output.data(),
                           input.size() / block_size);
    return ext::ok<void>();
  }

  /**
   * @brief Decrypts
   *
   * @param input the data to decrypt, whose length must be a multiple of
   * block_size
   * @param output where the plaintext goes, at least as long as input and may
   * be the same buffer
   * @exception std::invalid_argument if output is shorter than input
   */
  ext::void_result<error_status> decrypt(ctl::bytes input,
                                        ctl::writable_bytes output) const {
    if (input.size() % block_size != 0)
      return ext::err(invalid_input_length);
    ctl::detail::require_capacity("ctl::symmetric::mode::ecb::decrypt",
                                  output.size(), input.size());
    cipher_.decrypt_blocks(input.data(), output.data(),
                           input.size() / block_size);
    return ext::ok<void>();
  }

private:
  cipher_type cipher_;
};

} // namespace mode
} // namespace symmetric
} // namespace ctl
