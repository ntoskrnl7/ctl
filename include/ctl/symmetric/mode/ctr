/**
 * @file ctr
 * @author jung-kwang lee (ntoskrnl7@gmail.com)
 * @brief CTR (Counter) mode of operation (NIST SP 800-38A)
 *
 * Counter blocks are encrypted to produce a key stream which is exclusive ored
 * with the plaintext. The mode behaves like a stream cipher, so there is no
 * constraint on the input length and no padding is needed, and encryption and
 * decryption are exactly the same operation.
 *
 * A byte offset is accepted so that data can be accessed at an arbitrary
 * position. Given an offset, the corresponding counter value and the position
 * within the key stream block are computed, so processing can start in the
 * middle without touching what comes before.
 *
 * Note that using the same counter block twice under the same key repeats the
 * key stream, which exposes the exclusive or of the two plaintexts directly.
 * Managing the nonce is what the security of this mode rests on.
 *
 * @version 0.1
 *
 * @copyright Copyright (c) 2022 C++ Cryptographics template library Authors
 *
 */
#pragma once

#include <cstddef>
#include <cstdint>
#include <cstring>

#include <ctl/bytes>
#include <ctl/detail/memory>

namespace ctl {
namespace symmetric {
namespace mode {

/**
 * @brief CTR mode of operation
 *
 * @tparam _Cipher a block cipher, such as ctl::symmetric::cipher::aes
 */
template <class _Cipher> class ctr {
public:
  /**
   * @brief The block cipher type
   */
  typedef _Cipher cipher_type;

  /**
   * @brief Block size in bytes
   */
  static constexpr size_t block_size = cipher_type::block_size;

  /**
   * @brief Key size in bytes
   */
  static constexpr size_t key_size = cipher_type::key_size;

  /**
   * @brief Initial counter block size in bytes
   */
  static constexpr size_t nonce_size = block_size;

  /**
   * @brief Initial counter block type, for declaring storage for one
   */
  typedef uint8_t nonce_t[nonce_size];

  /**
   * @brief A key handed over for reading
   */
  typedef ctl::fixed_bytes<key_size> key_view;

  /**
   * @brief An initial counter block handed over for reading
   */
  typedef ctl::fixed_bytes<nonce_size> nonce_view;

  /**
   * @brief Byte offset type
   */
  typedef uint64_t offset_t;

  /**
   * @brief Number of blocks processed in one batch
   */
  static constexpr size_t batch_blocks = cipher_type::preferred_batch;

  /**
   * @brief Initializes with a key
   *
   * @param key the key, key_size bytes
   * @exception std::invalid_argument if the key is not key_size bytes
   */
  explicit ctr(key_view key) : cipher_(key) {}

  /**
   * @brief Encrypts or decrypts
   *
   * CTR mode performs the same operation in both directions, so there is only
   * one method. Nothing about the data can make this fail, so there is no
   * result to inspect; the only way to call it wrongly is to give an output
   * buffer that cannot hold the result, which throws.
   *
   * @param nonce initial counter block, nonce_size bytes
   * @param byte_offset position in the stream to start at, in bytes
   * @param input the data to process, of any length
   * @param output where the result goes, at least as long as input and may be
   * the same buffer
   * @exception std::invalid_argument if output is shorter than input
   */
  void crypt(nonce_view nonce, offset_t byte_offset, ctl::bytes input,
             ctl::writable_bytes output) const {
    ctl::detail::require_capacity("ctl::symmetric::mode::ctr::crypt",
                                  output.size(), input.size());

    const size_t size = input.size();
    counter_state counter = load_counter(nonce.data());
    increment(counter, byte_offset / block_size);

    // The counter itself lives in registers; this is where it is materialized
    // for the calls that take a single block.
    uint8_t block[block_size];
    uint8_t keystream[block_size];
    size_t i = 0;

    // When the offset is not on a block boundary, only the first block starts
    // partway into the key stream.
    const size_t position = static_cast<size_t>(byte_offset % block_size);
    if (position != 0) {
      store_counter(counter, block);
      cipher_.encrypt_block(block, keystream);
      increment(counter, 1);
      const size_t available = block_size - position;
      const size_t count = available < size ? available : size;
      ctl::detail::xor_bytes(input.data(), keystream + position, output.data(),
                             count);
      i = count;
    }

    // Over the block aligned stretch, several counter blocks are prepared and
    // encrypted at once. Key stream blocks are mutually independent, so they
    // can be interleaved on a hardware path.
    uint8_t counters[batch_blocks * block_size];
    for (; cipher_.prefers_batching() && i + sizeof(counters) <= size;
         i += sizeof(counters)) {
      for (size_t b = 0; b < batch_blocks; ++b) {
        store_counter(counter, counters + b * block_size);
        increment(counter, 1);
      }
      // Combining with the data inside the cipher keeps the key stream in
      // registers. Generating it into a buffer first would mean writing it out
      // and reading it back just to exclusive or it.
      cipher_.encrypt_blocks_then_xor(counters, input.data() + i,
                                      output.data() + i, batch_blocks);
    }

    // Whole blocks left over that do not fill a batch
    for (; i + block_size <= size; i += block_size) {
      store_counter(counter, block);
      cipher_.encrypt_block(block, keystream);
      increment(counter, 1);
      ctl::detail::xor_block<block_size>(input.data() + i, keystream,
                                        output.data() + i);
    }

    // The partial block at the end
    if (i < size) {
      store_counter(counter, block);
      cipher_.encrypt_block(block, keystream);
      ctl::detail::xor_bytes(input.data() + i, keystream, output.data() + i,
                             size - i);
    }

    ctl::detail::secure_zero(counters, sizeof(counters));
    ctl::detail::secure_zero(keystream, sizeof(keystream));
    ctl::detail::secure_zero(block, sizeof(block));
    ctl::detail::secure_zero(&counter, sizeof(counter));
  }

private:
  /**
   * @brief A counter block held as two 64 bit halves rather than as bytes
   *
   * The counter advances once per block and each step depends on the previous
   * one. Propagating the carry a byte at a time through an array puts sixteen
   * dependent load, add and store steps on that path for every block. Holding
   * the two halves as values turns the whole thing into a pair of additions.
   */
  struct counter_state {
    /**
     * @brief The high half, that is the first eight bytes
     */
    uint64_t high;

    /**
     * @brief The low half, that is the last eight bytes
     */
    uint64_t low;
  };

  /**
   * @brief Reads a counter block from a byte string
   */
  static counter_state load_counter(const uint8_t *value) {
    counter_state c;
    c.high = ctl::detail::load_be64(value);
    c.low = ctl::detail::load_be64(value + 8);
    return c;
  }

  /**
   * @brief Writes a counter block out as a byte string
   */
  static void store_counter(const counter_state &c, uint8_t *value) {
    ctl::detail::store_be64(c.high, value);
    ctl::detail::store_be64(c.low, value + 8);
  }

  /**
   * @brief Increments the counter block
   *
   * The whole block is a single big endian integer. Adding to the low half
   * carries into the high half exactly when the sum wraps, which is detected
   * without a branch.
   *
   * @param c counter block, advanced in place
   * @param added value to add
   */
  static void increment(counter_state &c, uint64_t added) {
    c.low += added;
    c.high += (c.low < added) ? 1u : 0u;
  }

  cipher_type cipher_;
};

} // namespace mode
} // namespace symmetric
} // namespace ctl
