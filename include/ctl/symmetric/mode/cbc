/**
 * @file cbc
 * @author jung-kwang lee (ntoskrnl7@gmail.com)
 * @brief CBC (Cipher Block Chaining) mode of operation (NIST SP 800-38A)
 *
 * Each plaintext block is exclusive ored with the preceding ciphertext block
 * before being encrypted, and the first block uses the initialization vector.
 * The IV does not have to be secret, but it must not be reused with the same
 * key and it must not be predictable.
 *
 * This mode requires the input to be a multiple of the block size. Padding is
 * the responsibility of a higher layer, and note that reporting a padding
 * error verbatim on decryption exposes the caller to padding oracle attacks.
 *
 * @version 0.1
 *
 * @copyright Copyright (c) 2022 C++ Cryptographics template library Authors
 *
 */
#pragma once

#include <cstddef>
#include <cstdint>
#include <cstring>

#include <ext/result>

#include <ctl/bytes>
#include <ctl/detail/memory>

namespace ctl {
namespace symmetric {
namespace mode {

/**
 * @brief CBC mode of operation
 *
 * @tparam _Cipher a block cipher, such as ctl::symmetric::cipher::aes
 */
template <class _Cipher> class cbc {
public:
  /**
   * @brief The block cipher type
   */
  typedef _Cipher cipher_type;

  /**
   * @brief Block size in bytes
   */
  static constexpr size_t block_size = cipher_type::block_size;

  /**
   * @brief Key size in bytes
   */
  static constexpr size_t key_size = cipher_type::key_size;

  /**
   * @brief Initialization vector size in bytes
   */
  static constexpr size_t iv_size = block_size;

  /**
   * @brief Initialization vector type, for declaring storage for one
   */
  typedef uint8_t iv_t[iv_size];

  /**
   * @brief A key handed over for reading
   */
  typedef ctl::fixed_bytes<key_size> key_view;

  /**
   * @brief An initialization vector handed over for reading
   */
  typedef ctl::fixed_bytes<iv_size> iv_view;

  enum error_status {
    /**
     * @brief The input length is not a multiple of the block size
     */
    invalid_input_length,
  };

  /**
   * @brief Initializes with a key
   *
   * @param key the key, key_size bytes
   * @exception std::invalid_argument if the key is not key_size bytes
   */
  explicit cbc(key_view key) : cipher_(key) {}

  /**
   * @brief Encrypts
   *
   * @param iv initialization vector, iv_size bytes
   * @param input the data to encrypt, whose length must be a multiple of
   * block_size
   * @param output where the ciphertext goes, at least as long as input and may
   * be the same buffer
   * @exception std::invalid_argument if output is shorter than input
   */
  [[nodiscard]] ext::void_result<error_status>
  encrypt(iv_view iv, ctl::bytes input, ctl::writable_bytes output) const {
    if (input.size() % block_size != 0)
      return ext::err(invalid_input_length);
    ctl::detail::require_capacity("ctl::symmetric::mode::cbc::encrypt",
                                  output.size(), input.size());

    uint8_t chain[block_size];
    memcpy(chain, iv.data(), block_size);

    for (size_t offset = 0; offset < input.size(); offset += block_size) {
      ctl::detail::xor_block<block_size>(input.data() + offset, chain, chain);
      cipher_.encrypt_block(chain, chain);
      memcpy(output.data() + offset, chain, block_size);
    }

    ctl::detail::secure_zero(chain, sizeof(chain));
    return ext::ok<void>();
  }

  /**
   * @brief Decrypts
   *
   * @param iv initialization vector, iv_size bytes
   * @param input the data to decrypt, whose length must be a multiple of
   * block_size
   * @param output where the plaintext goes, at least as long as input and may
   * be the same buffer
   * @exception std::invalid_argument if output is shorter than input
   */
  [[nodiscard]] ext::void_result<error_status>
  decrypt(iv_view iv, ctl::bytes input, ctl::writable_bytes output) const {
    if (input.size() % block_size != 0)
      return ext::err(invalid_input_length);
    ctl::detail::require_capacity("ctl::symmetric::mode::cbc::decrypt",
                                  output.size(), input.size());

    uint8_t chain[block_size];
    memcpy(chain, iv.data(), block_size);

    typedef typename cipher_type::writable_block_view writable_block_view;

    for (size_t offset = 0; offset < input.size(); offset += block_size) {
      // Supporting in place decryption means the input block has to be kept
      // before it is overwritten, since it becomes the chaining value of the
      // next block.
      uint8_t current[block_size];
      memcpy(current, input.data() + offset, block_size);

      cipher_.decrypt_block(current, writable_block_view(output.data() + offset));
      ctl::detail::xor_block<block_size>(output.data() + offset, chain,
                                        output.data() + offset);

      memcpy(chain, current, block_size);
      // current holds a copy of a ciphertext block, so erasing it gains
      // nothing, and a volatile write per block would only cost throughput.
    }

    ctl::detail::secure_zero(chain, sizeof(chain));
    return ext::ok<void>();
  }

private:
  cipher_type cipher_;
};

} // namespace mode
} // namespace symmetric
} // namespace ctl
