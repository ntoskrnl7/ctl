/**
 * @file endian
 * @author jung-kwang lee (ntoskrnl7@gmail.com)
 * @brief Byte order conversion and word load/store
 *
 * Cryptographic specifications state explicitly how byte strings correspond to
 * words, so conversions always go through this header rather than relying on
 * the byte order of the host. AES, ARIA and GCM use a big endian convention,
 * while the tweak of XTS uses a little endian one.
 *
 * @version 0.1
 *
 * @copyright Copyright (c) 2022 C++ Cryptographics template library Authors
 *
 */
#pragma once

#include <cstddef>
#include <cstdint>
#include <cstring>

#include <ctl/detail/config>

namespace ctl {
namespace detail {

/**
 * @brief Rotates a 32 bit word left
 */
constexpr uint32_t rotl32(uint32_t v, unsigned int n) {
  return n == 0 ? v : ((v << n) | (v >> (32 - n)));
}

/**
 * @brief Rotates a 32 bit word right
 */
constexpr uint32_t rotr32(uint32_t v, unsigned int n) {
  return n == 0 ? v : ((v >> n) | (v << (32 - n)));
}

/**
 * @brief Reads a 32 bit word from a big endian byte string
 */
inline uint32_t load_be32(const uint8_t *p) {
  return (static_cast<uint32_t>(p[0]) << 24) |
         (static_cast<uint32_t>(p[1]) << 16) |
         (static_cast<uint32_t>(p[2]) << 8) | static_cast<uint32_t>(p[3]);
}

/**
 * @brief Writes a 32 bit word as a big endian byte string
 */
inline void store_be32(uint32_t v, uint8_t *p) {
  p[0] = static_cast<uint8_t>(v >> 24);
  p[1] = static_cast<uint8_t>(v >> 16);
  p[2] = static_cast<uint8_t>(v >> 8);
  p[3] = static_cast<uint8_t>(v);
}

/**
 * @brief Reads a 64 bit word from a big endian byte string
 */
inline uint64_t load_be64(const uint8_t *p) {
  return (static_cast<uint64_t>(load_be32(p)) << 32) |
         static_cast<uint64_t>(load_be32(p + 4));
}

/**
 * @brief Writes a 64 bit word as a big endian byte string
 */
inline void store_be64(uint64_t v, uint8_t *p) {
  store_be32(static_cast<uint32_t>(v >> 32), p);
  store_be32(static_cast<uint32_t>(v), p + 4);
}

/**
 * @brief Reads a 32 bit word from a little endian byte string
 */
inline uint32_t load_le32(const uint8_t *p) {
  return static_cast<uint32_t>(p[0]) | (static_cast<uint32_t>(p[1]) << 8) |
         (static_cast<uint32_t>(p[2]) << 16) |
         (static_cast<uint32_t>(p[3]) << 24);
}

/**
 * @brief Writes a 32 bit word as a little endian byte string
 */
inline void store_le32(uint32_t v, uint8_t *p) {
  p[0] = static_cast<uint8_t>(v);
  p[1] = static_cast<uint8_t>(v >> 8);
  p[2] = static_cast<uint8_t>(v >> 16);
  p[3] = static_cast<uint8_t>(v >> 24);
}

/**
 * @brief Reads a 64 bit word from a little endian byte string
 *
 * On a little endian host the memory representation already matches, so the
 * word is read in one go. memcpy imposes no alignment requirement and lowers
 * to a single load instruction. Assembling the word from individual bytes is
 * not always folded back into one load by the compiler, and when it is not,
 * reading a single word costs eight byte operations.
 */
inline uint64_t load_le64(const uint8_t *p) {
#if defined(CTL_LITTLE_ENDIAN)
  uint64_t value;
  memcpy(&value, p, sizeof(value));
  return value;
#else
  return static_cast<uint64_t>(load_le32(p)) |
         (static_cast<uint64_t>(load_le32(p + 4)) << 32);
#endif
}

/**
 * @brief Writes a 64 bit word as a little endian byte string
 */
inline void store_le64(uint64_t v, uint8_t *p) {
#if defined(CTL_LITTLE_ENDIAN)
  memcpy(p, &v, sizeof(v));
#else
  store_le32(static_cast<uint32_t>(v), p);
  store_le32(static_cast<uint32_t>(v >> 32), p + 4);
#endif
}

} // namespace detail
} // namespace ctl
