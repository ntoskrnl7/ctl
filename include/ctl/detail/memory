/**
 * @file memory
 * @author jung-kwang lee (ntoskrnl7@gmail.com)
 * @brief Memory operations for handling secret values
 *
 * Values that are secret, such as keys and authentication tags, have to be
 * erased once they are no longer needed, and comparing them must not take an
 * amount of time that depends on their contents. This header provides an
 * erase that the compiler cannot remove and a constant time comparison.
 *
 * @version 0.1
 *
 * @copyright Copyright (c) 2022 C++ Cryptographics template library Authors
 *
 */
#pragma once

#include <cstddef>
#include <cstdint>
#include <cstring>

namespace ctl {
namespace detail {

/**
 * @brief Overwrites a buffer with zeroes
 *
 * A plain memset can be treated as a write that is never read afterwards and
 * removed during optimization. Going through volatile prevents that.
 *
 * @param buffer buffer to erase
 * @param size size of the buffer in bytes
 */
inline void secure_zero(void *buffer, size_t size) {
  volatile uint8_t *p = static_cast<volatile uint8_t *>(buffer);
  while (size--)
    *p++ = 0;
}

/**
 * @brief Fixed-size scratch storage that is securely erased on every exit
 *
 * Cryptographic intermediates must also be erased when an exception unwinds
 * the stack. This small internal owner makes that property automatic and is
 * deliberately neither copyable nor movable, so a secret cannot acquire an
 * unnoticed second lifetime.
 */
template <size_t _Size> class secret_buffer {
public:
  secret_buffer() { memset(data_, 0, sizeof(data_)); }
  secret_buffer(const secret_buffer &) = delete;
  secret_buffer &operator=(const secret_buffer &) = delete;
  ~secret_buffer() { secure_zero(data_, sizeof(data_)); }

  uint8_t *data() noexcept { return data_; }
  const uint8_t *data() const noexcept { return data_; }
  static constexpr size_t size() noexcept { return _Size; }

  uint8_t &operator[](size_t index) noexcept { return data_[index]; }
  uint8_t operator[](size_t index) const noexcept { return data_[index]; }

private:
  static_assert(_Size != 0, "secret_buffer must own at least one byte");
  uint8_t data_[_Size];
};

/**
 * @brief Compares two buffers in constant time
 *
 * There is no early return on the first difference, so the running time does
 * not reveal the length of the matching prefix. Authentication tags must be
 * verified with this function; a plain memcmp gives an attacker a signal to
 * work with when forging a tag.
 *
 * @param lhs buffer to compare
 * @param rhs buffer to compare
 * @param size number of bytes to compare
 * @return true if the contents are equal
 */
inline bool equal_constant_time(const void *lhs, const void *rhs, size_t size) {
  const volatile uint8_t *a = static_cast<const volatile uint8_t *>(lhs);
  const volatile uint8_t *b = static_cast<const volatile uint8_t *>(rhs);
  uint8_t diff = 0;
  for (size_t i = 0; i < size; ++i)
    diff = static_cast<uint8_t>(diff | (a[i] ^ b[i]));
  return diff == 0;
}

/**
 * @brief Exclusive ors two byte strings into an output buffer
 *
 * This is deliberately left as a byte at a time loop. Rewriting it with
 * explicit 64 bit word operations turned out to be slower: the compiler
 * lowers the simple byte loop to a single 128 bit vector instruction, and
 * spelling out 64 bit operations blocks that and pins the work to two
 * operations instead of one. Choosing the width is better left to the
 * compiler, and it keeps the code portable as well.
 *
 * @param lhs operand
 * @param rhs operand
 * @param output output buffer, may be the same as lhs or rhs
 * @param size number of bytes to process
 */
inline void xor_bytes(const uint8_t *lhs, const uint8_t *rhs, uint8_t *output,
                      size_t size) {
  for (size_t i = 0; i < size; ++i)
    output[i] = static_cast<uint8_t>(lhs[i] ^ rhs[i]);
}

/**
 * @brief Exclusive ors two byte strings of a size known at compile time
 *
 * With a constant trip count the compiler can unroll into vector instructions
 * without any bounds checking. Used by the internal operations of the modes of
 * operation, where the block size is fixed.
 *
 * @tparam _Size number of bytes to process
 * @param lhs operand
 * @param rhs operand
 * @param output output buffer, may be the same as lhs or rhs
 */
template <size_t _Size>
inline void xor_block(const uint8_t *lhs, const uint8_t *rhs,
                      uint8_t *output) {
  for (size_t i = 0; i < _Size; ++i)
    output[i] = static_cast<uint8_t>(lhs[i] ^ rhs[i]);
}

} // namespace detail
} // namespace ctl
