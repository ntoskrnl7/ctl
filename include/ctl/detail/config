/**
 * @file config
 * @author jung-kwang lee (ntoskrnl7@gmail.com)
 * @brief Compiler and architecture detection
 *
 * Defines the macros used to conditionally compile the hardware accelerated
 * paths. Define CTL_NO_HW_ACCEL to leave them out entirely.
 *
 * @version 0.1
 *
 * @copyright Copyright (c) 2022 C++ Cryptographics template library Authors
 *
 */
#pragma once

/**
 * Whether the target is x86, either 32 or 64 bit
 */
#if defined(_M_IX86) || defined(_M_X64) || defined(__i386__) ||                 \
    defined(__x86_64__)
#define CTL_ARCH_X86 1
#endif

/**
 * Whether the target is 64 bit ARM
 */
#if defined(_M_ARM64) || defined(__aarch64__)
#define CTL_ARCH_ARM64 1
#endif

/**
 * Whether the x86 accelerated paths are compiled in
 *
 * AES-NI and PCLMULQDQ, and the vector path of LEA.
 */
#if defined(CTL_ARCH_X86) && !defined(CTL_NO_HW_ACCEL)
#define CTL_HAS_X86_HW_ACCEL 1
#endif

/**
 * Whether the ARM accelerated paths are compiled in
 *
 * The cryptographic instructions of ARMv8, which are optional, so whether they
 * are used is still decided at run time. NEON is separate and is not optional,
 * which is why the vector path of LEA does not appear here.
 */
#if defined(CTL_ARCH_ARM64) && !defined(CTL_NO_HW_ACCEL)
#define CTL_HAS_ARM_HW_ACCEL 1
#endif

/**
 * Attribute that enables an instruction set for a single function
 *
 * GCC and Clang can select target instructions per function without -maes
 * being passed globally. MSVC allows intrinsics unconditionally and needs no
 * attribute.
 */
#if defined(CTL_HAS_X86_HW_ACCEL) &&                                           \
    (defined(__GNUC__) || defined(__clang__)) && !defined(_MSC_VER)
#define CTL_TARGET_AESNI __attribute__((target("aes,ssse3,sse2")))
#define CTL_TARGET_PCLMUL __attribute__((target("pclmul,ssse3,sse2")))
#define CTL_TARGET_SSE2 __attribute__((target("sse2")))
#define CTL_TARGET_AVX2 __attribute__((target("avx2")))
#else
#define CTL_TARGET_AESNI
#define CTL_TARGET_PCLMUL
#define CTL_TARGET_SSE2
#define CTL_TARGET_AVX2
#endif

/**
 * Attribute that enables the ARMv8 cryptographic instructions for one function
 *
 * They are optional, so a binary that is to run anywhere cannot be built with
 * them globally. GCC and Clang can turn them on for a single function, which
 * is what lets the decision be made at run time. MSVC on ARM64 accepts the
 * intrinsics unconditionally.
 */
#if defined(CTL_HAS_ARM_HW_ACCEL) && (defined(__GNUC__) || defined(__clang__))
#define CTL_TARGET_ARM_CRYPTO __attribute__((target("+crypto")))
#else
#define CTL_TARGET_ARM_CRYPTO
#endif

/**
 * Whether the target is little endian
 *
 * On a little endian target the correspondence between byte strings and words
 * matches the memory representation, so a word can be read or written in one
 * go. The macro is left undefined where this cannot be determined, and the
 * byte at a time path is used instead, which is correct for either byte order.
 */
#if defined(_WIN32) || defined(CTL_ARCH_X86) ||                                \
    (defined(__BYTE_ORDER__) && defined(__ORDER_LITTLE_ENDIAN__) &&            \
     __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__)
#define CTL_LITTLE_ENDIAN 1
#endif

/**
 * Forced inlining
 */
#if defined(_MSC_VER)
#define CTL_FORCEINLINE __forceinline
#elif defined(__GNUC__) || defined(__clang__)
#define CTL_FORCEINLINE inline __attribute__((always_inline))
#else
#define CTL_FORCEINLINE inline
#endif

/**
 * Kept out of the caller
 *
 * For the code that builds and throws an exception. A check on a hot path is a
 * comparison, but the message that goes with the failure is string
 * construction, and inlining that into the caller pushes the code that does the
 * work further apart for no gain, since it never runs. Marking the reporting
 * function this way leaves the comparison at the call site and puts the rest
 * somewhere cold.
 */
#if defined(_MSC_VER)
#define CTL_NOINLINE __declspec(noinline)
#elif defined(__GNUC__) || defined(__clang__)
#define CTL_NOINLINE __attribute__((noinline))
#else
#define CTL_NOINLINE
#endif
