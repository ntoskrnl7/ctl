/**
 * @file cpu
 * @author jung-kwang lee (ntoskrnl7@gmail.com)
 * @brief Queries which instruction sets the running CPU supports
 *
 * The hardware accelerated path has to be chosen at run time rather than at
 * compile time, because the same binary has to keep working on a CPU that does
 * not support the acceleration.
 *
 * @version 0.1
 *
 * @copyright Copyright (c) 2022 C++ Cryptographics template library Authors
 *
 */
#pragma once

#include <ctl/detail/config>

#if defined(CTL_ARCH_X86)
#if defined(_MSC_VER)
#include <intrin.h>
#else
#include <cpuid.h>
#endif
#endif

namespace ctl {
namespace detail {
namespace cpu {

/**
 * @brief Queries a bit of ECX from the basic CPUID leaf (1)
 *
 * Returns false when the target is not x86 or the query fails, so the caller
 * always falls back to the software path.
 *
 * @param bit bit position to check
 * @return true if the feature is supported
 */
inline bool feature_bit(unsigned int bit) {
#if defined(CTL_ARCH_X86)
#if defined(_MSC_VER)
  int registers[4] = {0, 0, 0, 0};
  __cpuid(registers, 1);
  return ((static_cast<unsigned int>(registers[2]) >> bit) & 1u) != 0;
#else
  unsigned int eax = 0;
  unsigned int ebx = 0;
  unsigned int ecx = 0;
  unsigned int edx = 0;
  if (!__get_cpuid(1, &eax, &ebx, &ecx, &edx))
    return false;
  return ((ecx >> bit) & 1u) != 0;
#endif
#else
  (void)bit;
  return false;
#endif
}

/**
 * @brief Queries a bit of EDX from the basic CPUID leaf (1)
 *
 * The older instruction sets are reported in EDX rather than ECX, so they need
 * a separate query.
 *
 * @param bit bit position to check
 * @return true if the feature is supported
 */
inline bool legacy_feature_bit(unsigned int bit) {
#if defined(CTL_ARCH_X86)
#if defined(_MSC_VER)
  int registers[4] = {0, 0, 0, 0};
  __cpuid(registers, 1);
  return ((static_cast<unsigned int>(registers[3]) >> bit) & 1u) != 0;
#else
  unsigned int eax = 0;
  unsigned int ebx = 0;
  unsigned int ecx = 0;
  unsigned int edx = 0;
  if (!__get_cpuid(1, &eax, &ebx, &ecx, &edx))
    return false;
  return ((edx >> bit) & 1u) != 0;
#endif
#else
  (void)bit;
  return false;
#endif
}

/**
 * @brief Whether the AES instruction set (AES-NI) is supported
 *
 * The query is performed once and the result is kept.
 */
inline bool has_aes() {
  static const bool supported = feature_bit(25);
  return supported;
}

/**
 * @brief Whether SSE2 is supported
 *
 * Every 64 bit x86 processor has it, so on that target this is always true and
 * the branch it guards folds away. It is still asked rather than assumed,
 * because the same header is compiled for 32 bit x86, where it is not given.
 *
 * What uses it is the vector path of LEA, which needs nothing beyond 32 bit
 * integer addition, shifts and exclusive or across four lanes.
 */
inline bool has_sse2() {
  static const bool supported = legacy_feature_bit(26);
  return supported;
}

/**
 * @brief Whether carry-less multiplication (PCLMULQDQ) is supported
 *
 * Used to accelerate GHASH.
 */
inline bool has_carryless_multiply() {
  static const bool supported = feature_bit(1);
  return supported;
}

/**
 * @brief Whether the byte shuffle of SSSE3 is supported
 *
 * Every processor with carry-less multiplication also has this, but the two are
 * separate feature bits and are checked separately rather than assumed.
 */
inline bool has_byte_shuffle() {
  static const bool supported = feature_bit(9);
  return supported;
}

/**
 * @brief Queries a bit of EBX from the extended CPUID leaf (7, subleaf 0)
 *
 * The instruction sets added after the basic leaf ran out of bits are reported
 * here.
 *
 * @param bit bit position to check
 * @return true if the feature is supported
 */
inline bool extended_feature_bit(unsigned int bit) {
#if defined(CTL_ARCH_X86)
#if defined(_MSC_VER)
  int registers[4] = {0, 0, 0, 0};
  __cpuidex(registers, 7, 0);
  return ((static_cast<unsigned int>(registers[1]) >> bit) & 1u) != 0;
#else
  unsigned int eax = 0;
  unsigned int ebx = 0;
  unsigned int ecx = 0;
  unsigned int edx = 0;
  if (!__get_cpuid_count(7, 0, &eax, &ebx, &ecx, &edx))
    return false;
  return ((ebx >> bit) & 1u) != 0;
#endif
#else
  (void)bit;
  return false;
#endif
}

/**
 * @brief Whether the operating system preserves the wide vector registers
 *
 * A processor reporting AVX is not enough. The upper half of each register is
 * state the operating system has to know to save across a context switch, and
 * one that does not know about it will silently corrupt the value instead. The
 * processor reports what the operating system enabled through XCR0, which is
 * what this reads, and which may only be read once the processor says the
 * instruction that reads it is available.
 */
inline bool os_saves_wide_vectors() {
#if defined(CTL_ARCH_X86)
  // OSXSAVE, which is the operating system saying XGETBV may be executed.
  if (!feature_bit(27))
    return false;

  unsigned long long enabled;
#if defined(_MSC_VER)
  enabled = _xgetbv(0);
#else
  unsigned int low = 0;
  unsigned int high = 0;
  __asm__ __volatile__("xgetbv" : "=a"(low), "=d"(high) : "c"(0));
  enabled = (static_cast<unsigned long long>(high) << 32) | low;
#endif
  // Bit 1 is the lower half of each vector register and bit 2 the upper half.
  // Both have to be saved.
  return (enabled & 0x6ull) == 0x6ull;
#else
  return false;
#endif
}

/**
 * @brief Whether AVX2 is supported and usable
 *
 * Three things have to hold: the processor has AVX, the operating system saves
 * the wide registers, and the processor has the integer instructions of AVX2
 * rather than only the floating point ones of AVX.
 */
inline bool has_avx2() {
  static const bool supported =
      feature_bit(28) && os_saves_wide_vectors() && extended_feature_bit(5);
  return supported;
}

} // namespace cpu
} // namespace detail
} // namespace ctl
